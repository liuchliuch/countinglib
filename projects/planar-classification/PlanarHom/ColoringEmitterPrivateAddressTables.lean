open PositiveBlockProgram
set_option maxRecDepth 100000
set_option maxHeartbeats 3000000

def privateAddressTable : Kind → List (ℕ×ℕ)
  | .wire => [wirePrivateChunk0,wirePrivateChunk1,wirePrivateChunk2,wirePrivateChunk3,wirePrivateChunk4,wirePrivateChunk5,wirePrivateChunk6,wirePrivateChunk7,wirePrivateChunk8,wirePrivateChunk9,wirePrivateChunk10,wirePrivateChunk11,wirePrivateChunk12,wirePrivateChunk13,wirePrivateChunk14,wirePrivateChunk15,wirePrivateChunk16].flatten
  | .cross => [crossPrivateChunk0,crossPrivateChunk1,crossPrivateChunk2,crossPrivateChunk3,crossPrivateChunk4,crossPrivateChunk5,crossPrivateChunk6,crossPrivateChunk7,crossPrivateChunk8,crossPrivateChunk9,crossPrivateChunk10,crossPrivateChunk11,crossPrivateChunk12,crossPrivateChunk13,crossPrivateChunk14,crossPrivateChunk15,crossPrivateChunk16,crossPrivateChunk17,crossPrivateChunk18,crossPrivateChunk19,crossPrivateChunk20,crossPrivateChunk21,crossPrivateChunk22,crossPrivateChunk23,crossPrivateChunk24,crossPrivateChunk25,crossPrivateChunk26,crossPrivateChunk27,crossPrivateChunk28,crossPrivateChunk29,crossPrivateChunk30,crossPrivateChunk31,crossPrivateChunk32,crossPrivateChunk33,crossPrivateChunk34,crossPrivateChunk35,crossPrivateChunk36,crossPrivateChunk37,crossPrivateChunk38,crossPrivateChunk39].flatten
  | .fan => [fanPrivateChunk0,fanPrivateChunk1,fanPrivateChunk2,fanPrivateChunk3,fanPrivateChunk4,fanPrivateChunk5,fanPrivateChunk6,fanPrivateChunk7,fanPrivateChunk8,fanPrivateChunk9,fanPrivateChunk10,fanPrivateChunk11,fanPrivateChunk12,fanPrivateChunk13,fanPrivateChunk14,fanPrivateChunk15,fanPrivateChunk16,fanPrivateChunk17,fanPrivateChunk18,fanPrivateChunk19,fanPrivateChunk20,fanPrivateChunk21,fanPrivateChunk22,fanPrivateChunk23,fanPrivateChunk24,fanPrivateChunk25,fanPrivateChunk26,fanPrivateChunk27,fanPrivateChunk28,fanPrivateChunk29,fanPrivateChunk30,fanPrivateChunk31,fanPrivateChunk32].flatten
  | .test => [testPrivateChunk0,testPrivateChunk1,testPrivateChunk2,testPrivateChunk3].flatten

theorem privateAddressTable_eq (k : Kind) : privateAddressTable k=(privateVertices k).zipIdx := by
  cases k <;> decide +kernel

theorem privateAddressTable_valid (k : Kind) : ∀p∈privateAddressTable k,address k p.1=(2,p.2,0) := by
