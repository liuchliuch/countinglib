import Holant.Proofs.Algorithms.FamilyFieldInclusion
import Mathlib.LinearAlgebra.Complex.Module
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-! A named finite common field generated by the original finite coefficient
family and its conjugates. Only this derived common field is star-closed; the
original coefficient field is merely included and retains its own codec. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.EOBinaryPlaneCommonField
open Holant.Algebraic Holant.Complexity
namespace F
export Holant.LocalDrafts.MainChain.FamilyFieldInclusion
  (combined field_le embedding embedding_value embedComputes recoverComputes recover_embed)
end F
set_option backward.isDefEq.respectTransparency false

variable {A : Type} [Finite A] (c : A→ℂ)

def extra (a : A) : ℂ := star (c a)
def values : A⊕A→ℂ := F.combined c (extra c)
abbrev original := familyField c
abbrev common := familyField (values c)

omit [Finite A] in
theorem star_mem (x : ℂ) (hx : x∈common c) : star x∈common c := by
  induction hx using IntermediateField.adjoin_induction with
  | mem x hx=>
      obtain ⟨a,rfl⟩ := hx
      cases a with
      | inl a=>exact coefficient_mem_familyField (values c) (.inr a)
      | inr a=>
          change star (star (c a))∈common c
          rw [star_star]
          exact coefficient_mem_familyField (values c) (.inl a)
  | algebraMap x=>simp
  | add x y hx hy ihx ihy=>simpa only [star_add] using (common c).add_mem ihx ihy
  | inv x hx ih=>simpa only [star_inv₀] using (common c).inv_mem ih
  | mul x y hx hy ihx ihy=>simpa only [star_mul] using (common c).mul_mem ihy ihx

instance : Star (common c) := ⟨fun x=>⟨star (x : ℂ),star_mem c x x.property⟩⟩

@[simp] theorem star_value (x : common c) : ((star x : common c) : ℂ)=star (x : ℂ) := rfl

instance : StarRing (common c) where
  star_involutive x:=Subtype.ext (star_star (x : ℂ))
  star_mul x y:=Subtype.ext (star_mul (x : ℂ) (y : ℂ))
  star_add x y:=Subtype.ext (star_add (x : ℂ) (y : ℂ))

omit [Finite A] in
theorem extra_algebraic (hc : ∀a,IsAlgebraic ℚ (c a)) (a : A) :
    IsAlgebraic ℚ (extra c a) := by
  have h := (hc a).isIntegral.map Complex.conjAe.toAlgHom
  exact h.isAlgebraic

theorem values_algebraic (hc : ∀a,IsAlgebraic ℚ (c a)) :
    ∀a,IsAlgebraic ℚ (values c a) :=
  Holant.LocalDrafts.MainChain.FamilyFieldInclusion.combined_algebraic c (extra c) hc
    (extra_algebraic c hc)

abbrev originalPresentation (hc : ∀a,IsAlgebraic ℚ (c a)) := familyPresentation c hc
abbrev commonPresentation (hc : ∀a,IsAlgebraic ℚ (c a)) :=
  familyPresentation (values c) (values_algebraic c hc)

def into : original c→ₐ[ℚ]common c := F.embedding c (extra c)

@[simp] theorem into_value (x : original c) : ((into c x : common c) : ℂ)=x :=
  F.embedding_value c (extra c) x

def embedComputes (hc : ∀a,IsAlgebraic ℚ (c a)) :=
  F.embedComputes c (extra c) hc (extra_algebraic c hc)

def retractComputes (hc : ∀a,IsAlgebraic ℚ (c a)) :=
  F.recoverComputes c (extra c) hc (extra_algebraic c hc)

/-- Both answer codecs are connected by actual fixed rational-matrix machines. -/
theorem retract_into (x : original c) : (into c).toLinearMap.leftInverse (into c x)=x :=
  F.recover_embed c (extra c) x

def conjugation : common c→ₗ[ℚ]common c where
  toFun := star
  map_add' := star_add
  map_smul' r x := by simp

def conjugationComputes (hc : ∀a,IsAlgebraic ℚ (c a)) :
    Holant.Complexity.BinaryCompose.Computes (commonPresentation c hc).encoding
      (commonPresentation c hc).encoding (star : common c→common c) :=
  Holant.LocalDrafts.MainChain.FieldCodec.computes (commonPresentation c hc)
    (commonPresentation c hc) (conjugation c)

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.EOBinaryPlaneCommonField
