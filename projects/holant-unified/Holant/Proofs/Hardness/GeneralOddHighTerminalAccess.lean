import Holant.Proofs.Hardness.GeneralOddHighTerminalGcd
import Holant.Complexity.BinaryInterpolation.Chains.Template
import Holant.Complexity.FixedGadgetSubstitution.OriginalFamily
import Holant.Proofs.Algorithms.OriginalFamily
import Holant.Proofs.Algorithms.ControlledReduction

/-! Physical installation of the internally produced smaller odd graph.
Every oracle query has the ORIGINAL finite G labels and ordinary Eq edges.
The source and target use the coefficient field generated by G and Eq only;
K is absent from the answer field.  Actual template replacement, byte query
computation, and identity answer decoding are proved, rather than supplied.
-/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralOddHighTerminalAccess
open Computability Holant Holant.Tractable Holant.Algebraic Holant.Complexity
open BinaryCompose FixedGadgetSubstitution ExactSignatureTables
open GeneralOddUnaryOrdinary GeneralOddUnarySource
open Holant.LocalDrafts.Hardness.GeneralExtraction.NamedContraction
namespace O
export Holant.LocalDrafts.MainChain.OriginalFamily
  (coefficient coefficient_algebraic presentation tables value value_exact)
end O
namespace Ambient
export Holant.Complexity.FixedGadgetSubstitution.OriginalFamily
  (ambientMacro ambientSource ambientSource_family source_value_exact)
end Ambient
set_option backward.isDefEq.respectTransparency false

variable {s : ℕ} {a : ℕ → ℕ}
variable (G : (i : Fin s) → Signature AlgebraicComplex (a i.val))
/-- Installation data for an actual original ordinary graph.  The source
theorems below construct it; it is never a supplied hardness witness. -/
structure Actual (n : ℕ) where
  graph : Network AlgebraicComplex n
  uses : Uses graph (original G)
  ordinary : Ordinary graph

variable {n : ℕ} (D : Actual G n)
abbrev graph := D.graph
abbrev edges : Fin 1 → Kernel AlgebraicComplex := fun _ => Signature.equality
abbrev field := familyField (O.coefficient G edges)
abbrev presentation := O.presentation G edges
abbrev targetEncoding := RawClosedNetwork.validatedEncoding s 1 a
abbrev targetValue := O.value G edges

/-- Each literal vertex is relabelled by its actual original-family membership.
Only equal rows can be selected; the graph and local port order are fixed. -/
def labels : Labelling (graph G D).shape s 1 a where
  vertex v := Classical.choose (D.uses v)
  vertex_arity v := congrArg Sigma.fst
    (Classical.choose_spec (D.uses v))
  edge _ := 0

abbrev template := (labels G D).template
abbrev valid := (labels G D).wellFormed

theorem template_denote :
    ((template G D).network (valid G D)
      G edges).denote=(graph G D).denote := by
  apply Labelling.denote_template_of_labels (labels G D)
    G edges (graph G D).vertex (graph G D).edge
  · intro v x
    exact Holant.Complexity.BinaryInterpolation.Chains.signature_cast_apply _ _
      (Classical.choose_spec (D.uses v)) _ x
  · intro e b c
    exact (congrFun (congrFun (D.ordinary e) b) c).symm

/-- Every coefficient of the produced graph lives in the field generated by
the original G and Eq.  Diagnostic K coordinates never enlarge that field. -/
def coefficient (x : Fin n → Bool) : field G :=
  ((template G D).network (valid G D)
    (fun i y => (presentation G).decode ((O.tables G edges).vertex i y))
    (fun i b c => (presentation G).decode ((O.tables G edges).edge i b c))).denote x

theorem coefficient_exact (x : Fin n → Bool) :
    (coefficient G D x : AlgebraicComplex)=(graph G D).denote x := by
  have he := Holant.Complexity.FixedGadgetSubstitution.OriginalFamily.macro_value_exact
    (O.coefficient G edges) (O.coefficient_algebraic G edges)
    (template G D) (valid G D) x
  exact he.trans (congrFun (template_denote G D) x)

abbrev templates := Adjoin.templates s a (template G D)
abbrev installedArity := sourceArity (templates G D)
abbrev sourceEncoding := RawClosedNetwork.validatedEncoding (s+1) 1
  (installedArity G D)
abbrev allValid := Adjoin.wellFormed (template G D)
  (valid G D)
abbrev coordinates := Adjoin.coordinates (presentation G) (O.tables G edges)
  (template G D) (valid G D)
abbrev installedTables := sourceTables (templates G D)
  (O.tables G edges) (coordinates G D)
abbrev sourceValue := (installedTables G D).evaluate (presentation G)
abbrev installedSignature := Ambient.ambientSource (O.coefficient G edges)
  (template G D) (valid G D)

/-- Identity templates retain the literal old label, even when two different
old labels happen to carry the same signature. -/
theorem old_template (i : Fin s) :
    templates G D i.val=identityTemplate a i.val := by
  simp [templates,Adjoin.templates,i.isLt]

theorem old_coordinates (i : Fin s) :
    HEq (coordinates G D
      ⟨i.val,Nat.lt_trans i.isLt (Nat.lt_succ_self s)⟩) ((O.tables G edges).vertex i) :=
  Adjoin.old_coordinates (presentation G) (O.tables G edges)
    (template G D) (valid G D) i

theorem installed_family :
    Set.range (fun i : Fin (s+1) =>
      (⟨installedArity G D i.val,
        installedSignature G D i⟩ : AnySignature AlgebraicComplex))=
      original G ∪ {⟨n,(graph G D).denote⟩} := by
  rw [Ambient.ambientSource_family]
  have he := template_denote G D
  change original G ∪ {⟨n,((template G D).network
    (valid G D) G edges).denote⟩}=_
  rw [he]

/-- The actual installation retains every original row, so failure of the
seven alternatives persists on this exact enlarged ordinary family. -/
theorem installed_nontractable (hnot : ¬Tract (original G)) :
    ¬Tract (Set.range (fun i : Fin (s+1) =>
      (⟨installedArity G D i.val,
        installedSignature G D i⟩ : AnySignature AlgebraicComplex))) := by
  intro h
  apply hnot
  apply h.mono_family
  rw [installed_family]
  exact Set.subset_union_left

theorem source_value_ambient
    (r : Input (s+1) 1 (installedArity G D)) :
    (sourceValue G D r : AlgebraicComplex)=
      (r.val.realize r.property (installedSignature G D) edges).denote Fin.elim0 :=
  Ambient.source_value_exact (O.coefficient G edges) (O.coefficient_algebraic G edges)
    (template G D) (valid G D) r

def query := Compiler.value (s+1) 1 (installedArity G D)
  (templates G D) s a
  (compilerHypotheses _ (allValid G D))
def queryComputes := Compiler.computes (s+1) 1 (installedArity G D)
  (templates G D) s a
  (compilerHypotheses _ (allValid G D))

/-- Every macro is expanded without a scalar correction, on every valid source
graph including loops, parallel edges, empty graphs and old nullary rows. -/
theorem query_value (r : Input (s+1) 1 (installedArity G D)) :
    targetValue G (query G D r)=sourceValue G D r := by
  apply Subtype.ext
  rw [O.value_exact,source_value_ambient]
  have h := replacement_scale_power (templates G D)
    r.val r.property (allValid G D)
    (installedSignature G D) G edges 0 (1:AlgebraicComplex)
    (fun i => by simp only [ite_self,one_smul]; rfl)
  simpa only [query,Compiler.value,one_pow,one_mul] using h

abbrev Reduction := LengthControlledOracleReduction
    (sourceEncoding G D) (presentation G).encoding
    (targetEncoding (s:=s) (a:=a)) (presentation G).encoding
    (sourceValue G D) (targetValue G)

def controlled : Reduction G D :=
  Holant.LocalDrafts.MainChain.controlledOneQueryOfEq
    (queryComputes G D) (identityComputes (presentation G).encoding)
    ((O.tables G edges).outputBound (presentation G)) (sourceValue G D)
    (fun r => (query_value G D r).symm)

theorem query_resources (r : Input (s+1) 1 (installedArity G D)) :
    (query G D r).val.vertices.length=
      (r.val.vertices.map fun row =>
        (templates G D row.1).vertices.length).sum ∧
    (query G D r).val.edges.length=r.val.edges.length+
      (r.val.vertices.map fun row =>
        (templates G D row.1).edges.length).sum :=
  ⟨replace_vertex_count _ _,replace_edge_count _ _⟩

omit D in
/-- Exact original-row resource ledger and common-codec access for the proper
gcd reduction.  The smaller graph is produced before its labels are installed. -/
theorem proper_gcd (j : Fin s) (ho : Odd (a j.val)) (hnz : G j≠0)
    (hh : 3≤(result G j ho hnz).arity) (b : Bool)
    (hy : GeneralOddHighTerminalSource.endpoint G j ho hnz (!b)≠0) (k : Fin s)
    (x : Fin (a k.val) → Bool) (hx : sourceKBasis.symm.action (G k) x≠0)
    (q : ℕ) (hq : 0<q)
    (hcharge : Holant.LocalDrafts.BinaryInterpolation.SingularExtraction.balance b x=q)
    (hdiv : ¬(result G j ho hnz).arity∣q) :
    let d := Nat.gcd q (result G j ho hnz).arity
    Odd d ∧ d<(result G j ho hnz).arity ∧
      ∃ r t : ℕ, 0<r ∧ r<(result G j ho hnz).arity ∧ t<q ∧
        r*q=t*(result G j ho hnz).arity+d ∧
        ∃ D : Actual G d, D.graph.denote≠0 ∧ D.graph.shape.vertices=r+t ∧
          d+2*D.graph.shape.edges=r*a k.val+t*a j.val ∧
          D.graph.shape.vertices≤a j.val+a k.val-2 ∧ Nonempty (Reduction G D) := by
  obtain ⟨hd,hdn,r,t,hr,hrn,htq,he,U,hUF,hUE,hUb,hUnz,hUv,hUe,hbound⟩ :=
    GeneralOddHighTerminalGcd.source G j ho hnz hh b hy k x hx q hq hcharge hdiv
  exact ⟨hd,hdn,r,t,hr,hrn,htq,he,⟨U,hUF,hUE⟩,hUnz,hUv,hUe,hbound,
    ⟨controlled G _⟩⟩

omit D in
/-- Original-input high-odd producer with the physical original-field query
attached to the actually produced smaller odd graph. -/
theorem classified (j : Fin s) (ho : Odd (a j.val)) (hnz : G j≠0)
    (hh : 3≤(result G j ho hnz).arity) :
    ∃ b : Bool,GeneralOddHighTerminalSource.endpoint G j ho hnz (!b)≠0 ∧
      ((∃ d : ℕ, Odd d ∧ d<(result G j ho hnz).arity ∧
        ∃ D : Actual G d, D.graph.denote≠0 ∧
          D.graph.shape.vertices≤a j.val+
            (Finset.univ.sup (fun k : Fin s => a k.val))-2 ∧ Nonempty (Reduction G D)) ∨
      GeneralOddHighTerminalGcd.OppositeDivisible G (result G j ho hnz).arity b) := by
  obtain ⟨b,hb,hsmall | hdiv⟩ := GeneralOddHighTerminalGcd.classified G j ho hnz hh
  · obtain ⟨d,hd,hdn,U,hUF,hUE,hUnz,hbound⟩ := hsmall
    exact ⟨b,hb,.inl ⟨d,hd,hdn,⟨U,hUF,hUE⟩,hUnz,hbound,⟨controlled G _⟩⟩⟩
  · exact ⟨b,hb,.inr hdiv⟩

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralOddHighTerminalAccess
