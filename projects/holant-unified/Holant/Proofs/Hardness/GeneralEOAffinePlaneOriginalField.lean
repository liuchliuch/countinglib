import Holant.Proofs.Hardness.GeneralEOAffinePlanePeriod
import Holant.Proofs.Hardness.GeneralEOAffinePlaneChain
import Holant.Proofs.Hardness.GeneralEOSinglePinSource

/-! The phase matrix and its scalar live in the unchanged field generated by
all original coefficients. No fourth-root extension or temporary E field is
used in the original oracle interface. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOAffinePlaneOriginalField
open Holant Holant.Tractable Holant.Algebraic
namespace O
export Holant.LocalDrafts.Hardness.GeneralExtraction.GeneralOriginalTarget
  (originalField originalPresentation originalTables originalValue)
end O
namespace B
export EOBinaryPlaneCore (compress lift word)
end B
namespace C
export GeneralEOAffinePlaneChain (table Mat)
end C
namespace P
export GeneralEOAffinePlanePeriod (table scale power scale_ne_zero)
end P
namespace OT
export Holant.LocalDrafts.BinaryInterpolation.OriginalTables (castSignature castSignature_any)
end OT
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
variable {s : ℕ} {a : ℕ→ℕ}
variable (G : (i : Fin s)→Signature AlgebraicComplex (a i.val))
local instance originalAlgebra : Algebra ℚ (O.originalField G) := (O.originalField G).algebra'
abbrev original := GeneralEOBinaryPinSource.original G
variable (j : Fin s) (M : Signature AlgebraicComplex 4)
variable (hj : (⟨a j.val,G j⟩ : AnySignature AlgebraicComplex)=⟨4,M⟩)

def row : Signature (O.originalField G) 4 :=
  OT.castSignature (congrArg Sigma.fst hj) (original G j)

theorem row_slot : (⟨a j.val,original G j⟩ : AnySignature (O.originalField G))=
    ⟨4,row G j M hj⟩ := (OT.castSignature_any (congrArg Sigma.fst hj) (original G j)).symm

private theorem cast_apply {K : Type} {m n : ℕ} (h : m=n)
    (f : Signature K m) (x : Fin n→Bool) :
    OT.castSignature h f x=f (fun k=>x (Fin.cast h k)) := by subst n; rfl

theorem row_value (x : Fin 4→Bool) : (row G j M hj x : AlgebraicComplex)=M x := by
  rw [row,cast_apply]
  exact Holant.Complexity.BinaryInterpolation.Chains.signature_cast_apply (G j) M hj (congrArg Sigma.fst hj) x

variable (e : Equiv.Perm (Fin 4))
def binary : Signature (O.originalField G) 2 := B.compress (Tensor.reindex e (row G j M hj))
def ambient : Signature AlgebraicComplex 2 := B.compress (Tensor.reindex e M)
def scale : O.originalField G := 4096*(binary G j M hj e ![false,false])^24

theorem binary_value (x : Fin 2→Bool) :
    (binary G j M hj e x : AlgebraicComplex)=ambient M e x := row_value G j M hj _

theorem scale_value : (scale G j M hj e : AlgebraicComplex)=P.scale (ambient M e) := by
  change (O.originalField G).subtype (4096*(binary G j M hj e ![false,false])^24)=_
  simp only [map_mul,map_pow,map_ofNat]
  rw [show (O.originalField G).subtype (binary G j M hj e ![false,false])=ambient M e ![false,false] from binary_value G j M hj e _]
  rfl

variable (hplane : Tensor.reindex e M=B.lift (ambient M e))
include hplane in
theorem original_plane : Tensor.reindex e (row G j M hj)=B.lift (binary G j M hj e) := by
  funext x
  apply Subtype.ext
  change (row G j M hj (fun k=>x (e k)) : AlgebraicComplex)=_
  rw [row_value]
  have h := congrFun hplane x
  change M (fun k=>x (e k))=B.lift (ambient M e) x at h
  rw [h]
  unfold B.lift
  split_ifs
  · exact (binary_value G j M hj e _).symm
  · rfl

variable (hf : EOBinaryPlaneClassification.Full (ambient M e))
variable (hA : Affine (ambient M e)) (hP : ¬Product (ambient M e))
include hf in
theorem scale_nonzero : scale G j M hj e≠0 := by
  intro hz
  have h := scale_value G j M hj e
  rw [hz] at h
  exact P.scale_ne_zero (ambient M e) hf h.symm

theorem mapped_table : (C.table (binary G j M hj e)).map (O.originalField G).subtype=
    P.table (ambient M e) := by
  apply Matrix.ext
  intro i k
  fin_cases i <;> fin_cases k <;> exact binary_value G j M hj e _

include hf hA hP in
theorem power : C.table (binary G j M hj e)^24=
    scale G j M hj e • (1 : C.Mat (K:=O.originalField G)) := by
  have h := P.power (ambient M e) hf hA hP
  have hm : (C.table (binary G j M hj e)^24).map (O.originalField G).subtype=
      (P.table (ambient M e))^24 := by
    calc
      _ = ((C.table (binary G j M hj e)).map (O.originalField G).subtype)^24 :=
        Matrix.map_pow _ (O.originalField G).subtype 24
      _ = _ := congrArg (fun z => z^24) (mapped_table G j M hj e)
  apply Matrix.ext
  intro i k
  apply Subtype.ext
  have hv := congrFun (congrFun hm i) k
  change ((C.table (binary G j M hj e)^24) i k : AlgebraicComplex)=_ at hv
  rw [h] at hv
  rw [hv]
  simp only [Matrix.smul_apply,smul_eq_mul]
  change P.scale (ambient M e)*(1 : Matrix (Fin 2) (Fin 2) AlgebraicComplex) i k=
    ((scale G j M hj e*(1 : C.Mat (K:=O.originalField G)) i k : O.originalField G) : AlgebraicComplex)
  change P.scale (ambient M e)*(1 : Matrix (Fin 2) (Fin 2) AlgebraicComplex) i k=
    (O.originalField G).subtype (scale G j M hj e*(1 : C.Mat (K:=O.originalField G)) i k)
  rw [map_mul]
  rw [show (O.originalField G).subtype (scale G j M hj e)=P.scale (ambient M e) from scale_value G j M hj e]
  congr 1
  simp only [Matrix.one_apply]
  split_ifs <;> rfl

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOAffinePlaneOriginalField
