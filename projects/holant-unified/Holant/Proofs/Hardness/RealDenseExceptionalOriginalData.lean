import Holant.Proofs.Hardness.RealDenseExceptionalStageAccess
import Holant.Proofs.Hardness.RealDenseOriginalData

/-! Exceptional access after any of the three physical port orders, using the
field generated by the original input before either operation. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.RealDenseExceptionalOriginalData
open Holant Holant.Algebraic Holant.Complexity
open Holant.LocalDrafts.Hardness.EightVertexNonexception
namespace O
export Holant.LocalDrafts.Hardness.EightVertexNonexception.Source
  (field fieldSignature presentation TargetInput targetEncoding targetValue)
end O
namespace P
export RealDensePortNormalize (normalized eo)
end P
namespace T
export RealDenseSignTwistStageAccess (Applicable value)
end T
namespace E
export RealDenseExceptionalStageAccess (normalized source)
end E
set_option backward.isDefEq.respectTransparency false
variable (M : Signature ℝ 4) (i : Fin 3)
local instance fieldAlgebra : Algebra ℚ (O.field M) := (O.field M).algebra'

def base : Signature (O.field M) 4 := P.normalized (O.fieldSignature M) i

def scale : O.field M := (entries (base M i)).b+(entries (base M i)).c

theorem field_applicable (he : DenseEOUnitLocal.EOSupport M)
    (h : RealDenseSignTwist.Exceptional (P.normalized M i)) :
    T.Applicable (base M i) 3 (scale M i) where
  even := DenseEOUnitLocal.even _ (P.eo _ (DenseEOPairedSource.field_eo M he) i)
  cap := by
    constructor
    · rfl
    · apply Subtype.ext
      exact (RealDenseSignTwist.exceptional_cap (P.normalized M i) h).2
  nonzero := by
    intro hz
    apply RealDenseSignTwist.exceptional_scale_nonzero (P.normalized M i) h
    exact congrArg (fun x : O.field M=>(x : ℝ)) hz

def source (halg : ∀x,IsAlgebraic ℚ (M x)) (he : DenseEOUnitLocal.EOSupport M)
    (h : RealDenseSignTwist.Exceptional (P.normalized M i)) :
    LengthControlledOracleReduction O.targetEncoding (O.presentation M halg).encoding
      O.targetEncoding (O.presentation M halg).encoding
      (T.value (E.normalized (O.fieldSignature M) i)) (O.targetValue M halg) := by
  have r := E.source (O.presentation M halg) (O.fieldSignature M) i (scale M i) (field_applicable M i he h)
  have ht : T.value (O.fieldSignature M)=O.targetValue M halg :=
    funext (RealDenseOriginalData.target_value M halg)
  rw [ht] at r
  exact r

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.RealDenseExceptionalOriginalData
