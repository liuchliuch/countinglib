import Holant.Proofs.Hardness.BinaryCSPProgrammeRepeat
import Holant.Proofs.Hardness.ThreeModeProgrammeRootBounds

/-! The full cubic multiplicity grid and its original-field monomial roots
are generated by nested finite Boolean tape traversals. Repeated roots stay in
the list, and no equality or distinctness test is used. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.BinaryCSPProgrammeRoots
open Turing Computability Holant.Algebraic Holant.Complexity BinaryCompose FixedFieldMachines GraphPreprocessing
open Holant.OneHot
open BinaryCSPProgrammeCore
namespace W
export Holant.LocalDrafts.Tractability.AffineMachine.WireLists (tabulate flatten succComputes)
end W
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option synthInstance.maxSize 4096
set_option Elab.async false

abbrev Index := ℕ × ℕ × ℕ
abbrev pairUnary := pairEncoding unary unary
abbrev indexEncoding := pairEncoding unary pairUnary
abbrev rowEncoding := pairEncoding unary pairUnary

def indices (n : ℕ) : List Index :=
  (List.range (n+1)).flatMap fun i => (List.range (n+1)).flatMap fun j =>
    (List.range (n+1)).map fun k => (i,j,k)

def rowComputes : Computes rowEncoding (framedListEncoding indexEncoding)
    (fun p => (List.range (p.1+1)).map fun k => (p.2.1,p.2.2,k)) := by
  let context := Wiring.firstComputes rowEncoding unary
  let ij := context.andThen (Wiring.secondComputes unary pairUnary)
  let i := ij.andThen (Wiring.firstComputes unary unary)
  let j := ij.andThen (Wiring.secondComputes unary unary)
  let k := Wiring.secondComputes rowEncoding unary
  exact W.tabulate rowEncoding indexEncoding (fun p => p.1+1)
    ((Wiring.firstComputes unary pairUnary).andThen W.succComputes) _
    (pairComputes i (pairComputes j k))

def planeComputes : Computes pairUnary (framedListEncoding indexEncoding)
    (fun p => (List.range (p.1+1)).flatMap fun j =>
      (List.range (p.1+1)).map fun k => (p.2,j,k)) := by
  let context := Wiring.firstComputes pairUnary unary
  let m := context.andThen (Wiring.firstComputes unary unary)
  let i := context.andThen (Wiring.secondComputes unary unary)
  let j := Wiring.secondComputes pairUnary unary
  let cell := (pairComputes m (pairComputes i j)).andThen rowComputes
  exact congrComputes ((W.tabulate pairUnary (framedListEncoding indexEncoding)
    (fun p => p.1+1) ((Wiring.firstComputes unary unary).andThen W.succComputes) _ cell).andThen
      (W.flatten indexEncoding)) (fun _ => rfl)

def indicesComputes : Computes unary (framedListEncoding indexEncoding) indices :=
  congrComputes ((W.tabulate unary (framedListEncoding indexEncoding)
    (fun n => n+1) W.succComputes _ planeComputes).andThen (W.flatten indexEncoding))
    (fun _ => rfl)

@[simp] theorem indices_length (n : ℕ) : (indices n).length=(n+1)^3 := by
  simp [indices,List.length_flatMap,List.sum_replicate,pow_succ,Nat.mul_comm,Nat.mul_left_comm]

theorem mem_indices {n : ℕ} {p : Index} : p ∈ indices n ↔ p.1≤n ∧ p.2.1≤n ∧ p.2.2≤n := by
  rcases p with ⟨i,j,k⟩
  simp only [indices,List.mem_flatMap,List.mem_range,List.mem_map,Prod.mk.injEq]
  constructor
  · rintro ⟨i',hi',j',hj',k',hk',hi,hj,hk⟩
    subst i'; subst j'; subst k'
    omega
  · rintro ⟨hi,hj,hk⟩
    exact ⟨i,by omega,j,by omega,k,by omega,rfl,rfl,rfl⟩

variable {K : Type} [Field K] [Algebra ℚ K] {d : ℕ}
variable (F : FixedField K d) (a b c : K)

def monomial (p : Index) : K := a^p.1*b^p.2.1*c^p.2.2
def roots (n : ℕ) : List K := (indices n).map (monomial a b c)

def monomialComputes : Computes indexEncoding F.encoding (monomial a b c) := by
  let i := Wiring.firstComputes unary pairUnary
  let jk := Wiring.secondComputes unary pairUnary
  let j := jk.andThen (Wiring.firstComputes unary unary)
  let k := jk.andThen (Wiring.secondComputes unary unary)
  exact (pairComputes
    ((pairComputes (i.andThen (ThreeModeProgrammeRoots.powerComputes F a))
      (j.andThen (ThreeModeProgrammeRoots.powerComputes F b))).andThen (Concrete.fieldMultiplication F))
    (k.andThen (ThreeModeProgrammeRoots.powerComputes F c))).andThen (Concrete.fieldMultiplication F)

def rootsComputes : Computes unary (framedListEncoding F.encoding) (roots a b c) :=
  indicesComputes.andThen (Holant.LocalDrafts.Tractability.AffineMachine.WireLists.mapComputes
    indexEncoding F.encoding (monomial a b c) (monomialComputes F a b c))

@[simp] theorem roots_length (n : ℕ) : (roots a b c n).length=(n+1)^3 := by
  simp [roots]

theorem roots_nonzero {a b c : K} (ha : a≠0) (hb : b≠0) (hc : c≠0) (n : ℕ) :
    ∀ r ∈ roots a b c n,r≠0 := by
  intro r hr
  obtain ⟨p,_,rfl⟩ := List.mem_map.mp hr
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ ha) (pow_ne_zero _ hb)) (pow_ne_zero _ hc)

theorem roots_bound {A : Type} (base : A→K) (unit : A) (hunit : base unit=1)
    (ha : ArithmeticSize.Bound base 1 a) (hb : ArithmeticSize.Bound base 1 b)
    (hc : ArithmeticSize.Bound base 1 c) (n : ℕ) :
    ∀ r ∈ roots a b c n,ArithmeticSize.Bound base (3*n) r := by
  intro r hr
  obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hr
  obtain ⟨hi,hj,hk⟩ := mem_indices.mp hp
  have h := ((ThreeModeProgrammeRootBounds.power_bound base ha p.1).mul
    (ThreeModeProgrammeRootBounds.power_bound base hb p.2.1)).mul
    (ThreeModeProgrammeRootBounds.power_bound base hc p.2.2)
  exact h.mono unit hunit (by omega)

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.BinaryCSPProgrammeRoots
