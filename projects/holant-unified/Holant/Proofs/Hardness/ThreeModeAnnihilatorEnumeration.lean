import Holant.Proofs.Hardness.ThreeModeAnnihilatorDifference

/-! Explicit arithmetic enumeration for a bounded, predicate-free root generator. -/
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.ThreeModeAnnihilator

/-- Enumerate each positive antidiagonal, then each first coordinate on it. -/
def rootIndices (m : ℕ) : List (ℕ × ℕ) :=
  (List.range m).flatMap (fun s =>
    (List.range (s+2)).map (fun i => (i,s+1-i)))

@[simp] theorem mem_rootIndices {m i j : ℕ} :
    (i,j) ∈ rootIndices m ↔ i+j ≤ m ∧ 0 < i+j := by
  simp only [rootIndices, List.mem_flatMap, List.mem_range, List.mem_map]
  constructor
  · rintro ⟨s, hs, k, hk, heq⟩
    cases heq
    omega
  · rintro ⟨hij,hpos⟩
    refine ⟨i+j-1, by omega, i, by omega, ?_⟩
    congr 1
    omega

@[simp] theorem rootIndices_zero : rootIndices 0 = [] := rfl

theorem rootIndices_nodup (m : ℕ) : (rootIndices m).Nodup := by
  apply List.nodup_flatMap.mpr
  constructor
  · intro s hs
    apply List.nodup_range.map
    intro i j heq
    exact congrArg Prod.fst heq
  · apply List.nodup_range.imp
    intro s t hst a hs ht
    rcases List.mem_map.mp hs with ⟨i,hi,rfl⟩
    rcases List.mem_map.mp ht with ⟨j,hj,heq⟩
    have hij : j=i := congrArg Prod.fst heq
    have hsub : t+1-j=s+1-i := congrArg Prod.snd heq
    have hi' := List.mem_range.mp hi
    have hj' := List.mem_range.mp hj
    exact hst (by omega)

@[simp] theorem rootIndices_toFinset (m : ℕ) : (rootIndices m).toFinset = unwanted m := by
  ext a
  rcases a with ⟨i,j⟩
  simp

theorem rootIndices_length (m : ℕ) : (rootIndices m).length = (unwanted m).card :=
  enumerated_length m (rootIndices m) (rootIndices_nodup m) (rootIndices_toFinset m)

theorem rootIndices_length_le (m : ℕ) : (rootIndices m).length ≤ (m+1)^2 := by
  rw [rootIndices_length]
  exact unwanted_card_le m

section Algebra
variable {K : Type*} [Field K]

/-- The explicit index loop supplies exactly the coefficient filter's sample count. -/
theorem rootIndices_length_add_one (m : ℕ) (lam mu nu : K) :
    (rootIndices m).length+1 = queryCount m lam mu nu := by
  rw [rootIndices_length, queryCount_eq_card]

/-- Exact value of the difference filter generated by the arithmetic loops. -/
theorem differenceFilter_rootIndices (m : ℕ) (lam mu nu : K) (c : ℕ × ℕ → K) :
    differenceFilter ((rootIndices m).map (mode m lam mu nu)) (sample m lam mu nu c) 0 =
      c (0,0) * denominator m lam mu nu :=
  differenceFilter_sample m lam mu nu _ (rootIndices_nodup m) (rootIndices_toFinset m) c

end Algebra
end Holant.LocalDrafts.RemoteWork.HardnessChainV1.ThreeModeAnnihilator
