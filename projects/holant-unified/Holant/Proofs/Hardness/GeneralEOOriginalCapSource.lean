import Holant.Proofs.Hardness.GeneralEOOriginalCapInterpolation
import Holant.Proofs.Hardness.GeneralEOBinaryPinSource

/-! A sufficient original-family pin-elimination branch. A finite port matching
of a selected original EO row supplies an actual one-vertex native-X cap.
Its two explicit coefficient sums are nonzero and have unequal norms. All
sample chains expand this cap into original vertices, in the exact original
coefficient field and codec. No binary oracle or local directed pin is given. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOOriginalCapSource
open Holant Holant.Tractable Holant.Algebraic Holant.Complexity
open FixedGadgetSubstitution
open scoped BigOperators
namespace I
export GeneralEOOriginalCapInterpolation
  (cap p q g hg data Input inputEncoding sourceSignatures sourceValue targetTables source)
end I
namespace N
export GeneralEOOriginalCapGraph (graph assignment denote_coefficients)
end N
namespace O
export Holant.LocalDrafts.Hardness.GeneralExtraction.GeneralOriginalTarget
  (coefficients originalField originalPresentation originalTables originalValue)
end O
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
variable {s r : ℕ} {a : ℕ→ℕ}
variable (G : (i : Fin s)→Signature AlgebraicComplex (a i.val))
local instance fieldAlgebra : Algebra ℚ (O.originalField G) := (O.originalField G).algebra'

abbrev original := GeneralEOBinaryPinSource.original G
abbrev presentation := O.originalPresentation G
abbrev targetEncoding := RawClosedNetwork.validatedEncoding s 1 a
variable (j : Fin s) (e : Fin (a j.val) ≃ (Fin 2 ⊕ (Fin r × Bool)))

/-- A finite sum of literal original coefficients. Each matched pair is
weighted by its actual native-X edge; both original boundary ports are ordered. -/
def coefficient (x : Fin 2→Bool) : AlgebraicComplex :=
  ∑z : (Fin r×Bool)→Bool,G j (N.assignment e x z)*
    ∏i : Fin r,Signature.disequality (z (i,false)) (z (i,true))

def Coefficients : Prop := coefficient G j e ![false,true]≠0 ∧
  coefficient G j e ![true,false]≠0 ∧
  ‖coefficient G j e ![false,true]‖≠‖coefficient G j e ![true,false]‖

theorem ambient_cap (x : Fin 2→Bool) : I.cap G j e x=coefficient G j e x :=
  N.denote_coefficients e (G j) x

/-- Every derived cap coefficient is already in the field generated by G.
This is exact field transport through the actual finite network. -/
theorem cap_value (x : Fin 2→Bool) :
    ((I.cap (original G) j e x : O.originalField G) : AlgebraicComplex)=coefficient G j e x := by
  have hm := Network.denote_map (O.originalField G).subtype (N.graph e (original G j)) x
  have hg : (N.graph e (original G j)).map (O.originalField G).subtype=N.graph e (G j) := by
    unfold Network.map N.graph
    congr 1
    funext i u v
    cases u <;> cases v <;> rfl
  rw [hg] at hm
  exact hm.symm.trans (ambient_cap G j e x)

theorem coefficient_mem (x : Fin 2→Bool) : coefficient G j e x∈O.originalField G := by
  rw [←cap_value G j e x]
  exact (I.cap (original G) j e x).property

variable (he : Signature.CentralSupport (G j)) (hc : Coefficients G j e)

include he in
theorem original_eo : Signature.CentralSupport (original G j) := by
  intro x hx
  apply Subtype.ext
  exact he x hx

include hc in
theorem first_nonzero : I.p (original G) j e≠0 := by
  intro hz
  have hv := cap_value G j e ![false,true]
  rw [show I.cap (original G) j e ![false,true]=0 from hz] at hv
  exact hc.1 hv.symm

include hc in
theorem second_nonzero : I.q (original G) j e≠0 := by
  intro hz
  have hv := cap_value G j e ![true,false]
  rw [show I.cap (original G) j e ![true,false]=0 from hz] at hv
  exact hc.2.1 hv.symm

include hc in
theorem unequal : ‖I.p (original G) j e‖≠‖I.q (original G) j e‖ := by
  change ‖((I.cap (original G) j e ![false,true] : O.originalField G) : AlgebraicComplex)‖≠
    ‖((I.cap (original G) j e ![true,false] : O.originalField G) : AlgebraicComplex)‖
  rw [cap_value,cap_value]
  exact hc.2.2

abbrev Input := I.Input (original G) j e (presentation G)
abbrev inputEncoding := I.inputEncoding (original G) j e (presentation G)
abbrev pinValue := I.sourceValue (original G) j e (presentation G)

/-- Every old source label retains its exact original coefficient row. -/
theorem source_old (i : Fin s) :
    (⟨Holant.LocalDrafts.BinaryInterpolation.PhysicalQueries.A (s:=s) a (I.g (original G) j e) i.val,
      I.sourceSignatures (original G) j e ⟨i.val,Nat.lt_trans i.isLt (Nat.lt_succ_self s)⟩⟩ :
        AnySignature (O.originalField G))=⟨a i.val,original G i⟩ :=
  GeneralEOOriginalCapInterpolation.source_old (original G) j e i

/-- The sole added row is literally directed01, with the displayed port order. -/
theorem source_pin :
    (⟨Holant.LocalDrafts.BinaryInterpolation.PhysicalQueries.A (s:=s) a (I.g (original G) j e) s,
      I.sourceSignatures (original G) j e Holant.LocalDrafts.BinaryInterpolation.PhysicalQueries.newLabel⟩ :
        AnySignature (O.originalField G))=
      ⟨2,fun x=>if x 0=false ∧ x 1=true then 1 else 0⟩ :=
  GeneralEOOriginalCapInterpolation.source_pin (original G) j e

theorem original_tables : I.targetTables (original G) (presentation G)=O.originalTables G := rfl

/-- Physical cap-chain interpolation for any number of directed01 occurrences.
The finite program emits only original-G graphs and original-G answer bytes. -/
def source : LengthControlledOracleReduction (inputEncoding G j e) (presentation G).encoding
    (targetEncoding (s:=s) (a:=a)) (presentation G).encoding (pinValue G j e) (O.originalValue G) :=
  I.source (original G) j e (original_eo G j he) (presentation G)
    (first_nonzero G j e hc) (second_nonzero G j e hc)
    (GeneralGeometricCapLocal.infinite_of_unequal_norms _ _
      (second_nonzero G j e hc) (unequal G j e hc))

/-- The search space is finite: a literal original index and a complete ordered
matching of all remaining ports. The equivalence itself certifies even arity. -/
abbrev Choice (s : ℕ) (a : ℕ→ℕ) :=
  (j : Fin s) × (Fin (a j.val) ≃ (Fin 2 ⊕ (Fin (a j.val/2-1) × Bool)))

noncomputable instance choiceFintype : Fintype (Choice s a) := inferInstance

def Applicable : Prop := ∃c : Choice s a,
  Signature.CentralSupport (G c.1) ∧ Coefficients G c.1 c.2

include he hc in
/-- Every actual matching with two boundary ports occurs in the finite search. -/
theorem applicable_of_coefficients : Applicable G := by
  have hn := GeneralEOOriginalCapGraph.arity_eq e
  have hr : r=a j.val/2-1 := by omega
  subst r
  exact ⟨⟨j,e⟩,he,hc⟩

def selected (h : Applicable G) : Choice s a := Classical.choose h

theorem selected_spec (h : Applicable G) :
    Signature.CentralSupport (G (selected G h).1) ∧
      Coefficients G (selected G h).1 (selected G h).2 := Classical.choose_spec h

/-- The only hypothesis is the finite original-coefficient sufficient branch.
It supplies the actual cap internally; all other original rows are unrestricted. -/
def selectedSource (h : Applicable G) := source G (selected G h).1 (selected G h).2
  (selected_spec G h).1 (selected_spec G h).2

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOOriginalCapSource
