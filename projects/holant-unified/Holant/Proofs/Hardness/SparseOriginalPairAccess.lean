end Choice

variable {L : Type} [Field L] [Algebra ℚ L]
variable (M : Signature L 4) (halg : ∀ t,IsAlgebraic ℚ (M t))
abbrev field := Original.field M
abbrev presentation := F M halg
def dictionary (_ : Fin 1) : Signature (field M) 4 := Original.fieldSignature M
private def delta (x y : Bool) : field M := if x=false ∧ y=true then 1 else 0
local instance rationalAlgebra : Algebra ℚ (field M) := (field M).algebra'

abbrev pairArity := PairedPinsRaw.targetArity 1 (fun _=>4)
abbrev pairEncoding := V.targetEncoding 1 1 (fun _=>4)
abbrev PairInput := ExactSignatureTables.Input 2 1 pairArity
abbrev pairSignatures := PP.targetSignatures (s:=1) (a:=fun _=>4) (dictionary M) (PP.pin false) (PP.pin true)
abbrev pairValue := PC.targetValue (s:=1) (a:=fun _=>4) (presentation M halg) (dictionary M)
  (PP.pin false) (PP.pin true) (fun _ : Fin 1=>Signature.disequality)

abbrev interpolationArity := PQ.A (s:=2) baseArity loopTemplate
abbrev interpolationSignatures := OT.binarySlot loopTemplate loopTemplate_wellFormed
  (baseSignatures M halg) (kernels M halg) loopTemplate_boundary rightPin

def label : Fin 2 → Fin 3 := ![0,2]

theorem label_arity (i : Fin 2) : interpolationArity (label i).val=pairArity i.val := by
  fin_cases i
  · change PQ.A (s:=2) baseArity loopTemplate 0=4
    exact (Adjoin.old_boundary loopTemplate (0 : Fin 2)).trans
      (Adjoin.old_boundary chainTemplate (0 : Fin 1))
  · change PQ.A (s:=2) baseArity loopTemplate 2=2
    exact Holant.LocalDrafts.BinaryInterpolation.PhysicalQueries.new_arity baseArity loopTemplate loopTemplate_boundary

/-- The physical existing row parser relabels each row once and copies all ports. -/
def query : PairInput → Input M halg := Relabel.input label label_arity
def queryComputes : Computes pairEncoding inputEncoding (query M halg) :=
  Relabel.computes label label_arity

theorem query_rows (r : PairInput) : (query M halg r).val.vertices=r.val.vertices.map (Relabel.row label) := rfl
theorem query_ports (r : PairInput) :
    (query M halg r).val.vertices.map Prod.snd=r.val.vertices.map Prod.snd := Relabel.ordered_ports label r.val
theorem query_edges (r : PairInput) : (query M halg r).val.edges=r.val.edges := rfl

/-- The old zero slot is exactly the already installed original coefficient
coordinate table; the two-M macro occupies only the unused slot one. -/
theorem base_zero : baseSignatures M halg (0 : Fin 2)=dictionary M (0 : Fin 1) := by
  have hc := Adjoin.old_coordinates (F M halg) (Original.tables M halg)
    chainTemplate chainTemplate_wellFormed (0 : Fin 1)
  have he := eq_of_heq hc
  funext x
  change (F M halg).decode
      (Adjoin.coordinates (F M halg) (Original.tables M halg)
        chainTemplate chainTemplate_wellFormed (0 : Fin 2) x)=_
  calc
    _ = (F M halg).decode ((Original.tables M halg).vertex (0 : Fin 1) x) :=
      congrArg (F M halg).decode (congrFun he x)
    _ = _ := by
      apply Subtype.ext
      exact familyCoordinates_spec (Original.coefficient M)
        (Original.coefficient_algebraic M halg) (.inl ⟨0,x⟩)

private theorem pair_old :
    (⟨pairArity 0,pairSignatures M (0 : Fin 2)⟩ : AnySignature (field M))=
      ⟨4,dictionary M (0 : Fin 1)⟩ := by
  rfl

private theorem pair_new :
    (⟨pairArity 1,pairSignatures M (1 : Fin 2)⟩ : AnySignature (field M))=
      ⟨2,fun x=>delta M (x 0) (x 1)⟩ := by
  apply congrArg (fun f : Signature (field M) 2=>(⟨2,f⟩ : AnySignature (field M)))
  funext x
  exact PairedPinsSemantics.target_pin_signature (s:=1) (a:=fun _=>4) (dictionary M) x

private theorem rightPin_delta :
    Holant.Complexity.BinaryInterpolation.Chains.binarySignature (rightPin : Matrix Bool Bool (field M))=
      fun x=>delta M (x 0) (x 1) := by
  funext x
  cases h0 : x 0 <;> cases h1 : x 1 <;>
    simp [Holant.Complexity.BinaryInterpolation.Chains.binarySignature,
      rightPin,weightedX,delta,h0,h1]

/-- All original input labels have the same literal coefficient table at
their emitted interpolation label, not merely projectively equal values. -/
theorem signature_label (i : Fin 2) :
    (⟨pairArity i.val,pairSignatures M i⟩ : AnySignature (field M))=
      ⟨interpolationArity (label i).val,interpolationSignatures M halg (label i)⟩ := by
  fin_cases i
  · have h := OT.binarySlot_old loopTemplate loopTemplate_wellFormed
      (baseSignatures M halg) (kernels M halg) loopTemplate_boundary
      rightPin (0 : Fin 2)
    have hz : (⟨baseArity 0,baseSignatures M halg (0 : Fin 2)⟩ : AnySignature (field M))=
        ⟨4,dictionary M (0 : Fin 1)⟩ := by
      exact congrArg (fun f : Signature (field M) 4=>(⟨4,f⟩ : AnySignature (field M))) (base_zero M halg)
    exact (pair_old M).trans (h.trans hz).symm
  · have h := OT.binarySlot_new loopTemplate loopTemplate_wellFormed
      (baseSignatures M halg) (kernels M halg) loopTemplate_boundary rightPin
    have hd := congrArg (fun f : Signature (field M) 2=>(⟨2,f⟩ : AnySignature (field M))) (rightPin_delta M)
    exact (pair_new M).trans (h.trans hd).symm

private def read (f : AnySignature (field M)) (bits : List Bool) : field M :=
  f.2 (fun j=>bits.getD j.val false)

theorem table_label (i : Fin 2) (bits : List Bool) :
    Choice.table (pairSignatures M) i.val bits=
      Choice.table (interpolationSignatures M halg) (label i).val bits := by
  have h := congrArg (fun f=>read M f bits) (signature_label M halg i)
  simpa only [Choice.table,dif_pos i.isLt,dif_pos (label i).isLt,read] using h

/-- Exact full network-value preservation for the actual finite relabel programme. -/
theorem query_value (r : PairInput) :
    targetPinValue M halg (query M halg r)=pairValue M halg r := by
  have h := Relabel.value_scaled label (Choice.table (pairSignatures M))
    (Choice.table (interpolationSignatures M halg)) (fun _=> (1 : field M)) label_arity r
    (fun i bits=>by simpa using table_label M halg i bits)
  have hp : Holant.LocalDrafts.Hardness.RootPreprocessing.OccurrenceProduct.value
      (fun _ : Fin 2=>(1 : field M)) r.val=1 := by
    unfold Holant.LocalDrafts.Hardness.RootPreprocessing.OccurrenceProduct.value
    apply List.prod_eq_one
    intro z hz
    obtain ⟨row,hrow,rfl⟩ := List.mem_map.mp hz
    obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hrow
    simp only [Holant.LocalDrafts.Hardness.RootPreprocessing.OccurrenceProduct.total,
      dif_pos (r.property.1 i).1]
  rw [hp,one_mul] at h
  have hv := (Choice.denote_eq_evaluate r.val r.property (pairSignatures M)).trans
    (h.trans (Choice.denote_eq_evaluate (query M halg r).val (query M halg r).property
      (interpolationSignatures M halg)).symm)
  simpa only [targetPinValue,interpolationSignatures,kernels_exact,pairValue,PC.targetValue,
    ExactSignatureTables.evaluate_eq_decoded,PC.targetTables,LinearEquiv.apply_symm_apply,
    pairSignatures] using hv.symm

/-- Finite target tables provide the actual interpolation-oracle answer bound. -/
def interpolationTables : ExactSignatureTables (Module.finrank ℚ (field M)) 3 1 interpolationArity where
  vertex i x := (presentation M halg).decode.symm (interpolationSignatures M halg i x)
  edge _ x y := (presentation M halg).decode.symm (Signature.disequality x y)

def interpolationOutput : PolynomialOutputBound inputEncoding (presentation M halg).encoding
    (targetPinValue M halg) := by
  have h := (interpolationTables M halg).outputBound (presentation M halg)
  have he : (interpolationTables M halg).evaluate (presentation M halg)=targetPinValue M halg := by
    funext r
    rw [ExactSignatureTables.evaluate_eq_decoded]
    simp only [interpolationTables,LinearEquiv.apply_symm_apply,interpolationSignatures,targetPinValue,kernels_exact]
  rw [he] at h
  exact h

def includeControlled : LengthControlledOracleReduction pairEncoding (presentation M halg).encoding
    inputEncoding (presentation M halg).encoding (pairValue M halg) (targetPinValue M halg) :=
  controlledOneQueryOfEq (queryComputes M halg) (identityComputes (presentation M halg).encoding)
    (interpolationOutput M halg) (pairValue M halg) (fun r=>(query_value M halg r).symm)

/-- Original-M oracle access for arbitrarily many actual ordered 01 labels,
produced solely from the literal sparse doubling coefficient conditions. -/
def source (hM : EvenSupport M) (hs : SparseCase M)
    (hv : sparseV (entries M)≠0) (hu : sparseU (entries M)=2*sparseV (entries M)) :
    LengthControlledOracleReduction pairEncoding (presentation M halg).encoding
      Original.targetEncoding (presentation M halg).encoding
      (pairValue M halg) (Original.targetValue M halg) :=
  Holant.LocalDrafts.RemoteWork.PlatonicExits.PhysicalCost.composeControlled
    (includeControlled M halg) (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu)

/- Resource observers keep the two already built operands abstract. -/
attribute [local irreducible] includeControlled PinInterpolationControl.sourceOfCoefficients

variable (hM : EvenSupport M) (hs : SparseCase M)
    (hv : sparseV (entries M)≠0) (hu : sparseU (entries M)=2*sparseV (entries M))

/-- The genuine finite inliner, with the actual interpolation callee. -/
theorem source_machine :
    (source M halg hM hs hv hu).reduction.machine=
      OracleCompose.machine
        (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu).reduction.machine
        (includeControlled M halg).reduction.machine := rfl

theorem source_clock :
    (source M halg hM hs hv hu).reduction.time=
      (includeControlled M halg).compositionTimePolynomial
        (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu).reduction := rfl

theorem source_query_bound :
    (source M halg hM hs hv hu).queryBound=
      (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu).queryBound.comp
        (includeControlled M halg).queryBound := rfl

def outputs (oracle : List Bool → List Bool)
    (ho : RepresentsOracle Original.targetEncoding (presentation M halg).encoding
      (Original.targetValue M halg) oracle) (r : PairInput) :
    (source M halg hM hs hv hu).reduction.machine.OutputsInTime oracle (pairEncoding.encode r)
      ((presentation M halg).encoding.encode (pairValue M halg r))
      ((source M halg hM hs hv hu).reduction.time.eval (pairEncoding.encode r).length) :=
  (source M halg hM hs hv hu).reduction.correct oracle ho r

/-- Every external callback retains an actual included-graph caller prefix,
actual Pin callee prefix and the actual stored caller frame. -/
theorem query_origin (oracle : List Bool → List Bool)
    (ho : RepresentsOracle Original.targetEncoding (presentation M halg).encoding
      (Original.targetValue M halg) oracle) (r : PairInput) (t : ℕ)
    (c : (source M halg hM hs hv hu).reduction.machine.Cfg)
    (hr : (source M halg hM hs hv hu).reduction.machine.run oracle (pairEncoding.encode r) t=some c)
    (hq : (source M halg hM hs hv hu).reduction.machine.IsQuery c) :
    Holant.LocalDrafts.RemoteWork.PlatonicExits.PhysicalCost.CompositionQueryOrigin
      (includeControlled M halg) (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu)
      oracle r c :=
  Holant.LocalDrafts.RemoteWork.PlatonicExits.PhysicalCost.composeControlled_query_origin
    (includeControlled M halg) (PinInterpolationControl.sourceOfCoefficients M halg hM hs hv hu)
    oracle ho r t c hr hq

theorem query_answer_bytes (oracle : List Bool → List Bool)
    (ho : RepresentsOracle Original.targetEncoding (presentation M halg).encoding
      (Original.targetValue M halg) oracle) (r : PairInput) (t : ℕ)
    (c : (source M halg hM hs hv hu).reduction.machine.Cfg)
    (hr : (source M halg hM hs hv hu).reduction.machine.run oracle (pairEncoding.encode r) t=some c)
    (hq : (source M halg hM hs hv hu).reduction.machine.IsQuery c) :
    ∃ q : Original.TargetInput,
      c.stk (source M halg hM hs hv hu).reduction.machine.queryStack=Original.targetEncoding.encode q ∧
      Original.targetEncoding.decode
        (c.stk (source M halg hM hs hv hu).reduction.machine.queryStack)=some q ∧
      oracle (c.stk (source M halg hM hs hv hu).reduction.machine.queryStack)=
        (presentation M halg).encoding.encode (Original.targetValue M halg q) ∧
      (c.stk (source M halg hM hs hv hu).reduction.machine.queryStack).length≤
        (source M halg hM hs hv hu).queryBound.eval (pairEncoding.encode r).length := by
  obtain ⟨q,hword,hlen⟩ := (source M halg hM hs hv hu).safeQuery oracle ho r t c hr hq
  refine ⟨q,hword,?_,?_,hlen⟩
  · rw [hword]; exact Original.targetEncoding.decode_encode q
  · rw [hword]; exact ho q

theorem prefix_fees (oracle : List Bool → List Bool)
    (ho : RepresentsOracle Original.targetEncoding (presentation M halg).encoding
      (Original.targetValue M halg) oracle) (r : PairInput) (t : ℕ)
    (ht : t≤(source M halg hM hs hv hu).reduction.time.eval (pairEncoding.encode r).length) :
    PinInterpolationControl.Costs.runFee (source M halg hM hs hv hu).reduction.machine
      oracle (pairEncoding.encode r) t≤
      (PinInterpolationControl.Costs.feePolynomial (source M halg hM hs hv hu)).eval
        (pairEncoding.encode r).length :=
  PinInterpolationControl.Costs.runFee_le (source M halg hM hs hv hu) oracle ho r t ht

theorem prefix_coded_storage (oracle : List Bool → List Bool)
    (ho : RepresentsOracle Original.targetEncoding (presentation M halg).encoding
      (Original.targetValue M halg) oracle) (r : PairInput) (t : ℕ)
    (ht : t≤(source M halg hM hs hv hu).reduction.time.eval (pairEncoding.encode r).length)
    (c : (source M halg hM hs hv hu).reduction.machine.Cfg)
    (hr : (source M halg hM hs hv hu).reduction.machine.run oracle (pairEncoding.encode r) t=some c) :
    (PinInterpolationControl.Costs.configurationWord
      (source M halg hM hs hv hu).reduction.machine c).length≤
      (PinInterpolationControl.Costs.codedStoragePolynomial (source M halg hM hs hv hu)).eval
        (pairEncoding.encode r).length :=
  PinInterpolationControl.Costs.coded_storage_le (source M halg hM hs hv hu) oracle ho r t ht c hr

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.SparseOriginalPairAccess
