import Holant.Proofs.Hardness.GeneralEOPairedCSPFamilyNative
import Holant.Proofs.Hardness.GeneralEOPairedCSPField

/-! The arbitrary mixed-family programme uses precisely the coefficient field
and faithful answer codec generated internally by the original family and X.
No substitute family, scalar certificate, or CSP-hardness premise is assumed. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOPairedCSPFamilyField
open Holant Holant.Tractable Holant.Algebraic Holant.Complexity
open scoped BigOperators
namespace O
export GeneralEOPairedCSPField (coefficient field presentation signatures signature_value covers targetValue target_value_exact)
end O
set_option backward.isDefEq.respectTransparency false

variable {L : Type} [Field L] [Algebra ℚ L] {s : ℕ} {arity : ℕ→ℕ}
variable (G : (i : Fin s)→Signature L (arity i.val))
variable (P : (i : Fin s)→OrientedPerfectPairing (arity i.val))

local instance fieldAlgebra : Algebra ℚ (O.field G) := (O.field G).algebra'

def sourceValue (r : GeneralEOPairedCSPFamilyRaw.Input P) : O.field G :=
  GeneralEOPairedCSPFamilyNative.sourceValue (O.signatures G) P r

theorem source_value_exact (r : GeneralEOPairedCSPFamilyRaw.Input P) :
    ((sourceValue G P r : O.field G) : L)=
      GeneralEOPairedCSPFamilyRaw.value P
        (fun i=>GeneralEOPairedCSPCycles.compress (P i) (G i)) r.val := by
  change (O.field G).subtype (GeneralEOPairedCSPFamilyRaw.value P
    (fun i=>GeneralEOPairedCSPCycles.compress (P i) (O.signatures G i)) r.val)=_
  simp only [GeneralEOPairedCSPFamilyRaw.value,GeneralEOPairedCSPCycles.compress,map_sum,map_prod]
  rfl

theorem total_source_value_exact (r : GeneralEOPairedCSPFamilyRaw.Raw s) :
    ((GeneralEOPairedCSPFamilyNative.totalValue (O.signatures G) P r : O.field G) : L)=
      GeneralEOPairedCSPFamilyNative.totalValue G P r := by
  by_cases hr : r.WellFormed P
  · simp only [GeneralEOPairedCSPFamilyNative.totalValue,ite_eq_left hr]
    exact source_value_exact G P ⟨r,hr⟩
  · simp only [GeneralEOPairedCSPFamilyNative.totalValue,ite_eq_right hr]
    rfl

/-- All mixed labels and their own covering pairings participate in the
actual programme, with exactly the original internally derived answer field. -/
def controlled (halg : ∀i x,IsAlgebraic ℚ (G i x))
    (hf : ∀i,GeneralEOPairedCSPCycles.Covers (P i) (G i)) :
    LengthControlledOracleReduction (GeneralEOPairedCSPFamilyRaw.inputEncoding P)
      (O.presentation G halg).encoding (RawClosedNetwork.validatedEncoding s 1 arity)
      (O.presentation G halg).encoding (sourceValue G P) (O.targetValue G halg) :=
  GeneralEOPairedCSPFamilyNative.controlled (O.presentation G halg) (O.signatures G) P
    (fun i=>O.covers G i (P i) (hf i))

/-- Total validation rejects malformed inputs before any query. The answer
codec remains the one generated by the original algebraic family entries. -/
def totalControlled (halg : ∀i x,IsAlgebraic ℚ (G i x))
    (hf : ∀i,GeneralEOPairedCSPCycles.Covers (P i) (G i)) :
    LengthControlledOracleReduction (GeneralEOPairedCSPFamilyRaw.encoding s)
      (O.presentation G halg).encoding (RawClosedNetwork.validatedEncoding s 1 arity)
      (O.presentation G halg).encoding
      (GeneralEOPairedCSPFamilyNative.totalValue (O.signatures G) P) (O.targetValue G halg) :=
  GeneralEOPairedCSPFamilyNative.totalControlled (O.presentation G halg) (O.signatures G) P
    (fun i=>O.covers G i (P i) (hf i))

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.GeneralEOPairedCSPFamilyField
