import Holant.Proofs.Hardness.EightVertexCapStageAccess
import Holant.Proofs.Hardness.EightVertexCapLocal
import Holant.Proofs.Hardness.EightVertexCancellationData

/-! The exact cap-weighted tensor is formed inside the field generated by the
original M. Its own smaller generated field is related by an actual answer
retraction; no independently chosen field encodings are identified. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.EightVertexCapData
open Holant Holant.Algebraic Holant.Complexity
open Holant.LocalDrafts.Hardness.EightVertexNonexception
namespace O
export Holant.LocalDrafts.Hardness.EightVertexNonexception.Source
  (field fieldSignature presentation TargetInput targetEncoding targetValue)
end O
namespace N
export EightVertexCapLocal (output output_applicable)
end N
namespace F
export GeneratedSignatureField (ambient algebraic source)
end F
namespace V
export RealDenseSignTwistStageAccess (value)
end V
set_option backward.isDefEq.respectTransparency false
variable (M : Signature ℂ 4) (k : GeneralCancellationCapPin.Choice)
local instance originalAlgebra : Algebra ℚ (O.field M) := (O.field M).algebra'

def generated : Signature (O.field M) 4 := N.output (O.fieldSignature M) k
def output : Signature ℂ 4 := F.ambient M (generated M k)

theorem output_eq : output M k=N.output M k := by
  funext t
  rcases k with ⟨c,rev⟩
  fin_cases c <;> cases rev <;> cases ht : t 0
  all_goals simp only [output,generated,F.ambient,N.output,
    GeneralCancellationCapPin.oriented,GeneralCancellationCapPin.coefficients,entries,
    ht,Bool.false_eq_true,ite_false,ite_true]
  all_goals rfl

theorem output_applicable (he : EvenSupport M) (h : EightVertexCapLocal.Coefficients M k) :
    EightVertexCancellationLocal.Applicable (output M k) := by
  rw [output_eq]
  exact N.output_applicable M he k h

variable (halg : ∀x,IsAlgebraic ℚ (M x)) (he : EvenSupport M)

def stageSource : LengthControlledOracleReduction O.targetEncoding (O.presentation M halg).encoding
    O.targetEncoding (O.presentation M halg).encoding (V.value (generated M k)) (O.targetValue M halg) := by
  have r := EightVertexCapStageAccess.source (O.presentation M halg)
    (O.fieldSignature M) k (EightVertexCancellationData.field_even M he)
  have ht : V.value (O.fieldSignature M)=O.targetValue M halg :=
    funext (ComplexSelfdualData.target_value M halg)
  rw [ht] at r
  exact r

/-- Fully expanded graph counts for the cap attachment followed by the
accepted two-copy cancellation: four original M vertices and six new X edges
for each quaternary source occurrence. -/
def combinedQuery (r : O.TargetInput) : O.TargetInput :=
  EightVertexCapStageAccess.query (O.fieldSignature M) k
    (EightVertexCancellationStageAccess.query (generated M k) r)

theorem combined_counts (r : O.TargetInput) :
    (combinedQuery M k r).val.vertices.length=4*r.val.vertices.length ∧
      (combinedQuery M k r).val.edges.length=r.val.edges.length+6*r.val.vertices.length := by
  have hc := EightVertexCancellationStageAccess.query_counts (generated M k) r
  have ha := EightVertexCapStageAccess.query_counts (O.fieldSignature M) k
    (EightVertexCancellationStageAccess.query (generated M k) r)
  dsimp only [combinedQuery]
  constructor <;> omega

include he in
theorem combined_value (r : O.TargetInput) :
    V.value (O.fieldSignature M) (combinedQuery M k r)=
      V.value (EightVertexCancellationLocal.output (generated M k)) r := by
  rw [combinedQuery,EightVertexCapStageAccess.query_value (O.fieldSignature M) k
    (EightVertexCancellationData.field_even M he)]
  exact EightVertexCancellationStageAccess.query_value (generated M k)
    (EightVertexCapLocal.output_even (O.fieldSignature M)
      (EightVertexCancellationData.field_even M he) k) r

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.EightVertexCapData
