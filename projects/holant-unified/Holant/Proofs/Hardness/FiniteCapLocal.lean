import Holant.Proofs.Hardness.ArithmeticCapLocal
import Holant.Proofs.Hardness.GeneralCancellationCapPairAccess
import Holant.Projective.BoundedTorsion.CyclotomicDegree

/-! An exact finite test for resonance of the twelve actual oriented caps.
The exponent depends only on the degree of the field generated by the original
signature. Its validity uses the frozen scalar cyclotomic bound, not a group
classification. The algebraicity of the original coefficients proves that field
finite dimensional. This is a finite coefficient criterion, not a claim that
all algebraic complex EO signatures satisfy it. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.HardnessChainV1.FiniteCapLocal
open Holant Holant.Algebraic
open Holant.LocalDrafts.Hardness.EightVertexNonexception
open Holant.LocalDrafts.Hardness.EightVertexNonexception.SixVertexInterpolation
namespace Cap
export GeneralCancellationCapPin (Choice oriented)
end Cap
namespace Bound
export Holant.Projective.BoundedTorsion
  (torsionExponent torsionExponent_pos eigenratio_order_dvd_exponent)
end Bound
namespace Old
export GeneralCancellationCapPairAccess
  (actualM field_oriented_first field_oriented_second)
end Old

section Scalar
variable {K : Type*} [Field K] [Algebra ℚ K] [FiniteDimensional ℚ K]
local instance scalarCharZero : CharZero K := algebraRat.charZero K

/-- Every positive resonance in this number field is detected by one exponent. -/
theorem resonance_forces_exponent (r : K) {n : ℕ} (hn : 0 < n) (h : r ^ n = 1) :
    r ^ Bound.torsionExponent (Module.finrank ℚ K) = 1 := by
  have hf : IsOfFinOrder r := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, h⟩
  apply orderOf_dvd_iff_pow_eq_one.mp
  exact Bound.eigenratio_order_dvd_exponent (L := K) hf.orderOf_pos
    (IsPrimitiveRoot.orderOf r) (s := r + r⁻¹) (by simp)

/-- No infinite-order certificate is an input to the finite test. -/
theorem finite_iff_no_resonance (r : K) :
    r ^ Bound.torsionExponent (Module.finrank ℚ K) ≠ 1 ↔
      ∀ n : ℕ, 0 < n → r ^ n ≠ 1 := by
  constructor
  · intro h n hn he
    exact h (resonance_forces_exponent r hn he)
  · intro h
    exact h _ (Bound.torsionExponent_pos _)

theorem coefficient_iff_no_resonance (p q : K) (hq : q ≠ 0) :
    p ^ Bound.torsionExponent (Module.finrank ℚ K) ≠
      q ^ Bound.torsionExponent (Module.finrank ℚ K) ↔
      ∀ n : ℕ, 0 < n → (p / q) ^ n ≠ 1 := by
  rw [← finite_iff_no_resonance, div_pow]
  exact (not_congr (div_eq_one_iff_eq
    (pow_ne_zero (Bound.torsionExponent (Module.finrank ℚ K)) hq))).symm

end Scalar

variable {L : Type} [Field L] [Algebra ℚ L]
variable (M : Signature L 4)
local instance originalAlgebra : Algebra ℚ (Original.field M) := (Original.field M).algebra'

/-- A single explicit natural exponent for all twelve caps of the original M. -/
def exponent : ℕ := Bound.torsionExponent (Module.finrank ℚ (Original.field M))

theorem exponent_pos : 0 < exponent M := Bound.torsionExponent_pos _

/-- Only finite equalities and inequalities of original cap coefficients occur. -/
def Applicable : Prop :=
  ∃ i : Cap.Choice, (Cap.oriented M i).1 ≠ 0 ∧ (Cap.oriented M i).2 ≠ 0 ∧
    (Cap.oriented M i).1 ^ exponent M ≠ (Cap.oriented M i).2 ^ exponent M

/-- Exactly twelve actual loop/orientation choices are tested. -/
theorem choice_card : Fintype.card Cap.Choice = 12 := by decide

variable (halg : ∀ x, IsAlgebraic ℚ (M x))

include halg

/-- The finite extension is proved from the original coefficient family. -/
theorem original_finiteDimensional : FiniteDimensional ℚ (Original.field M) :=
  familyField_finiteDimensional (Original.coefficient M) (Original.coefficient_algebraic M halg)

/-- Transport the scalar bound back to the literal ambient cap coefficients. -/
theorem cap_resonance_forces_exponent (i : Cap.Choice) {n : ℕ} (hn : 0 < n)
    (h : ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ n = 1) :
    ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ exponent M = 1 := by
  let := original_finiteDimensional M halg
  let r : Original.field M := (Cap.oriented (Old.actualM M) i).1 /
    (Cap.oriented (Old.actualM M) i).2
  have hv : (r : L) = (Cap.oriented M i).1 / (Cap.oriented M i).2 := by
    change ((Cap.oriented (Old.actualM M) i).1 : L) /
      ((Cap.oriented (Old.actualM M) i).2 : L) = _
    rw [Old.field_oriented_first, Old.field_oriented_second]
  have hr : r ^ n = 1 := by
    apply Subtype.ext
    change (r : L) ^ n = 1
    rw [hv]
    exact h
  have he := congrArg (fun z : Original.field M => (z : L))
    (resonance_forces_exponent r hn hr)
  change (r : L) ^ exponent M = 1 at he
  rwa [hv] at he

/-- The literal ambient cap ratio passes one test exactly when no positive
resonance exists. The ratio itself belongs to the original generated field. -/
theorem ratio_finite_iff_no_resonance (i : Cap.Choice) :
    ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ exponent M ≠ 1 ↔
      ∀ n : ℕ, 0 < n → ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ n ≠ 1 := by
  constructor
  · intro h n hn he
    exact h (cap_resonance_forces_exponent M halg i hn he)
  · intro h
    exact h _ (exponent_pos M)

/-- Exact finite coefficient test, with all positive powers discharged internally. -/
theorem infinite_iff_finite (i : Cap.Choice) (hq : (Cap.oriented M i).2 ≠ 0) :
    (Cap.oriented M i).1 ^ exponent M ≠ (Cap.oriented M i).2 ^ exponent M ↔
      ∀ n : ℕ, 0 < n → ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ n ≠ 1 := by
  constructor
  · intro h n hn he
    apply h
    have ht := cap_resonance_forces_exponent M halg i hn he
    rwa [div_pow, div_eq_one_iff_eq (pow_ne_zero _ hq)] at ht
  · intro h he
    apply h _ (exponent_pos M)
    rw [div_pow, div_eq_one_iff_eq (pow_ne_zero _ hq)]
    exact he

/-- Exact classification of the twelve eligible physical caps. -/
theorem applicable_iff_no_resonance : Applicable M ↔
    ∃ i : Cap.Choice, (Cap.oriented M i).1 ≠ 0 ∧ (Cap.oriented M i).2 ≠ 0 ∧
      ∀ n : ℕ, 0 < n → ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ n ≠ 1 := by
  constructor
  · rintro ⟨i, hp, hq, h⟩
    exact ⟨i, hp, hq, (infinite_iff_finite M halg i hq).mp h⟩
  · rintro ⟨i, hp, hq, h⟩
    exact ⟨i, hp, hq, (infinite_iff_finite M halg i hq).mpr h⟩

/-- Rejection supplies a positive resonance at the same single exponent for
all eligible caps; this is a classification of this test, not tractability. -/
theorem rejected_iff_resonant : ¬Applicable M ↔
    ∀ i : Cap.Choice, (Cap.oriented M i).1 ≠ 0 → (Cap.oriented M i).2 ≠ 0 →
      ∃ n : ℕ, 0 < n ∧ ((Cap.oriented M i).1 / (Cap.oriented M i).2) ^ n = 1 := by
  classical
  constructor
  · intro h i hp hq
    refine ⟨exponent M, exponent_pos M, ?_⟩
    rw [div_pow, div_eq_one_iff_eq (pow_ne_zero (exponent M) hq)]
    by_contra he
    exact h ⟨i, hp, hq, he⟩
  · intro h ha
    obtain ⟨i, hp, hq, hi⟩ := (applicable_iff_no_resonance M halg).mp ha
    obtain ⟨n, hn, he⟩ := h i hp hq
    exact hi n hn he

/-- The earlier nonintegral cap subclass is included in the finite criterion. -/
theorem arithmetic_applicable (h : ArithmeticCapLocal.Applicable M) : Applicable M := by
  obtain ⟨i, hp, hq, hr⟩ := h
  exact ⟨i, hp, hq, (infinite_iff_finite M halg i hq).mpr
    (ArithmeticCapLocal.infinite_of_nonintegral _ hr)⟩

end Holant.LocalDrafts.RemoteWork.HardnessChainV1.FiniteCapLocal
