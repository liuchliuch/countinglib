import Holant.Proofs.CountingMachines.StandardMachine.Support.Reverse.TapeAcceptance.Forward

set_option backward.isDefEq.respectTransparency false
/-! Locally checked adaptation of the frozen reference proof. Sole entry for actual output-tape acceptance.
Constructor data: the original finite BinaryMachine, its actual true output
symbol, original input encoding, and polynomial macro clock. The finite
accepting-control table is GENERATED by the real output observer; no table law,
accepted trajectory, verifier correctness, count equality or equivalence is an
input. This closes this TM2 tape-acceptance interface, not a separate standard
Boolean-opcode Turing-machine representation/equivalence theorem. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Reverse.TapeAcceptance.Source
open Turing Computability Holant.Complexity
variable (m : BinaryMachine) (trueSymbol : m.core.Γ m.core.k₁) (T : Polynomial ℕ)
local instance : Fintype m.core.K := m.core.kFin
local instance : Fintype m.core.Λ := m.core.ΛFin
local instance : Fintype m.core.σ := m.core.σFin
local instance (k : m.core.K) : Fintype (m.core.Γ k) := m.alphabets k

abbrev machine := Program.machine m trueSymbol
abbrev staged := Staging.Source.machine (machine m trueSymbol) T (Program.acceptControl m)
abbrev timePolynomial := Staging.Program.timePolynomial (machine m trueSymbol) T (Program.acceptControl m)
abbrev capacityPolynomial := Staging.Program.capacityPolynomial (machine m trueSymbol) T (Program.acceptControl m)
abbrev primitivePolynomial := Staging.Program.primitivePolynomial (machine m trueSymbol) T (Program.acceptControl m)
abbrev bitsPolynomial := Staging.Program.bitsPolynomial (machine m trueSymbol) T (Program.acceptControl m)

def reverseWitness {α : Type} (ea : Encoding α (m.core.Γ m.core.k₀)) :
    SharpPWitness ea (Program.tapeCount m trueSymbol ea T) := Program.reverseWitness m trueSymbol ea T

theorem bounded_inSharpP {α : Type} (ea : Encoding α (m.core.Γ m.core.k₀)) :
    InSharpP ea (Program.tapeCount m trueSymbol ea T) := Program.bounded_inSharpP m trueSymbol ea T

def accepted_equiv {α : Type} (ea : Encoding α (m.core.Γ m.core.k₀)) (a : α) :
    Staging.Program.AcceptedBits (machine m trueSymbol) (Program.acceptControl m)
      (T.eval (ea.encode a).length) (initList (machine m trueSymbol).core (ea.encode a)) ≃
        Program.TapePath m trueSymbol (T.eval (ea.encode a).length) (initList m.core (ea.encode a)) :=
  Program.acceptedEquiv m trueSymbol ea T a

def original_paths_equiv (n : ℕ) (c : m.Config) :
    Program.TapePath m trueSymbol n c ≃ Staging.Program.AcceptedPath (machine m trueSymbol)
      (Program.acceptControl m) n (Program.liftCfg m trueSymbol c) :=
  Program.tapeControlEquiv m trueSymbol n c

theorem observer_cost (v : Program.State m) (S : ∀ k, List (m.core.Γ k)) :
    (HeterogeneousCost.execute (Program.observer m trueSymbol) v S).1 ≤ Fintype.card m.core.K+7 :=
  Program.observer_primitive m trueSymbol v S

theorem token_simulation (token : Option Bool) (c : m.Config) :
    (machine m trueSymbol).step token (Program.liftCfg m trueSymbol c) =
      (m.step token c).map (Program.liftCfg m trueSymbol) := Program.step_lift m trueSymbol token c

theorem output_acceptance (c : m.Config) :
    (Program.liftCfg m trueSymbol c).l = none ∧
      Program.acceptControl m (Program.liftCfg m trueSymbol c).var = true ↔
        c = haltList m.core [trueSymbol] := Program.endpoint_accepts_iff m trueSymbol c

theorem physical_accepts_iff (word : List (m.core.Γ m.core.k₀)) (bits : List Bool) :
    (∃ t, (fun p => p.bind (staged m trueSymbol T).step)^[t]
      (some (initList (staged m trueSymbol T) (word.map Sum.inl++bits.map Sum.inr))) =
      some (haltList (staged m trueSymbol T) [Sum.inr true])) ↔
        ∃ tokens, tokens.length = T.eval word.length ∧ bits = tokens.flatMap Packet.encode ∧
          m.TraceValid tokens (initList m.core word) (haltList m.core [trueSymbol]) :=
  Program.physical_accepts_iff m trueSymbol T word bits

/-- Exact real output data, including malformed/rejecting packets, obtained
from the already delivered original-byte staging and all-stack cleaner. -/
abbrev outputs (word : List (m.core.Γ m.core.k₀)) (bits : List Bool) :=
  Staging.Program.outputs (machine m trueSymbol) T (Program.acceptControl m) word bits

theorem actual_prefix (word : List (m.core.Γ m.core.k₀)) (bits : List Bool)
    (j : ℕ) (hj : j ≤ (outputs m trueSymbol T word bits).steps) :
    ∃ next, (fun p => p.bind (staged m trueSymbol T).step)^[j]
      (some (initList (staged m trueSymbol T) (word.map Sum.inl++bits.map Sum.inr))) = some next ∧
      (∀ k, (next.stk k).length ≤ (capacityPolynomial m trueSymbol T).eval (word.length+bits.length)) ∧
      (Staging.Program.deterministic (machine m trueSymbol) T (Program.acceptControl m)).codedStorageBits next ≤
        (bitsPolynomial m trueSymbol T).eval (word.length+bits.length) ∧
      (Staging.Program.deterministic (machine m trueSymbol) T (Program.acceptControl m)).primitiveCost j
        ([],initList (staged m trueSymbol T) (word.map Sum.inl++bits.map Sum.inr)) ≤
          (primitivePolynomial m trueSymbol T).eval (word.length+bits.length) :=
  Staging.Source.actual_prefix (machine m trueSymbol) T (Program.acceptControl m) word bits j hj

/-- Reuse the existing literal statement-prefix producer, including the
new output observer after the unchanged original instruction syntax. -/
theorem internal_bits (word : List (m.core.Γ m.core.k₀)) (bits : List Bool)
    (j : ℕ) (next : (staged m trueSymbol T).Cfg)
    (hj : j < (outputs m trueSymbol T word bits).steps)
    (hr : (fun p => p.bind (staged m trueSymbol T).step)^[j]
      (some (initList (staged m trueSymbol T) (word.map Sum.inl++bits.map Sum.inr))) = some next)
    (l : Staging.Program.Label (machine m trueSymbol) T)
    (u : Staging.Program.State (machine m trueSymbol) T)
    (U : ∀ k, List (Staging.Program.Alphabet (machine m trueSymbol) T k))
    (h : Staging.Program.InstructionPrefix (machine m trueSymbol) T (Program.acceptControl m)
      (Staging.Program.program (machine m trueSymbol) T (Program.acceptControl m) l)
      next.var next.stk u U)
    (control : Option (Staging.Program.Label (machine m trueSymbol) T)) :
    (Staging.Program.deterministic (machine m trueSymbol) T (Program.acceptControl m)).codedStorageBits
      ⟨control,u,U⟩ ≤ (bitsPolynomial m trueSymbol T).eval (word.length+bits.length) :=
  Staging.Source.internal_bits (machine m trueSymbol) T (Program.acceptControl m)
    word bits j next hj hr l u U h control

theorem wrong_length_rejected (n : ℕ) (bits : List Bool) (c : m.Config)
    (h : bits.length ≠ 2*n) :
    Staging.Program.packetEval (machine m trueSymbol) (Program.acceptControl m)
      n bits (Program.liftCfg m trueSymbol c) = false :=
  Staging.Source.wrong_length_rejected (machine m trueSymbol) (Program.acceptControl m)
    n bits (Program.liftCfg m trueSymbol c) h

theorem illegal_packet_rejected (n : ℕ) (rest : List Bool) (c : m.Config) :
    Staging.Program.packetEval (machine m trueSymbol) (Program.acceptControl m)
      (n+1) (false::true::rest) (Program.liftCfg m trueSymbol c) = false :=
  Staging.Source.illegal_packet_rejected (machine m trueSymbol) (Program.acceptControl m)
    n rest (Program.liftCfg m trueSymbol c)

theorem forbidden_packet_rejected (n : ℕ) (token : Option Bool) (rest : List Bool)
    (c : m.Config) (h : m.step token c = none) :
    Staging.Program.packetEval (machine m trueSymbol) (Program.acceptControl m)
      (n+1) (Packet.encode token++rest) (Program.liftCfg m trueSymbol c) = false := by
  have hs : (machine m trueSymbol).step token (Program.liftCfg m trueSymbol c) = none := by
    rw [Program.step_lift,h]
    rfl
  exact Staging.Source.forbidden_packet_rejected (machine m trueSymbol) (Program.acceptControl m)
    n token rest (Program.liftCfg m trueSymbol c) hs

/-- Wrong original output/state/dirty tapes cannot pass the generated flag.
This consumes the real terminal observer; no source acceptance table is used. -/
theorem terminal_rejected (c : m.Config) (h : c ≠ haltList m.core [trueSymbol]) :
    Staging.Program.packetEval (machine m trueSymbol) (Program.acceptControl m)
      0 [] (Program.liftCfg m trueSymbol c) = false := by
  cases hv : Staging.Program.packetEval (machine m trueSymbol) (Program.acceptControl m)
      0 [] (Program.liftCfg m trueSymbol c) with
  | false => rfl
  | true =>
    obtain ⟨tokens,d,hlen,hword,ht,hl,ha⟩ :=
      (Staging.Program.packet_accepts_iff (machine m trueSymbol) (Program.acceptControl m)
        0 [] (Program.liftCfg m trueSymbol c)).mp hv
    have hn : tokens = [] := List.length_eq_zero_iff.mp hlen
    subst tokens
    have hd : Program.liftCfg m trueSymbol c = d := ht
    subst d
    exact False.elim (h ((Program.endpoint_accepts_iff m trueSymbol c).mp ⟨hl,ha⟩))

/-- Exact concrete forward consumer. These fields use the old verifier,
its actual Γoutput true symbol, and its internally produced original clock. -/
def witness_roundtrip {α : Type} {ea : Encoding α Bool} {f : α → ℕ}
    (w : SharpPWitness ea f) : SharpPWitness ea f := Forward.roundtripWitness w

theorem witness_roundtrip_counts {α : Type} {ea : Encoding α Bool} {f : α → ℕ}
    (w : SharpPWitness ea f) (a : α) :
    Program.tapeCount (Forward.original w) (Forward.trueSymbol w) ea (Forward.clock w) a = f a :=
  Forward.tape_count w a

def witness_accepted_equiv {α : Type} {ea : Encoding α Bool} {f : α → ℕ}
    (w : SharpPWitness ea f) (a : α) :
    Staging.Program.AcceptedBits (Forward.observed w) (Program.acceptControl (Forward.original w))
      (Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.time w a)
      (initList (Program.computer (Forward.original w) (Forward.trueSymbol w)) (ea.encode a)) ≃
        Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.AcceptedWitness w a := Forward.acceptedWitnessEquiv w a

theorem witness_physical_accepts_iff {α : Type} {ea : Encoding α Bool} {f : α → ℕ}
    (w : SharpPWitness ea f) (a : α) (bits : List Bool) :
    (∃ t, (fun p => p.bind
      (Staging.Source.machine (Forward.observed w) (Forward.clock w)
        (Program.acceptControl (Forward.original w))).step)^[t]
      (some (initList
        (Staging.Source.machine (Forward.observed w) (Forward.clock w)
          (Program.acceptControl (Forward.original w)))
        ((ea.encode a).map Sum.inl++bits.map Sum.inr))) =
      some (haltList
        (Staging.Source.machine (Forward.observed w) (Forward.clock w)
          (Program.acceptControl (Forward.original w))) [Sum.inr true])) ↔
      ∃ p : Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.PhysicalPath w a,
        bits = p.val.flatMap Packet.encode := Forward.physical_accepts_iff w a bits

end Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Reverse.TapeAcceptance.Source
