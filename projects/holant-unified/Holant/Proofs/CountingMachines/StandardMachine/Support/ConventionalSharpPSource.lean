import Holant.Proofs.CountingMachines.StandardMachine.Support.BooleanInputWitness.Source
import Holant.Proofs.CountingMachines.StandardMachine.Support.BooleanOpcode.Source
import Holant.Proofs.CountingMachines.StandardMachine.Support.GeneralAlphabetTotalInput

set_option backward.isDefEq.respectTransparency false
/-!
Locally checked adaptation of the frozen reference proof. Concrete finite-program consumer for an original arbitrary
finite-alphabet SharpPWitness. The existing physical input/counter/guard/result
compiler constructs its Boolean-input witness; the existing native forward
producer constructs the actual nondeterministic guess/verify tables. We prove
the missing original-witness to canonical padded-witness bijection and transport
the native resources back to the ORIGINAL alphabet length.

The reverse consumer is the already delivered total-input parser/verifier on
the SAME native program, with its accepting control generated by the actual
output-tape observer. No machine, simulator, verifier correctness, clock bound,
count equation or accepting-control law is an additional constructor argument.

This file deliberately does not define a new predicate called conventional #P.
Its source is an actual finite Boolean-stack BinaryMachine. A separately chosen
ordinary nondeterministic tape-TM model still needs a syntax/microstep simulation
and an accepting-computation bijection. Primitive-cost accounting alone is not
that model-equivalence theorem.
-/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.ConventionalSharpPSource
open Turing Computability Holant.Complexity

namespace Witness
export BooleanInputWitness (oldLength newLength codeWidth input_length paddedAccept)
end Witness
namespace Native
export BooleanOpcode.Source
  (witnessMachine NativePhysicalPath nativeTimePolynomial nativeCapacityPolynomial
    nativePrimitivePolynomial nativeBitsPolynomial nativeInternalBitsPolynomial)
end Native
namespace Observer
export Reverse.TapeAcceptance.Program
  (machine acceptControl TapePath tapeCount tape_count tapeControlEquiv lift_init)
end Observer

private def acceptedCast {n m : ℕ} (h : n = m) (A : List Bool → Bool) :
    {x : Fin n → Bool // A (List.ofFn x) = true} ≃
      {x : Fin m → Bool // A (List.ofFn x) = true} where
  toFun x := ⟨fun i => x.val (Fin.cast h.symm i),by
    rw [← List.ofFn_congr h x.val]
    exact x.property⟩
  invFun x := ⟨fun i => x.val (Fin.cast h i),by
    rw [← List.ofFn_congr h.symm x.val]
    exact x.property⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    exact congrArg x.val (by apply Fin.ext; rfl)
  right_inv x := by
    apply Subtype.ext
    funext i
    exact congrArg x.val (by apply Fin.ext; rfl)

/-- Restrict the old finite split to accepted candidates. The extra bits are
forced false by the existing strict guard, rather than erased after guessing. -/
private def paddingAcceptedEquiv (n r : ℕ) (A : List Bool → Bool) :
    {x : Fin n → Bool // A (List.ofFn x) = true} ≃
      {x : Fin (n+r) → Bool // BooleanInputWitness.Padding.accept n A (List.ofFn x) = true} :=
  BooleanInputWitness.Padding.acceptedEquiv n r A

variable {α Γ : Type} [Fintype Γ] {ea : Encoding α Γ} {f : α → ℕ}
variable (w : SharpPWitness ea f)

/-- This verifier is generated internally from w, including the original
symbol counter, original P(N), strict suffix guard and old result decoder. -/
def booleanWitness : SharpPWitness (BooleanInputWitness.inputEncoding w) f :=
  BooleanInputWitness.Source.source w

/-- Sole program constructor. It returns actual finite push/pop/peek/load/
branch/goto/halt tables, with exactly the original split sites of the existing
forward producer; it does not return an abstract machine-existence proposition. -/
def source : BinaryMachine := Native.witnessMachine (booleanWitness w)

def rawInput (a : α) : List Bool := (BooleanInputWitness.inputEncoding w).encode a

abbrev AcceptedWitness (a : α) :=
  {bits : Fin (Witness.oldLength w a) → Bool // w.accept (a,List.ofFn bits) = true}
abbrev AcceptingPath (a : α) := Native.NativePhysicalPath (booleanWitness w) a

def paddedWitnessEquiv (a : α) : AcceptedWitness w a ≃
    Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.AcceptedWitness (booleanWitness w) a :=
  (paddingAcceptedEquiv (Witness.oldLength w a)
    (Witness.newLength w a-Witness.oldLength w a) (fun bits => w.accept (a,bits))).trans
      (acceptedCast (Nat.add_sub_of_le (BooleanInputWitness.oldLength_le_newLength w a))
        (BooleanInputWitness.Padding.accept (Witness.oldLength w a) (fun bits => w.accept (a,bits))))

/-- The forward map contains precisely the old bits and the sole false tail.
This is a statement about the actual accepted candidate, not just its count. -/
theorem padding_word (a : α) (p : AcceptedWitness w a) :
    List.ofFn (paddedWitnessEquiv w a p).val = List.ofFn p.val ++
      List.replicate (Witness.newLength w a-Witness.oldLength w a) false := by
  let h := Nat.add_sub_of_le (BooleanInputWitness.oldLength_le_newLength w a)
  change List.ofFn (fun i : Fin (Witness.newLength w a) =>
    ((BooleanInputWitness.Padding.split (Witness.oldLength w a)
      (Witness.newLength w a-Witness.oldLength w a)).symm (p.val,fun _ => false))
        (Fin.cast h.symm i)) = _
  rw [← List.ofFn_congr h]
  simp [BooleanInputWitness.Padding.split,List.ofFn_add,List.ofFn_const]
  funext i
  change Fin.addCases p.val (fun _ => false)
    (Fin.castAdd (Witness.newLength w a-Witness.oldLength w a) i) = p.val i
  simp

/-- The inverse is operationally justified by the old suffix guard and the
native physical path producer. Both maps are unique, including early halt. -/
def acceptingPathEquiv (a : α) : AcceptedWitness w a ≃ AcceptingPath w a :=
  (paddedWitnessEquiv w a).trans
    (BooleanOpcode.Source.native_accepted_equiv (booleanWitness w) a)

theorem source_count (a : α) : Fintype.card (AcceptingPath w a) = f a :=
  BooleanOpcode.Source.native_physical_count (booleanWitness w) a

/-- Actual chronological choices are the reversed canonical candidate. None
edges in raw preparation, result decoding and held halt add no split bits. -/
theorem choices_preserved (a : α) (p : AcceptedWitness w a) :
    ((acceptingPathEquiv w a p).val.filterMap id).reverse =
      List.ofFn p.val ++ List.replicate (Witness.newLength w a-Witness.oldLength w a) false := by
  have hlog : (acceptingPathEquiv w a p).val.filterMap id =
      (List.ofFn (paddedWitnessEquiv w a p).val).reverse := by
    change (BooleanOpcode.NativeExecution.fullTokens (booleanWitness w) a
      (Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.physicalTokens (booleanWitness w) a
        (Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.acceptedPathEquiv (booleanWitness w) a
          (paddedWitnessEquiv w a p)))).filterMap id = _
    rw [BooleanOpcode.NativeExecution.fullTokens_log]
    exact (Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.physicalTokens_spec (booleanWitness w) a
      (Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.acceptedPathEquiv (booleanWitness w) a
        (paddedWitnessEquiv w a p))).2.1
  rw [hlog,List.reverse_reverse,padding_word]

def serializationPolynomial : Polynomial ℕ := Polynomial.C (Witness.codeWidth w)*Polynomial.X
def timePolynomial : Polynomial ℕ :=
  (Native.nativeTimePolynomial (booleanWitness w)).comp (serializationPolynomial w)
def capacityPolynomial : Polynomial ℕ :=
  (Native.nativeCapacityPolynomial (booleanWitness w)).comp (serializationPolynomial w)
def primitivePolynomial : Polynomial ℕ :=
  (Native.nativePrimitivePolynomial (booleanWitness w)).comp (serializationPolynomial w)
def bitsPolynomial : Polynomial ℕ :=
  (Native.nativeBitsPolynomial (booleanWitness w)).comp (serializationPolynomial w)
def internalBitsPolynomial : Polynomial ℕ :=
  (Native.nativeInternalBitsPolynomial (booleanWitness w)).comp (serializationPolynomial w)
def clock (a : α) : ℕ := (timePolynomial w).eval (ea.encode a).length

theorem polynomial_transport (P : Polynomial ℕ) (a : α) :
    (P.comp (serializationPolynomial w)).eval (ea.encode a).length = P.eval (rawInput w a).length := by
  simp only [Polynomial.eval_comp,serializationPolynomial,Polynomial.eval_mul,
    Polynomial.eval_C,Polynomial.eval_X,rawInput,Witness.input_length]

theorem source_clock (a : α) : clock w a =
    (Native.nativeTimePolynomial (booleanWitness w)).eval (rawInput w a).length :=
  polynomial_transport w _ a

/-- The source actually reads the internally generated raw fixed-block bytes;
the initial configuration is not a supplied precompiled tape configuration. -/
theorem source_accepts_iff (a : α) (log : List Bool) :
    (source w).run (clock w a) (log,initList (source w).core (rawInput w a)) =
      some ([],haltList (source w).core [true]) ↔
        log.length = Witness.newLength w a ∧ Witness.paddedAccept w (a,log.reverse) = true := by
  rw [source_clock]
  exact BooleanOpcode.Source.native_accepts_iff (booleanWitness w) a log

theorem deterministic_token (label : (source w).core.Λ) (c d : (source w).Config)
    (token : Option Bool) (hl : c.l = some label) (hs : (source w).split label = false)
    (h : (source w).step token c = some d) : token = none :=
  GeneralAlphabetSharpWitness.ordinary_token_unique (source w) label c d token hl hs h

theorem halted_token (c d : (source w).Config) (token : Option Bool)
    (hl : c.l = none) (h : (source w).step token c = some d) : token = none :=
  GeneralAlphabetSharpWitness.halted_token_unique (source w) c d token hl h

theorem halt_padding (n : ℕ) (log : List Bool) :
    (source w).run n (log,haltList (source w).core [true]) =
      some (log,haltList (source w).core [true]) :=
  (source w).run_halt n log _ rfl

theorem canonical_tokens (a : α)
    (p : Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.Source.PhysicalPath (booleanWitness w) a) :
    (BooleanOpcode.NativeExecution.physicalEquiv (booleanWitness w) a p).val =
      List.replicate (BooleanOpcode.NativeInput.steps
        (Reverse.TapeAcceptance.Forward.observed (booleanWitness w)) (rawInput w a).length) none ++
          p.val ++ [none] :=
  BooleanOpcode.Source.native_tokens_preserved (booleanWitness w) a p

/-- Every actual source pre, bounded in the ORIGINAL Γ input length.
All constants are syntactic budgets of source w; no resource premise is given. -/
theorem actual_prefix (a : α) (p : AcceptingPath w a) (j : ℕ) (hj : j ≤ clock w a) :
    ∃ next : List Bool × (source w).Config,
      (source w).run j (p.val.filterMap id,initList (source w).core (rawInput w a)) = some next ∧
      (∀ k, (next.2.stk k).length ≤ (capacityPolynomial w).eval (ea.encode a).length) ∧
      (source w).primitiveCost j
        (p.val.filterMap id,initList (source w).core (rawInput w a)) ≤
          (primitivePolynomial w).eval (ea.encode a).length ∧
      (source w).codedStorageBits next.2 ≤ (bitsPolynomial w).eval (ea.encode a).length := by
  rw [source_clock] at hj
  obtain ⟨next,hr,hcapacity,hprimitive,hbits⟩ :=
    BooleanOpcode.Source.native_actual_prefix (booleanWitness w) a p j hj
  refine ⟨next,hr,?_,?_,?_⟩
  · change ∀ k, (next.2.stk k).length ≤
      ((Native.nativeCapacityPolynomial (booleanWitness w)).comp (serializationPolynomial w)).eval _
    rw [polynomial_transport]
    exact hcapacity
  · change (source w).primitiveCost j _ ≤
      ((Native.nativePrimitivePolynomial (booleanWitness w)).comp (serializationPolynomial w)).eval _
    rw [polynomial_transport]
    exact hprimitive
  · change (source w).codedStorageBits next.2 ≤
      ((Native.nativeBitsPolynomial (booleanWitness w)).comp (serializationPolynomial w)).eval _
    rw [polynomial_transport]
    exact hbits

/-- Literally the installed core/alternate native table, not a new executor. -/
def statement (b : Bool) (l : (source w).core.Λ) :=
  BooleanOpcode.NativeFinish.program (Reverse.TapeAcceptance.Forward.original (booleanWitness w))
    (Reverse.TapeAcceptance.Forward.trueSymbol (booleanWitness w)) (Equiv.refl Bool) b l

/-- Charge each elementary operation inside a real selected statement as well
as the split choice. This cost/space theorem still does not flatten the table
to a separately defined ordinary tape-TM transition relation. -/
theorem internal_prefix (a : α) (log : List Bool) (j : ℕ)
    (next : List Bool × (source w).Config) (hj : j < clock w a)
    (hr : (source w).run j (log,initList (source w).core (rawInput w a)) = some next)
    (l : (source w).core.Λ) (hl : next.2.l = some l) (b : Bool)
    (n : ℕ) (u : (source w).core.σ) (U : (source w).core.K → List Bool)
    (h : BooleanOpcode.NativeExecution.PrimitivePrefix (statement w b l)
      next.2.var next.2.stk n u U) (control : Option (source w).core.Λ) :
    (source w).primitiveCost j (log,initList (source w).core (rawInput w a))+(n+1) ≤
      (primitivePolynomial w).eval (ea.encode a).length ∧
    (source w).codedStorageBits ⟨control,u,U⟩ ≤
      (internalBitsPolynomial w).eval (ea.encode a).length := by
  rw [source_clock] at hj
  have bounds := BooleanOpcode.Source.native_internal_prefix (booleanWitness w) a log j next
    hj hr l hl b n u U h control
  constructor
  · change (source w).primitiveCost j _+(n+1) ≤
      ((Native.nativePrimitivePolynomial (booleanWitness w)).comp (serializationPolynomial w)).eval _
    rw [polynomial_transport]
    exact bounds.1
  · change (source w).codedStorageBits ⟨control,u,U⟩ ≤
      ((Native.nativeInternalBitsPolynomial (booleanWitness w)).comp (serializationPolynomial w)).eval _
    rw [polynomial_transport]
    exact bounds.2

/-- The observer itself generates its accepting-control bit by singleton true,
full EOF, reset state and every other original stack's EOF tests. -/
abbrev observedSource := Observer.machine (source w) true
abbrev nativeClock := Native.nativeTimePolynomial (booleanWitness w)
abbrev observedAccept := Observer.acceptControl (source w)
def totalReverse : SharpPWitness (encodingList Bool)
    (GeneralAlphabetTotalInput.totalCount (observedSource w) (nativeClock w) (observedAccept w)) :=
  GeneralAlphabetTotalInput.source (observedSource w) (nativeClock w) (observedAccept w)

def reverseInput (a : α) : List Bool :=
  GeneralAlphabetTotalInput.codeWord (observedSource w) (nativeClock w) (observedAccept w) (rawInput w a)

/-- Only list/vector transport is new here. The real native run and all
tokens, including every None after halt, are retained verbatim. -/
def tapePhysicalEquiv (a : α) :
    Observer.TapePath (source w) true
      ((nativeClock w).eval (rawInput w a).length) (initList (source w).core (rawInput w a)) ≃
        AcceptingPath w a where
  toFun p := ⟨List.ofFn p.val,List.length_ofFn,p.property⟩
  invFun p := ⟨fun i => p.val.get ⟨i.val,by rw [p.property.1]; exact i.isLt⟩,by
    have word : List.ofFn (fun i : Fin ((nativeClock w).eval (rawInput w a).length) =>
        p.val.get ⟨i.val,by rw [p.property.1]; exact i.isLt⟩) = p.val := by
      apply List.ext_getElem
      · rw [List.length_ofFn,p.property.1]; rfl
      · intro i hi hj
        simp only [List.getElem_ofFn,List.get_eq_getElem]
    rw [word]
    exact p.property.2⟩
  left_inv p := by
    apply Subtype.ext
    funext i
    have hget := List.get_ofFn p.val ⟨i.val,by
      simpa only [List.length_ofFn] using i.isLt⟩
    exact hget.trans (congrArg p.val (by apply Fin.ext; rfl))
  right_inv p := by
    apply Subtype.ext
    apply List.ext_getElem
    · rw [List.length_ofFn,p.property.1]; rfl
    · intro i hi hj
      simp only [List.getElem_ofFn,List.get_eq_getElem]

/-- Both directions now consume concrete producers. This is SAME-program
roundtrip count preservation, not an independent conventional-model theorem. -/
theorem total_reverse_count (a : α) :
    GeneralAlphabetTotalInput.totalCount (observedSource w) (nativeClock w) (observedAccept w)
      (reverseInput w a) = f a := by
  rw [reverseInput,GeneralAlphabetTotalInput.legal_count]
  change Reverse.Staging.Program.pathCount (observedSource w) (observedAccept w)
    (encodingList Bool) (nativeClock w) (rawInput w a) = f a
  rw [← Observer.tape_count (source w) true (encodingList Bool) (nativeClock w) (rawInput w a)]
  calc
    Observer.tapeCount (source w) true (encodingList Bool) (nativeClock w) (rawInput w a) =
        Fintype.card (AcceptingPath w a) := Fintype.card_congr (tapePhysicalEquiv w a)
    _ = f a := source_count w a

theorem malformed_reverse_zero (bits : List Bool)
    (h : GeneralAlphabetTotalInput.Parser.parse (observedSource w) (nativeClock w) (observedAccept w) bits = none) :
    GeneralAlphabetTotalInput.totalCount (observedSource w) (nativeClock w) (observedAccept w) bits = 0 :=
  GeneralAlphabetTotalInput.malformed_zero _ _ _ bits h

def malformed_reverse_outputs (bits witness : List Bool)
    (h : GeneralAlphabetTotalInput.Parser.parse (observedSource w) (nativeClock w) (observedAccept w) bits = none) :
    TM2OutputsInTime (totalReverse w).verifier.tm (bits.map Sum.inl++witness.map Sum.inr)
      (some [Sum.inr false])
      ((GeneralAlphabetTotalInput.time (observedSource w) (nativeClock w) (observedAccept w)).eval
        (bits.length+witness.length)) :=
  GeneralAlphabetTotalInput.malformed_outputs _ _ _ bits witness h

/-- Unique entry theorem: all objects and the count law were produced above
from the original witness, with no machine-existence or #P equivalence premise. -/
theorem witness_source (a : α) :
    Nonempty (AcceptedWitness w a ≃ AcceptingPath w a) ∧
      Fintype.card (AcceptingPath w a) = f a ∧
      GeneralAlphabetTotalInput.totalCount (observedSource w) (nativeClock w) (observedAccept w)
        (reverseInput w a) = f a :=
  ⟨⟨acceptingPathEquiv w a⟩,source_count w a,total_reverse_count w a⟩

end Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.ConventionalSharpPSource
