import Holant.Proofs.CountingMachines.StandardMachine.Support.Reverse.TapeAcceptance.Source
import Holant.Proofs.CountingMachines.StandardMachine.Support.BooleanOpcode.NativeInput

set_option backward.isDefEq.respectTransparency false
/-! Locally checked adaptation of the frozen reference proof. Real decoding of the actual singleton true output.
The source control flag is generated by the existing TapeAcceptance program,
not supplied as an accepting-table law. The block reader physically consumes
all code bits and checks actual EOF before emitting one plain Boolean output. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.BooleanOpcode.Output
open Turing Computability Holant.Complexity
variable (m : BinaryMachine) (trueSymbol : m.core.Γ m.core.k₁)
abbrev observed := Reverse.TapeAcceptance.Program.machine m trueSymbol
local instance : Fintype m.core.K := m.core.kFin
local instance : Fintype m.core.Λ := m.core.ΛFin
local instance : DecidableEq (m.core.Γ m.core.k₁) := Classical.decEq _

def emit (candidate : Bool) :
    TM2.Stmt (fun _ : m.core.K => Bool) m.core.Λ (Block.State (observed m trueSymbol)) :=
  .load (fun v => (v.1,none,Reverse.TapeAcceptance.Program.acceptControl m v.1 && candidate))
    (.peek m.core.k₁ (Block.setBit (observed m trueSymbol))
      (.push m.core.k₁ (fun v => v.2.2 && v.2.1.isNone)
        (.load (fun _ => Block.clear (observed m trueSymbol) (observed m trueSymbol).core.initialState) .halt)))

def decoder :
    TM2.Stmt (fun _ : m.core.K => Bool) m.core.Λ (Block.State (observed m trueSymbol)) :=
  Block.readSymbol (observed m trueSymbol) m.core.k₁
    (fun head => head.elim (emit m trueSymbol false) (fun a => emit m trueSymbol (decide (a = trueSymbol))))

theorem emit_budget (b : Bool) : HeterogeneousCost.budget (emit m trueSymbol b) = 5 := rfl

theorem decoder_budget : HeterogeneousCost.budget (decoder m trueSymbol) ≤
    3*Code.width (observed m trueSymbol) m.core.k₁+8 := by
  have hc : ∀ head : Option (m.core.Γ m.core.k₁), HeterogeneousCost.budget
      (head.elim (emit m trueSymbol false) (fun a => emit m trueSymbol (decide (a = trueSymbol)))) ≤ 5 := by
    intro head
    cases head <;> exact Nat.le_refl _
  simpa only [decoder,Block.readSymbol,Nat.add_assoc] using
    Block.read_budget (observed m trueSymbol) m.core.k₁ _ 5 hc
      (Code.width (observed m trueSymbol) m.core.k₁) []

/-- Actual finite Boolean decoding of the old observer's genuine true terminal.
The accepted state is constructed from the original haltList and the proved
observer, rather than introduced as a supplied flag or candidate output. -/
theorem decoder_true :
    TM2.stepAux (decoder m trueSymbol)
      (Compiler.cfg (observed m trueSymbol)
        (Reverse.TapeAcceptance.Program.liftCfg m trueSymbol (haltList m.core [trueSymbol]))).var
      (Compiler.cfg (observed m trueSymbol)
        (Reverse.TapeAcceptance.Program.liftCfg m trueSymbol (haltList m.core [trueSymbol]))).stk =
      haltList (Compiler.computer (observed m trueSymbol)) [true] := by
  have hv := (Reverse.TapeAcceptance.Program.endpoint_accepts_iff m trueSymbol
    (haltList m.core [trueSymbol])).mpr rfl
  let S : m.core.K → List Bool := fun _ => []
  have hs : Code.tapes (observed m trueSymbol) (haltList m.core [trueSymbol]).stk =
      Function.update S m.core.k₁ (Code.symbol (observed m trueSymbol) m.core.k₁ trueSymbol++S m.core.k₁) := by
    funext k
    by_cases hk : k = m.core.k₁
    · subst k
      simp [Code.tapes,Code.word,haltList,S]
    · simp [Code.tapes,Code.word,haltList,S,hk]
  change TM2.stepAux (decoder m trueSymbol)
    (Block.clear (observed m trueSymbol)
      (Reverse.TapeAcceptance.Program.liftCfg m trueSymbol (haltList m.core [trueSymbol])).var)
    (Code.tapes (observed m trueSymbol) (haltList m.core [trueSymbol]).stk) = _
  rw [hs,decoder,Block.read_symbol]
  simp only [Option.elim_some,decide_true]
  have hc : Reverse.TapeAcceptance.Program.acceptControl m
      (Reverse.TapeAcceptance.Program.liftCfg m trueSymbol (haltList m.core [trueSymbol])).var = true := hv.2
  simp only [emit,TM2.stepAux,Block.clear,Block.setBit,hc,Bool.and_true]
  simp only [S,List.head?_nil,Option.isNone_none,haltList,Compiler.computer,
    Reverse.TapeAcceptance.Program.computer]
  congr 1
  funext k
  simp [Function.update_apply]

end Holant.LocalDrafts.RemoteWork.CountingBridge.StandardMachine.Support.BooleanOpcode.Output
