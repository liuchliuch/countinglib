def planeMinor (f : Form) (p : Fin 120) (a b : Fin 10) : Fin 2→Fin 3 :=
  ![![0,1],![0,2],![1,2]] (planeMinorCode f p a b)

def projectedTable (f : Form) (p : Fin 120) (r : Fin 24) : Fin 3→Scalar :=
  fun i=>pairTable f (planeTriple p i) r

def PlaneCertificate (f : Form) (p : Fin 120) : Prop :=
  planeNormal f p≠0 ∧
  (∀i : Fin 24,rawDot (planeNormal f p) (rawPoint f i)=0 ↔ i∈planeMask p) ∧
  ∀a b : Fin 10,a≠b→cross (projectedTable f p (planeWitness f p a))
    (projectedTable f p (planeWitness f p b)) (planeMinor f p a b 0) (planeMinor f p a b 1)≠0

instance (f : Form) (p : Fin 120) : Decidable (PlaneCertificate f p) := by
  unfold PlaneCertificate
  infer_instance

