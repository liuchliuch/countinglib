    Signature.coordinateAction (correctionPorts (baseForm true)) (rawPrototype (baseForm true))
      (TetrahedralDeck.words 8) = baseTensor true (TetrahedralDeck.words 8) := by
  simp only [correctionPorts,fourth_action]
