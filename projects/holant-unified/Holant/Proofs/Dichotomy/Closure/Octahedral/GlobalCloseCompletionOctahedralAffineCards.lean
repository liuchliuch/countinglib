import Holant.Proofs.Dichotomy.Closure.Tetrahedral.GlobalCloseCompletionTetrahedralAffineCards
import Holant.Proofs.Dichotomy.Closure.Octahedral.GlobalCloseCompletionOctahedralProducts

/-! Affinity of every literal octahedral binary, and consequently of every
actual matching card at arbitrary arity. The extra coset is generated by the
literal quarter-phase diagonal; no affine-membership oracle is used. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
namespace Holant.LocalDrafts.RemoteWork.RootIntegrationV1.GlobalCloseCompletionOctahedralAffineCards
open Holant Holant.Tractable Holant.Tractable.AffinePhase Holant.Tractable.TwoTranslate
open Holant.Projective.BoundedTorsion
open Holant.Certificates.MatchingContractionClosure
open Holant.Certificates.MatchingProductBridge
open Holant.Certificates.OctahedralSeparator
open Holant.Platonic.StabilizerLine Holant.Platonic.StabilizerShortening
open Holant.LocalDrafts.MainChain RingHomRealization
open Holant.LocalDrafts.FinitePGL2.Stabilization
open Holant.LocalDrafts.RemoteWork.StableClosureV2
open ClosureMarkedDihedral.Source
open scoped BigOperators
open Holant.Certificates

def first (j : Fin 12) : Fin 24 := ⟨j.val,by omega⟩

theorem tetrahedral_representative (j : Fin 12) :
    RainbowOrbit.representative .tetrahedral j=RainbowOrbit.representative .octahedral (first j) := by
  have h : RainbowOrbit.tetrahedralRaw j=RainbowOrbit.octahedralRaw (first j) := by fin_cases j <;> rfl
  exact congrArg RainbowOrbit.goldenMatrix h

theorem coset_cover (k : Fin 24) :
    ∃j : Fin 12,first j=k ∨ GlobalCloseCompletionOctahedralGeometry.Products.productIndex 16 (first j)=k := by
  fin_cases k <;> decide +kernel

def quarterPhase : QuadraticPhase 2 where
  constant := 0
  linear := ![3,0]
  mixed := fun _ _=>0
  even_mixed := by intros; exact Or.inl rfl

theorem quarter_affine : Affine
    (fun x : Word 2=>if x 0 then -imaginaryUnit else 1) := by
  have h : (fun x : Word 2=>if x 0 then -imaginaryUnit else 1)=
      affineFormula 1 (AffineSystem.unconstrained 2) quarterPhase := by
    funext x
    cases h0 : x 0 <;> cases h1 : x 1 <;>
      norm_num [affineFormula,AffineSystem.unconstrained_holds,quarterPhase,
        QuadraticPhase.eval,Fin.sum_univ_succ,bitValue,fourthRootPhase,
        ZMod.val_ofNat,ZMod.val_natCast,ZMod.val_zero,ZMod.val_one_eq_one_mod,
        imaginaryUnit_pow_three,h0,h1]
  rw [h]
  exact affine_formula _ _ _

theorem complex_quarter_affine : ComplexAffine
    (fun x : Word 2=>if x 0 then -Complex.I else 1) := by
  refine ⟨1,fun x=>if x 0 then -imaginaryUnit else 1,quarter_affine,?_⟩
  intro x
  cases h : x 0 <;> simp [h,coe_imaginaryUnit]

theorem diagonal_product (U : Matrix Bool Bool ℂ) :
    Holant.Projective.BoundedTorsion.binarySignature
      (RainbowOrbit.representative .octahedral (16 : Fin 24)*U)=
    fun x=>(1+Complex.I)*((if x 0 then -Complex.I else 1)*
      Holant.Projective.BoundedTorsion.binarySignature U x) := by
  have hd : RainbowOrbit.representative .octahedral (16 : Fin 24)=quaternionBasis 0+quaternionBasis 3 := by
    change RainbowOrbit.goldenMatrix (RainbowOrbit.octahedralRaw (16 : Fin 24))=_
    rw [RainbowOrbit.octahedralRaw_standard]
    rw [show standard (16 : Fin 24)=q 0 + q 3 from rfl,complexMatrix_add]
    rw [complexMatrix_q,complexMatrix_q]
    rfl
  rw [hd]
  funext x
  cases h : x 0 <;>
    simp [Holant.Projective.BoundedTorsion.binarySignature,Matrix.mul_apply,
      Fintype.sum_bool,quaternionBasis,Q0,Q3,Signature.equality,h] <;> ring_nf <;> simp [Complex.I_sq]

theorem representative_affine (k : Fin 24) :
    ComplexAffine (Holant.Projective.BoundedTorsion.binarySignature
      (RainbowOrbit.representative .octahedral k)) := by
  obtain ⟨j,hj|hj⟩ := coset_cover k
  · rw [←hj,←tetrahedral_representative]
    exact GlobalCloseCompletionTetrahedralAffineCards.direction_affine _
      (RainbowOrbit.representative_mem .tetrahedral j)
  · have ha := GlobalCloseCompletionTetrahedralAffineCards.direction_affine _
      (RainbowOrbit.representative_mem .tetrahedral j)
    rw [tetrahedral_representative] at ha
    have hb := (affine_complex_mul complex_quarter_affine ha).scale (1+Complex.I)
    rw [←diagonal_product] at hb
    have hp := RainbowOrbit.mul_exact .octahedral (16 : Fin 24) (first j)
    have hs : (RainbowOrbit.productScale .octahedral (16 : Fin 24) (first j) : ℂ)≠0 :=
      Int.cast_ne_zero.mpr (RainbowOrbit.raw_certificate .octahedral (16 : Fin 24) (first j)).1
    change RainbowOrbit.productIndex .octahedral (16 : Fin 24) (first j)=k at hj
    rw [hj] at hp
    rw [hp] at hb
    exact (affine_complex_scale_iff _ hs _).mp hb

theorem direction_affine (U : Matrix Bool Bool ℂ) (member : groupDirection .octahedral U) :
    ComplexAffine (Holant.Projective.BoundedTorsion.binarySignature U) := by
  obtain ⟨k,c,_,rfl⟩ := (RainbowOrbit.complete .octahedral U).mp member
  exact (representative_affine k).scale c
 theorem presentation_affine {n : ℕ} (M : Presentation ℂ (Fin n))
    (member : ∀e,groupDirection .octahedral (M.matrix e)) : ComplexAffine M.tensor := by
  classical
  have hf (e : Fin M.edges) : ComplexAffine
      (fun x : Word n => M.matrix e (x (M.ports (e,false))) (x (M.ports (e,true)))) := by
    apply affine_complex_precompose (direction_affine _ (member e))
      (fun x => ![x (M.ports (e,false)),x (M.ports (e,true))])
    intro x y
    ext i
    fin_cases i <;> simp [AffinePhase.xor,origin]
  have product (S : Finset (Fin M.edges)) : ComplexAffine
      (fun x : Word n => ∏e∈S,M.matrix e (x (M.ports (e,false))) (x (M.ports (e,true)))) := by
    induction S using Finset.induction_on with
    | empty =>
        exact ⟨1,fun _=>1,affine_constant n 1,by intro x; simp⟩
    | @insert e S he ih =>
        simpa only [Finset.prod_insert he] using affine_complex_mul (hf e) ih
  exact (product Finset.univ).scale M.scalar

variable {L : Type*} [Field L] [NumberField L]
variable (phi : L→+*Holant.Marked.Scalar) (F : SignatureFamily L) (torsion : ResidualTorsion F)
variable (literal : group phi F torsion=Holant.Projective.FiniteGroupFacts.modelPGL .octahedral)

include literal in
 theorem safe_direction (B : Matrix Bool Bool L) (safe : SafeBinary (actualTransfers F) B) :
    groupDirection .octahedral (B.map (complexEmbedding phi)) := by
  obtain ⟨C,hC,c,hc,he⟩ := safe
  have hB : B=c • C := by
    have ht := congrArg (fun A : Matrix Bool Bool L=>
      A*(Holant.Certificates.MatchingContractionClosure.X : Matrix Bool Bool L)) he
    simpa only [transfer,Matrix.smul_mul,Matrix.mul_assoc,X_mul_X,Matrix.mul_one] using ht
  have h := GlobalCloseCompletionPlatonicCards.actual_direction phi F torsion
    .octahedral literal C hC
  rw [hB]
  have hm : (c • C).map (complexEmbedding phi)=complexEmbedding phi c • C.map (complexEmbedding phi) := by
    ext a b
    change (complexEmbedding phi) (c*C a b)=complexEmbedding phi c*complexEmbedding phi (C a b)
    exact map_mul _ _ _
  rw [hm]
  exact groupDirection_smul .octahedral h ((map_ne_zero _).mpr hc)

include literal in
 theorem matching_affine {n : ℕ} (f : Signature L n)
    (matching : MatchingOrZero (actualTransfers F) f) :
    ComplexAffine (RingHomRealization.mapSignature (complexEmbedding phi) f) := by
  rcases matching with rfl | ⟨M,hM,_,rfl⟩
  · have hz : RingHomRealization.mapSignature (complexEmbedding phi) (0 : Signature L n)=0 := by
      funext x
      exact map_zero _
    rw [hz]
    exact affine_zero_complex
  let N : Presentation ℂ (Fin n) :=
    ⟨M.edges,M.ports,fun e=>(M.matrix e).map (complexEmbedding phi),complexEmbedding phi M.scalar⟩
  have hN : ∀e,groupDirection .octahedral (N.matrix e) :=
    fun e=>safe_direction phi F torsion literal (M.matrix e) (hM e)
  have he : RingHomRealization.mapSignature (complexEmbedding phi) M.tensor=N.tensor := by
    ext x
    simp [RingHomRealization.mapSignature,Presentation.tensor,productValue,N,map_prod]
  rw [he]
  exact presentation_affine N hN

end Holant.LocalDrafts.RemoteWork.RootIntegrationV1.GlobalCloseCompletionOctahedralAffineCards
end
