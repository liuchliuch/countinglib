def schedule (q : Fin 7→Bool) : Fin 6→Transform := table (pattern q)

def contribution (q : Fin 7→Bool) (t : Transform) (j : Fin 7) : ℕ :=
  ∑k : Fin 7,if q k ∧ image t k=j.succ then 1 else 0

/-- The complete finite assertion is evaluated by Lean's kernel. -/
theorem certificate (q : Fin 7→Bool) (h : ¬∀j,q j=true) (j : Fin 7) :
    ((if q j then 1 else 0)+(∑i : Fin 6,contribution q (schedule q i) j))%2=0 := by
  have hq : q=![q 0,q 1,q 2,q 3,q 4,q 5,q 6] := by
    funext i
    fin_cases i <;> rfl
  rw [hq] at h ⊢
  cases h0 : q 0 <;> cases h1 : q 1 <;> cases h2 : q 2 <;> cases h3 : q 3 <;>
    cases h4 : q 4 <;> cases h5 : q 5 <;> cases h6 : q 6
  all_goals simp only [h0,h1,h2,h3,h4,h5,h6] at h ⊢
  all_goals first
    | (exfalso;apply h;intro i;fin_cases i <;> rfl)
    | (revert j;decide)

end Holant.LocalDrafts.RemoteWork.RootIntegrationV1.OrdinaryNegativeSparseRankThreeParity
