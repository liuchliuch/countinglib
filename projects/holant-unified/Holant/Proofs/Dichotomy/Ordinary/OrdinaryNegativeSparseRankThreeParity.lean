import Holant.Proofs.Dichotomy.Ordinary.OrdinaryNegativeSparseMixingAlpha

/-! Kernel-checked finite rank-three parity certificate. Unless all seven
bundles are odd, six proper-coordinate-face substitutions cancel the actual
bundle parities. Each transformation pins one of the three original logical
information coordinates to zero; its other coordinates are named characters.
The certificate stores concrete maps, not a successful-gadget assumption. -/
noncomputable section
namespace Holant.LocalDrafts.RemoteWork.RootIntegrationV1.OrdinaryNegativeSparseRankThreeParity
open Holant Holant.Tractable
open scoped BigOperators
namespace A
export OrdinaryNegativeSparseMixingAlpha (codeSeven codeSeven_affine)
end A
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
set_option maxRecDepth 32768
set_option Elab.async false

/-- Zero is the constant false; the other seven names use codeSeven order. -/
def bits (i : Fin 8) : Fin 3→Bool :=
  ![![false,false,false],![true,false,false],![false,true,false],![false,false,true],
    ![false,true,true],![true,false,true],![true,true,false],![true,true,true]] i

def name (a b c : Bool) : Fin 8 :=
  if a then (if b then (if c then 7 else 6) else (if c then 5 else 1))
  else if b then (if c then 4 else 2) else if c then 3 else 0

def plus (i j : Fin 8) : Fin 8 :=
  name (bits i 0 ^^ bits j 0) (bits i 1 ^^ bits j 1) (bits i 2 ^^ bits j 2)

def value (j : Fin 8) (x : Fin 3→Bool) : Bool :=
  if h : j=0 then false else A.codeSeven x ⟨j.val-1,by have hlt:=j.isLt;have hn:=j.pos_iff_ne_zero.mpr h;omega⟩

theorem value_plus (i j : Fin 8) (x : Fin 3→Bool) :
    value (plus i j) x=Bool.xor (value i x) (value j x) := by
  revert i j x
  decide

structure Transform where
  axis : Fin 3
  first : Fin 8
  second : Fin 8
  deriving DecidableEq, Fintype

def inputs (t : Transform) : Fin 3→Fin 8 :=
  if t.axis=0 then ![0,t.first,t.second]
  else if t.axis=1 then ![t.first,0,t.second] else ![t.first,t.second,0]

def image (t : Transform) : Fin 7→Fin 8 :=
  let a := inputs t 0
  let b := inputs t 1
  let c := inputs t 2
  ![a,b,c,plus b c,plus a c,plus a b,plus (plus a b) c]

def linearWord (t : Transform) (x : Fin 3→Bool) : Fin 3→Bool := fun i=>value (inputs t i) x

theorem image_value (t : Transform) (j : Fin 7) (x : Fin 3→Bool) :
    value (image t j) x=A.codeSeven (linearWord t x) j := by
  fin_cases j
  · rfl
  · rfl
  · rfl
  · exact value_plus _ _ x
  · exact value_plus _ _ x
  · exact value_plus _ _ x
  · exact (value_plus _ _ x).trans (congrArg₂ Bool.xor (value_plus _ _ x) rfl)

theorem linearWord_pin (t : Transform) (x : Fin 3→Bool) : linearWord t x t.axis=false := by
  rcases t with ⟨a,u,v⟩
  fin_cases a <;> simp [linearWord,inputs,value]

theorem linearWord_affine (t : Transform) : TwoTranslate.IsAffineMap (linearWord t) := by
  intro x y
  funext i
  unfold linearWord
  by_cases h : inputs t i=0
  · simp [value,h,AffinePhase.xor,AffinePhase.origin]
  · have hn := (inputs t i).pos_iff_ne_zero.mpr h
    have hl := (inputs t i).isLt
    have hc := congrFun (A.codeSeven_affine x y) (⟨(inputs t i).val-1,by omega⟩ : Fin 7)
    simpa [value,h,AffinePhase.xor] using hc

def pattern (q : Fin 7→Bool) : Fin 128 :=
  Fin.ofNat 128 (∑i : Fin 7,if q i then 2^i.val else 0)

