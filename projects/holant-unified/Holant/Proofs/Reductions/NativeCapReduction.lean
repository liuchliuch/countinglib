import Holant.Proofs.Reductions.NativeCap
import Holant.Complexity.FixedGadgetSubstitution.AlgebraicProjectiveAdjoin


noncomputable section
namespace Holant.LocalDrafts.Hardness.NativeCapReduction
set_option backward.isDefEq.respectTransparency false

open Holant.Algebraic Holant.Complexity
open FixedGadgetSubstitution ExactSignatureTables NativeCap

variable {L : Type} [Field L] [Algebra ℚ L]
variable {s n : ℕ} {arity : ℕ → ℕ}
variable (coeff : CoefficientIndex s 1 arity → L)
variable (halg : ∀ i, IsAlgebraic ℚ (coeff i))
variable (j : Fin s) (hj : arity j.val = n + 2)

def signatures (i : Fin s) : Signature L (arity i.val) := fun x => coeff (.inl ⟨i,x⟩)
abbrev retained := retainedTensor (signatures coeff) j hj
abbrev capTemplate := template (retained coeff j hj) j hj
abbrev macroValid := template_wellFormed (retained coeff j hj) j hj

variable (hnative : ∀ (i : Fin 1) u v, coeff (.inr (i,u,v)) = Signature.disequality u v)
variable (b : Bool → Bool → L) (a : Signature L n)
variable (hf : retained coeff j hj = frontProduct b a)

include hnative hf

/-- The local identity is derived from the original factor table and actual X
edge. Neither an oracle equation nor a gadget denotation is an input premise. -/
theorem macro_exact :
    (OriginalFamily.ambientMacro coeff (capTemplate coeff j hj) (macroValid coeff j hj)).denote =
      capScalar b • a := by
  have hk : (fun (i : Fin 1) u v => coeff (.inr (i,u,v))) =
      (fun _ : Fin 1 => (Signature.disequality : Bool → Bool → L)) := by
    funext i u v
    exact hnative i u v
  unfold OriginalFamily.ambientMacro
  rw [hk]
  exact template_denote_factor (signatures coeff) j hj b a hf

variable (haalg : ∀ x, IsAlgebraic ℚ (a x))

/-- Concrete source and target codecs: ordinary ordered graph records and exact
coordinates in the common field generated by the fixed original/factor tables. -/
abbrev ReductionType (p : Fin n → Bool) :=
  AlgebraicProjectiveAdjoin.ReductionType coeff halg (capTemplate coeff j hj) (macroValid coeff j hj) a haalg p

/-- The only extra nonzero condition is the explicitly evaluated native cap.
It cannot be inferred from nonzero b, and is not a surrogate for theorem 2.16. -/
def reduction (hc : capScalar b ≠ 0) (p : Fin n → Bool) (hp : a p ≠ 0) :
    ReductionType coeff halg j hj a haalg p :=
  AlgebraicProjectiveAdjoin.reduction coeff halg (capTemplate coeff j hj) (macroValid coeff j hj) a haalg
    (capScalar b) hc (macro_exact coeff j hj hnative b a hf) p hp

/-- After exact normalization the source is precisely the retained family plus
the factor, not the cap output with an unspecified projective multiplier. -/
theorem source_family_exact (hc : capScalar b ≠ 0)
    (p : Fin n → Bool) (hp : a p ≠ 0) :
    Set.range (fun i : Fin (s+1) =>
      (⟨sourceArity (Adjoin.templates s arity (capTemplate coeff j hj)) i.val,
        PresentedScaledFamily.ambientSource
          (AlgebraicProjectiveAdjoin.values coeff (capTemplate coeff j hj) a) Sum.inl
          (capTemplate coeff j hj) (macroValid coeff j hj)
          (AlgebraicProjectiveAdjoin.scaleAt coeff halg (capTemplate coeff j hj) (macroValid coeff j hj)
            a haalg p) i⟩ : AnySignature L)) =
      Set.range (fun i : Fin s => (⟨arity i.val, signatures coeff i⟩ : AnySignature L)) ∪
        {⟨n,a⟩} :=
  AlgebraicProjectiveAdjoin.source_family_exact coeff halg (capTemplate coeff j hj) (macroValid coeff j hj)
    a haalg (capScalar b) hc (macro_exact coeff j hj hnative b a hf) p hp

theorem nonempty_reduction (hc : capScalar b ≠ 0) (ha : a ≠ 0) :
    ∃ p, Nonempty (ReductionType coeff halg j hj a haalg p) :=
  AlgebraicProjectiveAdjoin.nonempty_reduction coeff halg (capTemplate coeff j hj) (macroValid coeff j hj)
    a haalg (capScalar b) hc (macro_exact coeff j hj hnative b a hf) ha

/- The target oracle is the literal original family with native X edges. -/
omit hf in
theorem target_value_exact (r : Input s 1 arity) :
    (((AlgebraicProjectiveAdjoin.originalTables coeff halg (capTemplate coeff j hj) a haalg).evaluate
      (AlgebraicProjectiveAdjoin.presentation coeff halg (capTemplate coeff j hj) a haalg) r :
        familyField (AlgebraicProjectiveAdjoin.values coeff (capTemplate coeff j hj) a)) : L) =
      (r.val.realize r.property (signatures coeff) (fun _ => Signature.disequality)).denote
        Fin.elim0 := by
  have hk : (fun (i : Fin 1) u v => coeff (.inr (i,u,v))) =
      (fun _ : Fin 1 => (Signature.disequality : Bool → Bool → L)) := by
    funext i u v
    exact hnative i u v
  have he := AlgebraicProjectiveAdjoin.target_value_exact coeff halg (capTemplate coeff j hj) a haalg r
  rw [hk] at he
  exact he

end Holant.LocalDrafts.Hardness.NativeCapReduction
