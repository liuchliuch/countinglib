import Holant.Proofs.BinaryInterpolation.OriginalTables
import Holant.Proofs.BinaryInterpolation.EncodedBatch
import Holant.Proofs.BinaryInterpolation.PostprocessBounds


namespace Holant.LocalDrafts.BinaryInterpolation.PostprocessCorrectness
open Holant.Complexity Holant.Complexity.BinaryInterpolation
open Holant.Complexity.FixedGadgetSubstitution
open Holant.Certificates.MatchingContractionClosure
open Holant.OneHot.StackProgram
noncomputable section
set_option backward.isDefEq.respectTransparency false
variable {s : ℕ} {arity : ℕ → ℕ}
variable (G : (i : Fin s) → Signature ℂ (arity i.val))
variable {B : Binary (K:=ℂ)} (M : AlgebraicSource.Macro G B)
variable (p : AlgebraicSource.Pencil M.binary)

abbrev Source := PhysicalQueries.Source (s:=s) (b:=1) arity M.label.template

def target (q : ExactSignatureTables.Input s 1 arity) : ℂ :=
  (q.val.realize q.property G (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0

def answers (r : Source G M) (i : Fin (occurrences s r.val+1)) : ℂ :=
  target G (Chains.Compiler.OriginalFamily.value arity M.label.template
    M.label.wellFormed rfl (0 : Fin 1) ⟨r,i⟩)

def denominators (r : Source G M) : Fin (occurrences s r.val+1) → ℂ :=
  queryDenominator (WeightFormulas.nodes p.geometric p.rho (occurrences s r.val))
    (WeightFormulas.scales p.beta (occurrences s r.val))

theorem nodes_eq (m : ℕ) : WeightFormulas.nodes p.geometric p.rho m =
    (fun i : Fin (m+1) => p.node (i.val+1)) := rfl

theorem denominator_nonzero (r : Source G M) : commonDenominator (denominators G M p r) ≠ 0 := by
  apply commonDenominator_ne_zero
  intro i
  apply queryDenominator_ne_zero
  · exact p.positive_nodes_injective (occurrences s r.val)
  · intro i
    exact pow_ne_zero _ p.beta_nonzero

theorem quotient_correct (r : Source G M) :
    commonNumerator (denominators G M p r) (answers G M r) /
      commonDenominator (denominators G M p r) =
    (r.val.realize r.property
      (OriginalTables.binarySlot M.label.template M.label.wellFormed G
        (fun _ : Fin 1 => Signature.disequality) rfl p.H)
      (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0 := by
  have hn : Function.Injective (WeightFormulas.nodes p.geometric p.rho (occurrences s r.val)) :=
    p.positive_nodes_injective (occurrences s r.val)
  have hc : ∀ i : Fin (occurrences s r.val+1),
      WeightFormulas.scales p.beta (occurrences s r.val) i ≠ 0 :=
    fun i => pow_ne_zero _ p.beta_nonzero
  rw [denominators, ← recover_normalized_common _ _ _ hn hc]
  simpa only [nodes_eq, WeightFormulas.scales, ← pow_mul, answers, target] using
    OriginalTables.macro_recovery G M p r

/-- The collector order agrees exactly with the generated program's answer
consumption order, rather than merely producing the same multiset of answers. -/
theorem answers_order (r : Source G M) :
    (EncodedBatch.queries arity M.label.template M.label.wellFormed rfl (0 : Fin 1) r).map
      (target G) = List.ofFn (answers G M r) := by
  simp only [EncodedBatch.queries, Chains.Compiler.Batch.samples, List.map_map,
    List.ofFn_eq_map, answers, Function.comp_def]
  rfl

/-- The physically generated bytecode, on precisely the oracle batch output,
finishes with the correct numerator/denominator pair. No oracle answer is
inverted, and a zero answer remains in its original position. -/
theorem generated_stack (r : Source G M) :
    ∃ trace,
      run (WeightFormulas.coefficients p.beta p.rho)
        (EncodedBatch.context (s:=s) (b:=1) arity M.label.template p.geometric r)
        ((EncodedBatch.queries arity M.label.template M.label.wellFormed rfl (0 : Fin 1) r).map
          (target G)) =
      some ([commonNumerator (denominators G M p r) (answers G M r),
        commonDenominator (denominators G M p r)],trace) := by
  rw [answers_order]
  exact reference_value p.geometric (occurrences s r.val) p.beta p.rho (answers G M r)

end
end Holant.LocalDrafts.BinaryInterpolation.PostprocessCorrectness
