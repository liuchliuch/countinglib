import Holant.Proofs.Recognition.RuntimeEOLiteralCorrectness
import Holant.Proofs.Recognition.RuntimeTensorAggregation

/-! One all-layout A/P classifier for an actual generated runtime pairing.
The original label, central/completed mode, layer and pairing packet are the
runtime request. The outer EO controller generates this packet internally;
its list-membership proof belongs only to the semantic domain below. Both
literal-template catalogues and both exact combined systems are generated by
the fixed programme. Its flags read the two actual stored root-search outputs.
No successful template index or chosen factorization is claimed as emitted.
Termination and bounds use actual search-dependent clocks, not polynomial
recognition bounds or supplied termination certificates. -/
namespace Holant.LocalDrafts.RemoteWork.TractChainV1.RuntimeEOLiteralDecision
open Turing Computability Holant Holant.Tractable Holant.Algebraic Holant.Complexity
open BinaryCompose FixedFieldMachines
open Holant.LocalDrafts.MainChain.TransformRecognition
open Holant.LocalDrafts.BinaryInterpolation.EffectiveRecognition
open Holant.LocalDrafts.EffectiveAlgebraic
open UniformTensorWitnessBranch (Metadata metadataEncoding)
open PhysicalFolds
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000

structure Data where
  family : RuntimeTensorAggregation.Data
  label : Fin family.count
  complete : Bool
  layer : ℕ
  metadata : Metadata
  generated : metadata∈RuntimeEOPairings.catalogue (RuntimeEOView.arity (family.arity label,complete,layer))

def generated (d : Data) := (RuntimeEOPairings.mem_catalogue _ _).mp d.generated |>.1
def accepted (d : Data) := (RuntimeEOPairings.mem_catalogue _ _).mp d.generated |>.2

def source (d : Data) : RuntimeEOLiteralRequest.Input :=
  RuntimeEOLiteralRequestSource.encode d.family.arity d.family.input d.label d.complete d.layer d.metadata

def body (product : Bool) (d : Data) := RuntimeEOLiteralRequestSource.typedBody d.family.arity d.label
  d.complete d.layer d.metadata (generated d) (accepted d) product

def result (product : Bool) (d : Data) : Option WitnessOutput.Output :=
  RuntimeEOLiteralRequestSource.output d.family.arity d.family.input d.label d.complete d.layer d.metadata
    (generated d) (accepted d) d.family.G d.family.represented product

def restricted (d : Data) := RuntimeEOLiteralCorrectness.restricted d.family.arity d.family.G d.label
  d.complete d.layer d.metadata (generated d) (accepted d)

def pairing (d : Data) : OrientedPerfectPairing (RuntimeEOView.arity (d.family.arity d.label,d.complete,d.layer)) :=
  RuntimeEOPairings.pairing d.metadata (generated d) (accepted d)

theorem restricted_exact (d : Data) : restricted d=(pairing d).restrict
    (RuntimeEOLiteralTable.viewSignature (d.family.G d.label) d.complete d.layer) := rfl

/-- The checked finite metadata list is exactly sufficient for universal
literal-class checks over all oriented perfect pairings. -/
theorem all_pairings_iff {n : ℕ} (f : Signature AlgebraicComplex n) (C : EOClass) :
    (∀m,∀hm : m∈RuntimeEOPairings.catalogue n,
      C.Holds ((RuntimeEOPairings.pairing m ((RuntimeEOPairings.mem_catalogue n m).mp hm).1
        ((RuntimeEOPairings.mem_catalogue n m).mp hm).2).restrict f)) ↔
    ∀p : OrientedPerfectPairing n,C.Holds (p.restrict f) := by
  constructor
  · intro h p
    have hs := h (RuntimeEOPairings.source p) (RuntimeEOPairings.source_catalogue p)
    have he := RuntimeEOPairings.source_roundtrip p
    rw [he] at hs
    exact hs
  · intro h m hm
    exact h _

theorem result_outputs (product : Bool) (d : Data) : ∃ticks,
    Nonempty (TM2OutputsInTime (RuntimeEOLiteralRequest.machine product).computer
      (RuntimeEOLiteralRequest.encoding.encode (source d))
      (some (WitnessOutput.resultEncoding.encode (result product d))) ticks) :=
  RuntimeEOLiteralRequestSource.source_outputs d.family.arity d.family.input d.label d.complete d.layer d.metadata
    (generated d) (accepted d) d.family.G d.family.represented product

def resultRuns (product : Bool) : Runs RuntimeEOLiteralRequest.encoding WitnessOutput.resultEncoding source (result product) where
  machine := RuntimeEOLiteralRequest.machine product
  cost d := Classical.choose (result_outputs product d)
  outputs d := Classical.choice (Classical.choose_spec (result_outputs product d))

theorem result_correct (product : Bool) (d : Data) : (result product d).isSome=true ↔
    if product then Product (restricted d) else Affine (restricted d) :=
  RuntimeEOLiteralCorrectness.output_correct d.family.arity d.family.G d.label d.complete d.layer d.metadata
    (generated d) (accepted d) d.family.input d.family.represented product

abbrev Pair := Option WitnessOutput.Output × Option WitnessOutput.Output
abbrev pairResultEncoding := pairEncoding WitnessOutput.resultEncoding WitnessOutput.resultEncoding
abbrev Details := Metadata × Pair
abbrev detailsEncoding := pairEncoding metadataEncoding pairResultEncoding

def details (d : Data) : Details := (d.metadata,result false d,result true d)
def metadataRuns : Runs RuntimeEOLiteralRequest.encoding metadataEncoding source (fun d => d.metadata) :=
  Runs.ofComputes (Wiring.secondComputes RuntimeEOLiteralRequest.contextEncoding metadataEncoding) source

def detailsRuns : Runs RuntimeEOLiteralRequest.encoding detailsEncoding source details :=
  metadataRuns.pair ((resultRuns false).pair (resultRuns true))

def flags (d : Details) : Bool × Bool := (d.2.1.isSome,d.2.2.isSome)
def flagsComputes : Computes detailsEncoding (pairEncoding encodingBoolBool encodingBoolBool) flags := by
  let ps := Wiring.secondComputes metadataEncoding pairResultEncoding
  exact pairComputes
    ((ps.andThen (Wiring.firstComputes WitnessOutput.resultEncoding WitnessOutput.resultEncoding)).andThen UniformTractXDecision.presence)
    ((ps.andThen (Wiring.secondComputes WitnessOutput.resultEncoding WitnessOutput.resultEncoding)).andThen UniformTractXDecision.presence)

abbrev Output := (Bool × Bool) × Details
abbrev outputEncoding := pairEncoding (pairEncoding encodingBoolBool encodingBoolBool) detailsEncoding

def output (d : Data) : Output := (flags (details d),details d)
def executes : Runs RuntimeEOLiteralRequest.encoding outputEncoding source output :=
  detailsRuns.after (pairComputes flagsComputes (identityComputes detailsEncoding))

theorem affine_correct (d : Data) : (output d).1.1=true ↔ Affine (restricted d) := result_correct false d
theorem product_correct (d : Data) : (output d).1.2=true ↔ Product (restricted d) := result_correct true d

def classFlag (C : EOClass) (o : Output) : Bool := match C with
  | .affine => o.1.1
  | .product => o.1.2

theorem class_correct (C : EOClass) (d : Data) : classFlag C (output d)=true ↔
    C.Holds ((pairing d).restrict (RuntimeEOLiteralTable.viewSignature (d.family.G d.label) d.complete d.layer)) := by
  cases C
  · exact affine_correct d
  · exact product_correct d

theorem metadata_retained (d : Data) : (output d).2.1=d.metadata := rfl
theorem packets_retained (d : Data) : (output d).2.2=(result false d,result true d) := rfl

theorem control : executes.machine=detailsRuns.machine.compose
    (pairComputes flagsComputes (identityComputes detailsEncoding)).machine := rfl

theorem uniform_source : ∃M : BinaryCompose.Machine,∀d : Data,
    Nonempty (TM2OutputsInTime M.computer (RuntimeEOLiteralRequest.encoding.encode (source d))
      (some (outputEncoding.encode (output d))) (executes.cost d)) ∧
    ((output d).1.1=true ↔ Affine (restricted d)) ∧
    ((output d).1.2=true ↔ Product (restricted d)) :=
  ⟨executes.machine,fun d => ⟨⟨executes.outputs d⟩,affine_correct d,product_correct d⟩⟩

theorem returned_candidate (product : Bool) (d : Data) (o : WitnessOutput.Output)
    (ho : result product d=some o) :
    ∃c : OriginalSystemWitness.Candidate (m:=RuntimeEOLiteralRequestSource.Entries d.family.arity+2) (body product d),
      OriginalSystemWitness.candidate (UniformKPolynomial.descriptors d.family.arity d.family.input)
        (UniformKPolynomial.valid d.family.arity d.family.G d.family.input d.family.represented)
        (body product d) (RuntimeEOLiteralRequestSource.bindings d.family.arity product d.metadata.1.length)=some c ∧
      o=WitnessOutput.ofCandidate c ∧ ∃θ : AlgebraicComplex,o.root.Represents (θ : ℂ) ∧
      (∀j,(PowerArithmetic.decode θ (c.1.2.2.2.2 (RuntimeEOLiteralRequestSource.bindings d.family.arity product d.metadata.1.length j)) : ℂ)=
        (UniformKPolynomial.values d.family.arity d.family.G j : ℂ)) ∧
      ∀e∈body product d,SparseEvaluation.evaluate RationalCompiler.field (algebraMap ℚ ℂ)
        (fun j => (PowerArithmetic.decode θ (c.1.2.2.2.2 j) : ℂ)) e=0 := by
  obtain ⟨c,hc,ho,θ,hθ,_,_,hb,he⟩ := WitnessOutput.original_returned_sound
    (UniformKPolynomial.descriptors d.family.arity d.family.input)
    (UniformKPolynomial.valid d.family.arity d.family.G d.family.input d.family.represented)
    (UniformKPolynomial.values d.family.arity d.family.G)
    (UniformKPolynomial.descriptors_represents d.family.arity d.family.G d.family.input d.family.represented)
    (body product d) (RuntimeEOLiteralRequestSource.bindings d.family.arity product d.metadata.1.length) o ho
  exact ⟨c,hc,ho,θ,hθ,hb,he⟩

theorem resources (d : Data) :
    primitiveCost executes.machine (executes.outputs d).steps
      (some (initList executes.machine.computer (RuntimeEOLiteralRequest.encoding.encode (source d)))) ≤
      executes.cost d*executes.machine.primitiveBudget ∧
    ∀k,k≤(executes.outputs d).steps → ∀cfg : executes.machine.Config,
      (fun st => st.bind executes.machine.computer.step)^[k]
        (some (initList executes.machine.computer (RuntimeEOLiteralRequest.encoding.encode (source d))))=some cfg →
      stackSize cfg.stk ≤ (RuntimeEOLiteralRequest.encoding.encode (source d)).length+
        executes.cost d*executes.machine.primitiveBudget := by
  constructor
  · exact (primitiveCost_le _ _ _).trans (Nat.mul_le_mul_right _ (executes.outputs d).steps_le_m)
  · intro k hk cfg hc
    have h := executes.machine.run_size_le
      (initList executes.machine.computer (RuntimeEOLiteralRequest.encoding.encode (source d))) cfg k hc
    rw [Machine.size_init] at h
    exact h.trans (Nat.add_le_add_left (Nat.mul_le_mul_right _ (hk.trans (executes.outputs d).steps_le_m)) _)

end
end Holant.LocalDrafts.RemoteWork.TractChainV1.RuntimeEOLiteralDecision
