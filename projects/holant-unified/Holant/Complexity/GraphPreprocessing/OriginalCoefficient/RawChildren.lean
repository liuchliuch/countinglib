import Holant.Complexity.GraphPreprocessing.OriginalCoefficient.ChildInputWiring
import Holant.Complexity.GraphPreprocessing.OriginalCoefficient.ChildEnumerateGraph
import Holant.Complexity.GraphPreprocessing.OriginalCoefficient.RawParentTableBounds

/-! Original raw network plus one original target vertex to its canonical
increasing child list. Both the edge table and complete original parent table
are generated by actual finite machines inside this execution. -/
namespace Holant.Complexity.GraphPreprocessing.OriginalCoefficient.RawChildren
open Turing Computability BinaryCompose FixedFieldMachines
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option synthInstance.maxSize 4096
set_option Elab.async false
variable {s b : ℕ} {arity : ℕ → ℕ}

abbrev Input := RawRootReach.Input
abbrev inputEncoding := RawRootReach.inputEncoding

def edges (x : {r : RawClosedNetwork // r.WellFormed s b arity}) := ReachRound.graphEdges (x.val.graph x.property)
noncomputable def edgePackageComputes (s b : ℕ) (arity : ℕ → ℕ) :
    Computes (RawClosedNetwork.validatedEncoding s b arity) (pairEncoding UnaryBinary.unaryEncoding EdgeSelect.edgeEncoding)
      (fun x => (x.val.vertices.length,edges x)) :=
  recode (RawEdgeTable.computes s b arity) id (fun _ => rfl) (fun _ => rfl)
noncomputable def edgesComputes (s b : ℕ) (arity : ℕ → ℕ) :
    Computes (RawClosedNetwork.validatedEncoding s b arity) EdgeSelect.edgeEncoding edges :=
  (edgePackageComputes s b arity).andThen (Wiring.secondComputes UnaryBinary.unaryEncoding EdgeSelect.edgeEncoding)

def contextEncoding := pairEncoding EdgeSelect.edgeEncoding ParentRowEncoding.table
def context (x : {r : RawClosedNetwork // r.WellFormed s b arity}) := (edges x,RawParentTable.value x)
noncomputable def contextComputes (s b : ℕ) (arity : ℕ → ℕ) :
    Computes (RawClosedNetwork.validatedEncoding s b arity) contextEncoding context :=
  pairComputes (edgesComputes s b arity) (RawParentTable.computes s b arity)

abbrev edgesMachine : Machine := RawEdgeTable.machine.compose secondMachine
abbrev contextMachine : Machine := pairMachine edgesMachine RawParentTable.machine
abbrev prepareMachine : Machine := (LeftMap.machine contextMachine).compose ChildInputWiring.machine

def prepared (x : Input s b arity) := ChildEnumerate.originalInput (x.1.val.graph x.1.property) x.2
noncomputable def prepareComputes (s b : ℕ) (arity : ℕ → ℕ) :
    Computes (inputEncoding s b arity) ChildEnumerate.inputEncoding prepared :=
  recode ((leftMapComputes Frame.wordEncoding (contextComputes s b arity)).andThen
    (recode ChildInputWiring.computes
      (fun x => ((EdgeSelect.edgeEncoding.encode x.1.1,ParentRowEncoding.table.encode x.1.2),x.2))
      (fun _ => rfl) (fun _ => rfl)))
    (fun x => (x.1,List.replicate x.2.val true)) (fun _ => rfl) (fun _ => rfl)

abbrev machine : Machine := prepareMachine.compose (ChildEnumerate.machine ChildEnumerate.actual)
def value (x : Input s b arity) : List ℕ :=
  (ChildEnumerate.children (x.1.val.graph x.1.property) x.2).map Fin.val
noncomputable def computes (s b : ℕ) (arity : ℕ → ℕ) :
    Computes (inputEncoding s b arity) ChildEnumerate.outputEncoding value :=
  congrComputes ((prepareComputes s b arity).andThen ChildEnumerate.computes)
    (fun x => ChildEnumerate.original_value (x.1.val.graph x.1.property) x.2)
@[simp] theorem computes_machine (s b : ℕ) (arity : ℕ → ℕ) : (computes s b arity).machine=machine := rfl
noncomputable def timePolynomial (s b : ℕ) (arity : ℕ → ℕ) : Polynomial ℕ := (computes s b arity).time
noncomputable def timed (x : Input s b arity) :
    TM2OutputsInTime machine.computer ((inputEncoding s b arity).encode x)
      (some (ChildEnumerate.outputEncoding.encode (value x)))
      ((timePolynomial s b arity).eval ((inputEncoding s b arity).encode x).length) := (computes s b arity).outputs x

theorem inFP : InFP (inputEncoding s b arity) ChildEnumerate.outputEncoding value := (computes s b arity).inFP
noncomputable def originalTimePolynomial (s b : ℕ) (arity : ℕ → ℕ) : Polynomial ℕ :=
  (timePolynomial s b arity).comp (3*(Polynomial.X+1))
noncomputable def timed_original (x : Input s b arity) :
    TM2OutputsInTime machine.computer ((inputEncoding s b arity).encode x)
      (some (ChildEnumerate.outputEncoding.encode (value x)))
      ((originalTimePolynomial s b arity).eval (RawClosedNetwork.encoding.encode x.1.val).length) where
  steps := (timed x).steps
  evals_in_steps := (timed x).evals_in_steps
  steps_le_m := by
    have h := natPolynomial_eval_mono (timePolynomial s b arity) (RawRootReach.input_length_le_original x)
    exact le_trans (timed x).steps_le_m (by simpa [originalTimePolynomial] using h)
noncomputable def primitivePolynomial (s b : ℕ) (arity : ℕ → ℕ) : Polynomial ℕ :=
  originalTimePolynomial s b arity*Polynomial.C machine.primitiveBudget
theorem primitive_bound (x : Input s b arity) :
    primitiveCost machine (timed_original x).steps (some (initList machine.computer ((inputEncoding s b arity).encode x))) ≤
      (primitivePolynomial s b arity).eval (RawClosedNetwork.encoding.encode x.1.val).length := by
  have h := Nat.mul_le_mul_right machine.primitiveBudget (timed_original x).steps_le_m
  simpa only [primitivePolynomial,Polynomial.eval_mul,Polynomial.eval_C] using le_trans (primitiveCost_le _ _ _) h
end Holant.Complexity.GraphPreprocessing.OriginalCoefficient.RawChildren
