import Holant.Complexity.BinaryInterpolation.AlgebraicSource.Macro
import Holant.Algebraic.FiniteFamilyField
import Holant.Complexity.UniversalPairReduction.BinaryFamily
import Holant.Complexity.EdgeSubdivision.WireFamily
import Holant.Complexity.EncodedHolantOutputSize
import Holant.NetworkAlgebra

/-! One faithful number field is generated by the actual finite algebraic
original coefficients, representative, pencil and normalization data. This
construction precedes every raw graph input and supplies no input hint. -/
namespace Holant.Complexity.BinaryInterpolation.AlgebraicSource.CommonField
open Holant.Certificates.MatchingContractionClosure
open Holant.Algebraic
open Holant.Complexity.UniversalPairReduction
noncomputable section
set_option backward.isDefEq.respectTransparency false
variable {s : ℕ} {arity : ℕ → ℕ}
variable (G : (i : Fin s) → Signature ℂ (arity i.val))
variable (halg : ∀i x, IsAlgebraic ℚ (G i x))
variable (D : Binary (K:=ℂ)) (hD : EntriesAlgebraic D) (p : Pencil D)

abbrev Index (s : ℕ) (arity : ℕ → ℕ) :=
  (Σ i : Fin s, (Fin (arity i.val) → Bool)) ⊕ ((Fin 3 × Bool × Bool) ⊕ Bool)

def coefficient : Index s arity → ℂ
  | .inl ⟨i,x⟩ => G i x
  | .inr (.inl (k,a,b)) => if k=0 then D a b else if k=1 then p.H a b else p.L a b
  | .inr (.inr q) => if q then p.beta else p.rho

include halg hD in
 theorem coefficient_algebraic : ∀i, IsAlgebraic ℚ (coefficient G D p i) := by
  intro i
  rcases i with ⟨i,x⟩ | (⟨k,a,b⟩ | q)
  · exact halg i x
  · change IsAlgebraic ℚ (if k=0 then D a b else if k=1 then p.H a b else p.L a b)
    split_ifs
    · exact hD a b
    · exact p.H_algebraic a b
    · exact p.L_algebraic a b
  · cases q
    · exact p.rho_algebraic
    · exact p.beta_algebraic

abbrev field := familyField (coefficient G D p)
abbrev presentation := familyPresentation (coefficient G D p) (coefficient_algebraic G halg D hD p)

include halg hD in
 theorem finiteDimensional : FiniteDimensional ℚ (field G D p) :=
  familyField_finiteDimensional (coefficient G D p) (coefficient_algebraic G halg D hD p)

abbrev original (i : Fin s) (x : Fin (arity i.val) → Bool) : field G D p :=
  fieldCoefficient (coefficient G D p) (.inl ⟨i,x⟩)

def representative : Binary (K:=field G D p) :=
  fun a b => fieldCoefficient (coefficient G D p) (.inr (.inl (0,a,b)))

def right : Binary (K:=field G D p) :=
  fun a b => fieldCoefficient (coefficient G D p) (.inr (.inl (1,a,b)))

def left : Binary (K:=field G D p) :=
  fun a b => fieldCoefficient (coefficient G D p) (.inr (.inl (2,a,b)))

def beta : field G D p := fieldCoefficient (coefficient G D p) (.inr (.inr true))
def rho : field G D p := fieldCoefficient (coefficient G D p) (.inr (.inr false))
def node (t : ℕ) : field G D p := if p.geometric then (rho G D p)^t else (t:field G D p)

@[simp] theorem original_exact (i : Fin s) (x : Fin (arity i.val) → Bool) :
    (original G D p i x : ℂ) = G i x := rfl
@[simp] theorem representative_exact (a b : Bool) : (representative G D p a b : ℂ)=D a b := by
  simp [representative,fieldCoefficient,coefficient]
@[simp] theorem right_exact (a b : Bool) : (right G D p a b : ℂ)=p.H a b := by
  simp [right,fieldCoefficient,coefficient]
@[simp] theorem left_exact (a b : Bool) : (left G D p a b : ℂ)=p.L a b := by
  simp [left,fieldCoefficient,coefficient]
@[simp] theorem beta_exact : (beta G D p : ℂ)=p.beta := rfl
@[simp] theorem rho_exact : (rho G D p : ℂ)=p.rho := rfl
@[simp] theorem node_exact (t : ℕ) : (node G D p t : ℂ)=p.node t := by
  unfold node Pencil.node
  split_ifs <;> simp

 theorem beta_nonzero : beta G D p≠0 := by
  intro h
  exact p.beta_nonzero (congrArg Subtype.val h)

 theorem rho_nonzero : rho G D p≠0 := by
  intro h
  exact p.rho_nonzero (congrArg Subtype.val h)

 theorem right_nonzero : right G D p≠0 := by
  intro h
  apply p.H_nonzero
  ext a b
  have hh := congrArg (fun M : Binary (K:=field G D p) => (M a b : ℂ)) h
  simpa using hh

 theorem positive_nodes_injective (m : ℕ) :
    Function.Injective (fun i : Fin (m+1) => node G D p (i.val+1)) := by
  intro i j h
  apply p.positive_nodes_injective m
  have hh := congrArg (fun z : field G D p => (z : ℂ)) h
  simpa using hh

 theorem normalization_nonzero (t m : ℕ) : (beta G D p)^(t*m)≠0 :=
  pow_ne_zero _ (beta_nonzero G D p)

/-- Both functions use precisely the original validated raw graph codecs. -/
def targetValue (r : ExactSignatureTables.Input s 1 arity) : field G D p :=
  (r.val.realize r.property (original G D p)
    (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0

def sourceValue (r : ExactSignatureTables.Input (s+1) 1 (extendedArity s arity)) : field G D p :=
  (r.val.realize r.property (BinaryFamily.signatures (original G D p) (right G D p))
    (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0

 theorem target_value_exact (r : ExactSignatureTables.Input s 1 arity) :
    (targetValue G D p r : ℂ) =
      (r.val.realize r.property G (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0 := by
  change (field G D p).subtype _ = _
  dsimp only [targetValue, sourceValue]
  rw [←Network.denote_map (field G D p).subtype]
  congr 1
  unfold Network.map RawClosedNetwork.realize
  congr 1
  funext e a b
  cases a <;> cases b <;> rfl

 theorem source_value_exact (r : ExactSignatureTables.Input (s+1) 1 (extendedArity s arity)) :
    (sourceValue G D p r : ℂ) =
      (r.val.realize r.property (BinaryFamily.signatures G p.H)
        (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0 := by
  change (field G D p).subtype _ = _
  dsimp only [targetValue, sourceValue]
  rw [←Network.denote_map (field G D p).subtype]
  congr 1
  unfold Network.map RawClosedNetwork.realize
  congr 1
  · funext v x
    dsimp only
    unfold BinaryFamily.signatures
    split_ifs
    · rfl
    · exact right_exact G D p _ _
  · funext e a b
    cases a <;> cases b <;> rfl

 theorem source_family_exact :
    Set.range (fun i : Fin (s+1) => (⟨extendedArity s arity i.val,
      BinaryFamily.signatures G p.H i⟩ : AnySignature ℂ)) =
      Set.range (fun i : Fin s => (⟨arity i.val,G i⟩ : AnySignature ℂ)) ∪
        {(⟨2,Chains.binarySignature p.H⟩ : AnySignature ℂ)} :=
  EdgeSubdivision.extended_family G p.H

 theorem source_input_exact (r : ExactSignatureTables.Input (s+1) 1 (extendedArity s arity)) :
    (RawClosedNetwork.validatedEncoding (s+1) 1 (extendedArity s arity)).encode r =
      RawClosedNetwork.encoding.encode r.val := rfl

 theorem target_input_exact (r : ExactSignatureTables.Input s 1 arity) :
    (RawClosedNetwork.validatedEncoding s 1 arity).encode r =
      RawClosedNetwork.encoding.encode r.val := rfl

/-- This applies to every actual compiled original-family query, without changing
its labels, shape, orientation, self-loops, or parallel edges. -/
 theorem query_value_exact {A : Type*} (query : A → ExactSignatureTables.Input s 1 arity) (x : A) :
    (targetValue G D p (query x) : ℂ) =
      ((query x).val.realize (query x).property G
        (fun _ : Fin 1 => Signature.disequality)).denote Fin.elim0 :=
  target_value_exact G D p (query x)

end
end Holant.Complexity.BinaryInterpolation.AlgebraicSource.CommonField
