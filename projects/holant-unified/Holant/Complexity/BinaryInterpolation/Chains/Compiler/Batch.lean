import Holant.Complexity.BinaryInterpolation.Chains.Compiler.BoundedQueries

/-! Actual preprocessing of all m+1 positive chain queries from the original
graph. The input supplies no query list, occurrence certificate, or expansion.
Original label scanning, a unary successor, the checked range loop and the
checked contextual mapper physically emit every query and its list framing.
-/
namespace Holant.Complexity.BinaryInterpolation.Chains.Compiler.Batch
open Turing Computability BinaryCompose FixedFieldMachines GraphPreprocessing
open GraphPreprocessing.OriginalCoefficient FixedGadgetSubstitution RawClosedNetwork
open Holant.OneHot.StackProgram.GraphLabelEncoding
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option synthInstance.maxSize 4096
set_option Elab.async false

variable (s b : ℕ) (arity : ℕ → ℕ) (distinguished : ℕ)

def sampleListEncoding := ContextFlatMap.inputEncoding (validatedEncoding s b arity)
  (fun r => OccurrenceLabel.unaryPortEncoding (occurrences distinguished r.val + 1))

noncomputable def sampleListComputes : Computes (validatedEncoding s b arity)
    (sampleListEncoding s b arity distinguished)
    (fun r => ⟨r,List.finRange (occurrences distinguished r.val + 1)⟩) :=
  recode (pairComputes (identityComputes (validatedEncoding s b arity))
    (((FixedGadgetSubstitution.Compiler.occurrencesComputes s b arity distinguished).andThen
      Chains.Compiler.successorComputes).andThen ComponentSelection.UnaryRange.computes))
    id (fun _ => rfl) (fun r => by
      change Holant.Algebraic.frame _ ++ framedListEncode UnaryBinary.unaryEncoding (List.range _) = _
      rw [←FixedGadgetSubstitution.Compiler.finRange_values,
        FixedGadgetSubstitution.Compiler.finListEncoding]
      rfl)

variable {γ : Type} (equery : Encoding γ Bool)
variable (query : BoundedQueries.Input s b arity distinguished → γ)
variable (w : Computes (BoundedQueries.inputEncoding s b arity distinguished) equery query)

def samples (r : FixedGadgetSubstitution.Compiler.Input s b arity) : List γ :=
  (List.finRange (occurrences distinguished r.val + 1)).map (fun k => query ⟨r,k⟩)

/-- Exactly m+1 actual output queries, with k=0,...,m and hence t=1,...,m+1. -/
@[simp] theorem samples_length (r : FixedGadgetSubstitution.Compiler.Input s b arity) :
    (samples s b arity distinguished query r).length = occurrences distinguished r.val + 1 := by
  simp [samples]

noncomputable def samplesComputes : Computes (validatedEncoding s b arity)
    (framedListEncoding equery) (samples s b arity distinguished query) := by
  let provider := w.andThen (FixedGadgetSubstitution.Compiler.entryComputes equery)
  let run := (sampleListComputes s b arity distinguished).andThen
    (ContextFlatMap.computes (validatedEncoding s b arity)
      (fun r => OccurrenceLabel.unaryPortEncoding (occurrences distinguished r.val + 1))
      (fun x => FixedGadgetSubstitution.Compiler.entry equery (query x)) provider)
  refine recode (FixedGadgetSubstitution.Compiler.joinComputes run
    (constantComputes (validatedEncoding s b arity) Frame.wordEncoding [false])) id (fun _ => rfl) ?_
  intro r
  have h := FixedGadgetSubstitution.Compiler.entries_append_encode equery
    (samples s b arity distinguished query r) []
  simpa only [samples,FixedGadgetSubstitution.Compiler.entries,List.flatMap_map,
    Function.comp_def,List.append_nil,framedListEncode,framedListEncoding,Frame.wordEncoding,id_eq,
    ContextFlatMap.value] using h

/-- Preserve any already computed postprocessing context in the oracle-batch
input format. Both the query list and context are generated by actual programs. -/
noncomputable def withContextComputes {ε : Type} (econtext : Encoding ε Bool)
    (context : FixedGadgetSubstitution.Compiler.Input s b arity → ε)
    (wc : Computes (validatedEncoding s b arity) econtext context) :
    Computes (validatedEncoding s b arity) (pairEncoding (framedListEncoding equery) econtext)
      (fun r => (samples s b arity distinguished query r,context r)) :=
  pairComputes (samplesComputes s b arity distinguished equery query w) wc

theorem primitive_bound (r : FixedGadgetSubstitution.Compiler.Input s b arity) :
    primitiveCost (samplesComputes s b arity distinguished equery query w).machine
      ((samplesComputes s b arity distinguished equery query w).outputs r).steps
      (some (initList (samplesComputes s b arity distinguished equery query w).machine.computer
        ((validatedEncoding s b arity).encode r))) ≤
      (primitivePolynomial (samplesComputes s b arity distinguished equery query w)).eval
        ((validatedEncoding s b arity).encode r).length :=
  computes_primitive_cost (samplesComputes s b arity distinguished equery query w) r

end Holant.Complexity.BinaryInterpolation.Chains.Compiler.Batch
