def printedEndpoint (j : Fin 48) : Signature Scalar 4 := tensorFrom (printedEndpointValues j)
def endpointScale (j : Fin 48) : Scalar := endpointOutput j (fun _ => false)
theorem printed_endpoints_exact : ∀ j : Fin 48, ¬outsideRow j → endpointOutput j=tensorScale (endpointScale j) (printedEndpoint j) := by
  intro j
  fin_cases j <;> decide +kernel
theorem endpointScale_nonzero (j : Fin 48) (h : ¬outsideRow j) : endpointScale j ≠ 0 := (endpoint_coefficients j h).2.1
end Holant.Certificates.OctahedralSeparator
