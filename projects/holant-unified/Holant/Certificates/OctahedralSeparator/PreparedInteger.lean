  intro f
  fin_cases f <;> decide +kernel
theorem baseInteger_eval : ∀ r : Fin 15, ∀ x : Word, IntegerCoefficient.eval (baseInteger r x)=(4 : Scalar)*cachedBase r x := by
  intro r
