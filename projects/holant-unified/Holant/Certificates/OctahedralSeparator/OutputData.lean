def outsideRow (j : Fin 48) : Prop := 2≤(rowForm j).val ∧ 3≤(rowBase j).val
instance (j : Fin 48) : Decidable (outsideRow j) := by unfold outsideRow; infer_instance
def equalityRow (j : Fin 48) : Prop := j=34
instance (j : Fin 48) : Decidable (equalityRow j) := by unfold equalityRow; infer_instance
def endpointRow (j : Fin 48) : Prop := ¬ outsideRow j ∧ ¬ equalityRow j
instance (j : Fin 48) : Decidable (endpointRow j) := by unfold endpointRow; infer_instance
