def endpointLegs (j : Fin 48) (a : Fin 4) : Mat :=
  if j=34 ∧ 2≤a.val then flip else theta (rowForm j) (standard (dressIndices j a))
def finalLegs (j : Fin 48) (a : Fin 4) : Mat :=
  if (rowForm j).val<2 then endpointLegs j a else mm (endpointLegs j a) (corrections (rowForm j) a)
