def orbitDigit (r : Fin 612) (j : Fin 21) : Fin 5 := finFunctionFinEquiv.symm (boundedOrbitKey r) j
def invariantPalette : Fin 5 → Coeff := ![zero,one,⟨0,0,1,0⟩,⟨-1,0,0,0⟩,⟨0,0,-1,0⟩]
