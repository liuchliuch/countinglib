def referenceInteger (r : Fin 612) : Fin 16 → Coeff := fastIntegerInput (referenceInput r).1 (referenceInput r).2.val

def orbitRowCheck (r : Fin 612) : Bool :=
  let g := referenceInteger r
  (List.finRange 21).all fun j => decide (
    IntegerCoefficient.mul (invariantPalette (orbitDigit r j)) (g 15) =
      IntegerCoefficient.mul (g (centralCode (invariantPair j).val.1))
        (g (centralCode (invariantPair j).val.2)))

