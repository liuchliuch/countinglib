import Holant.Certificates.RainbowOrbit.GammaOrbit
import Holant.Certificates.RainbowOrbit.MarkedPermutations

/-! Full source A.18 (paper1.tex 17423–17575).  Counts are cardinalities of
actual projective deck points and unordered maximal three-point lines.  Γ is
the subgroup of the finite actual deck permutation group generated by the
literal single-leg fixed representatives and adjacent port swaps.  Analytic
coefficient maps are used only in proved correspondences; every normalization
witness has an ordinary native-X network and explicit nonzero scalar. -/
namespace Holant.Certificates.RainbowOrbit
open Holant Holant.Certificates.MatchingProductBridge
open OctahedralSeparator
noncomputable section
set_option backward.isDefEq.respectTransparency false

theorem physicalX_square : physicalX*physicalX=(1 : BinaryMatrix) := by
  ext a b
  cases a <;> cases b <;> simp [physicalX,Signature.disequality,Matrix.mul_apply,Matrix.one_apply]

theorem MatrixFamily.transfer_iff {G : BinaryMatrix→Prop} (hG : MatrixFamily G) (hX : G physicalX)
    (U : BinaryMatrix) : G (U*physicalX) ↔ G U := by
  constructor
  · intro h
    have hh := hG.mul h hX
    simpa only [mul_assoc,physicalX_square,mul_one] using hh
  · exact fun h => hG.mul h hX

theorem standard_source_transfer_iff (g : PlatonicModel) (U : BinaryMatrix) :
    groupDirection g (U*physicalX) ↔ groupDirection g U := by
  apply (standardMatrixFamily g).transfer_iff
  have hh := groupDirection_right_X g (direction_one g)
  have he : multiply (1 : BinaryMatrix) X=physicalX := by
    funext a b
    cases a <;> cases b <;> simp [multiply,physicalX,X,Matrix.one_apply,Signature.disequality]
  rw [he] at hh
  exact hh

theorem marked_source_transfer_iff (f : Form) (U : BinaryMatrix) :
    Direction f (U*physicalX) ↔ Direction f U :=
  (markedMatrixFamily f).transfer_iff (direction_X f) U

theorem external_source_transfer_iff (U : BinaryMatrix) :
    External.Direction (U*physicalX) ↔ External.Direction U :=
  External.matrixFamily.transfer_iff External.direction_X U


/-- Literal binary resources and their native-X transfers stay in the actual
current family. This discharges resource availability for every generator. -/
theorem standard_physical_source_mem (g : PlatonicModel) (i : Fin (size g)) :
    groupDirection g (physicalSource (representative g i)) ∧
    groupDirection g (physicalSource (representative g i)*physicalX) := by
  have hX : groupDirection g physicalX := by
    have hh := (standard_source_transfer_iff g (1 : BinaryMatrix)).mpr (direction_one g)
    simpa only [one_mul] using hh
  have hB : groupDirection g (physicalSource (representative g i)) :=
    RainbowOrbit.groupDirection_mul g hX (direction_transpose g (representative_mem g i))
  exact ⟨hB,(standard_source_transfer_iff g _).mpr hB⟩

theorem marked_physical_source_mem (f : Form) (i : Fin 24) :
    Direction f (physicalSource (markedRepresentative f i)) ∧
    Direction f (physicalSource (markedRepresentative f i)*physicalX) := by
  have hB : Direction f (physicalSource (markedRepresentative f i)) :=
    Direction.mul (direction_X f) (marked_direction_transpose f (Direction.standard f i))
  exact ⟨hB,(marked_source_transfer_iff f _).mpr hB⟩

theorem external_physical_source_mem (i : Fin 12) :
    External.Direction (physicalSource (External.representative i)) ∧
    External.Direction (physicalSource (External.representative i)*physicalX) := by
  have hB : External.Direction (physicalSource (External.representative i)) :=
    External.Direction.mul External.direction_X (External.Direction.transpose (External.Direction.representative i))
  exact ⟨hB,(external_source_transfer_iff _).mpr hB⟩

/-- The table's first, second and fourth rows: actual deck, all unordered
rainbow three-lines, and the orbit of the displayed initial line. -/
theorem standard_table :
    (deck .tetrahedral).card=432 ∧
    {S : Finset Point | RainbowLine .tetrahedral S}.ncard=1728 ∧
    {S : Finset Point | GammaOrbit (deck .tetrahedral) (standardOperationPermutation .tetrahedral) baseLine S}.ncard=1728 ∧
    (deck .octahedral).card=1728 ∧
    {S : Finset Point | RainbowLine .octahedral S}.ncard=13824 ∧
    {S : Finset Point | GammaOrbit (deck .octahedral) (standardOperationPermutation .octahedral) baseLine S}.ncard=13824 ∧
    (deck .icosahedral).card=10800 ∧
    {S : Finset Point | RainbowLine .icosahedral S}.ncard=216000 ∧
    {S : Finset Point | GammaOrbit (deck .icosahedral) (standardOperationPermutation .icosahedral) baseLine S}.ncard=216000 := by
  simp [deck_card,all_rainbow_lines_card,standard_gamma_orbit_card,size]

/-- The displayed O' row and both mixed dt/td rows. This includes f=0 as an
independent consistency check of the first octahedral coordinates. -/
theorem marked_table (f : Form) :
    (markedDeck f).card=1728 ∧
    {S : Finset Point | MarkedRainbowLine f S}.ncard=13824 ∧
    {S : Finset Point | GammaOrbit (markedDeck f) (markedOperationPermutation f) (markedBaseLine f) S}.ncard=13824 :=
  ⟨markedDeck_card f,marked_all_lines_card f,marked_gamma_orbit_card f⟩


def primeDisplayedLine : Finset Point :=
  points (fun r => Projectivization.mk ℂ (primeInitial r) (primeInitial_nonzero r))

theorem primeDisplayedLine_eq : primeDisplayedLine=markedBaseLine 1 := by
  unfold primeDisplayedLine markedBaseLine
  congr 1
  funext r
  exact (prime_initial_projective r).symm

/-- The O' orbit starts at the manuscript's literal displayed line, with the
checked signs removed only projectively. -/
theorem prime_displayed_orbit_iff (S : Finset Point) :
    GammaOrbit (markedDeck 1) (markedOperationPermutation 1) primeDisplayedLine S ↔
      MarkedRainbowLine 1 S := by
  rw [primeDisplayedLine_eq]
  exact marked_gamma_orbit_iff 1 S

theorem prime_displayed_orbit_card :
    {S : Finset Point | GammaOrbit (markedDeck 1) (markedOperationPermutation 1) primeDisplayedLine S}.ncard=13824 := by
  rw [primeDisplayedLine_eq]
  exact marked_gamma_orbit_card 1

def ExternalRainbowLine (S : Finset Point) : Prop :=
  ∃p : Fin 3→Point,External.Rainbow p ∧ S=points p

def ExternalRainbowOrbit (S : Finset Point) : Prop :=
  ∃S₀ : Finset Point,ExternalRainbowLine S₀ ∧ GammaOrbit External.deck externalOperationPermutation S₀ S

theorem external_table : External.deck.card=432 ∧
    {S : Finset Point | ExternalRainbowLine S}.ncard=0 ∧
    {S : Finset Point | ExternalRainbowOrbit S}.ncard=0 := by
  refine ⟨External.deck_card,?_,?_⟩
  · have he : {S : Finset Point | ExternalRainbowLine S}=∅ := by
      ext S
      simp only [Set.mem_setOf_eq,Set.mem_empty_iff_false,iff_false]
      rintro ⟨p,hp,_⟩
      exact External.no_rainbow p hp
    rw [he,Set.ncard_empty]
  · have he : {S : Finset Point | ExternalRainbowOrbit S}=∅ := by
      ext S
      simp only [Set.mem_setOf_eq,Set.mem_empty_iff_false,iff_false]
      rintro ⟨S₀,⟨p,hp,_⟩,_⟩
      exact External.no_rainbow p hp
    rw [he,Set.ncard_empty]

theorem standard_line_maximal (g : PlatonicModel) {S : Finset Point} (hS : RainbowLine g S)
    (p : Point) (hp : p∈deck g) (hcol : Projectivization.IsCollinear (insert p (S : Set Point))) : p∈S :=
  FamilyRainbowLine.maximal (fun {U} h => groupDirection_det_ne_zero g h) hS p
    ((standard_deck_semantics g p).mpr hp) hcol

theorem marked_line_maximal (f : Form) {S : Finset Point} (hS : MarkedRainbowLine f S)
    (p : Point) (hp : p∈markedDeck f) (hcol : Projectivization.IsCollinear (insert p (S : Set Point))) : p∈S :=
  FamilyRainbowLine.maximal (fun {U} h => Direction.det_ne_zero h) hS p
    ((markedDeck_iff_mem f p).mpr hp) hcol

/-- Complete source transitivity includes both directions of the equality with
the genuine finite permutation-group orbit, in every stated nonempty form. -/
theorem actual_rainbow_line_orbit_certificate :
    (∀g : PlatonicModel,∀S : Finset Point,
      GammaOrbit (deck g) (standardOperationPermutation g) baseLine S ↔ RainbowLine g S) ∧
    (∀f : Form,∀S : Finset Point,
      GammaOrbit (markedDeck f) (markedOperationPermutation f) (markedBaseLine f) S ↔ MarkedRainbowLine f S) ∧
    (∀p : Fin 3→Point,¬External.Rainbow p) :=
  ⟨standard_gamma_orbit_iff,marked_gamma_orbit_iff,External.no_rainbow⟩

/-- Every actual normalization uses precisely four fixed physical binary
representatives and keeps all four ordered boundary ports. -/
theorem actual_standard_normalization (g : PlatonicModel) (p : Fin 3→Point) (hp : Rainbow g p) :
    ∃k : Fin 4→Fin (size g),∃lam : Fin 3→ℂ,(∀r,lam r≠0) ∧
      ∀r,(physicalNetwork (p r).rep (representativeLegs g k)).denote=lam r • base r :=
  rainbow_physical_normalization g p hp

theorem actual_marked_normalization (f : Form) (p : Fin 3→Point) (hp : MarkedRainbow f p) :
    ∃k : Fin 4→Fin 24,∃lam : Fin 3→ℂ,(∀r,lam r≠0) ∧
      ∀r,(physicalNetwork (p r).rep (markedRepresentativeLegs f k)).denote=lam r • markedInitial f r :=
  marked_rainbow_physical_normalization f p hp

end
end Holant.Certificates.RainbowOrbit
