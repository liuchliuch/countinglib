theorem candidateTable_correct : ∀ i : Fin 18, ∀ w : Fin 16,
    candidateTable i w = candidateCode i (TetrahedralDeck.words w) := by decide +kernel

def ordered (i : Fin 36) (j : Fin 3) : Fin 18 :=
  Fin.addCases (fun k : Fin 6 => (permutation k j).castAdd 15)
    (fun k : Fin 30 => (ordering k j).natAdd 3) i

def GoodTriple (t : Fin 3 → Fin 18) : Prop := ∀ w : Fin 16,
  gadd (gadd (candidateTable (t 0) w) (candidateTable (t 1) w)) (candidateTable (t 2) w) =
    gadd (candidateTable 1 w) (candidateTable 2 w)
instance (t : Fin 3 → Fin 18) : Decidable (GoodTriple t) := by unfold GoodTriple; infer_instance

theorem ordered_injective : Function.Injective ordered := by decide +kernel

theorem ordered_valid : ∀ i : Fin 36, GoodTriple (ordered i) := by decide +kernel

