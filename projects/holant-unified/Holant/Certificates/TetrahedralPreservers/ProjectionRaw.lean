def pairWitness (i j : Fin 12) : Fin 4 → Fin 12 := pairWitnessTable i j
def tripleRelation (i j k : Fin 12) : Fin 3 → ℤ := tripleRelationTable i j k
def tripleNormal (i j k : Fin 12) : ZV := tripleNormalTable i j k
def tripleWitness (i j k : Fin 12) : Fin 7 → Fin 12 := tripleWitnessTable i j k

def projectedCross (i j r s : Fin 12) : ℤ :=
  zPair (zstandard i) (zstandard r)*zPair (zstandard j) (zstandard s)-
    zPair (zstandard i) (zstandard s)*zPair (zstandard j) (zstandard r)

def tripleCertificate (i j k : Fin 12) : Prop :=
  ((∃ a : Fin 3, tripleRelation i j k a ≠ 0) ∧
    (tripleRelation i j k 0) • zstandard i + (tripleRelation i j k 1) • zstandard j +
      (tripleRelation i j k 2) • zstandard k = 0) ∨
  (zDot (tripleNormal i j k) (zstandard i)=0 ∧
   zDot (tripleNormal i j k) (zstandard j)=0 ∧
   zDot (tripleNormal i j k) (zstandard k)=0 ∧
   ((Finset.univ : Finset (Fin 12)).filter (fun r => zDot (tripleNormal i j k) (zstandard r)=0)).card ≤ 6 ∧
   ∀ a b : Fin 7, a ≠ b →
     projectedCross i j (tripleWitness i j k a) (tripleWitness i j k b) ≠ 0 ∨
     projectedCross i k (tripleWitness i j k a) (tripleWitness i j k b) ≠ 0 ∨
     projectedCross j k (tripleWitness i j k a) (tripleWitness i j k b) ≠ 0)

instance (i j k : Fin 12) : Decidable (tripleCertificate i j k) := by
  unfold tripleCertificate
  infer_instance

theorem pairProjection_certificate : ∀ i j : Fin 12, i ≠ j → ∀ a b : Fin 4, a ≠ b →
    projectedCross i j (pairWitness i j a) (pairWitness i j b) ≠ 0 := by
  intro i
  fin_cases i <;> decide +kernel

theorem tripleProjection_certificate : ∀ i j k : Fin 12, tripleCertificate i j k := by
  intro i
  fin_cases i <;> decide +kernel

end Holant.Certificates.TetrahedralPreservers
