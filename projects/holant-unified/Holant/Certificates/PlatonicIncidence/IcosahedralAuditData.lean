def IcosahedralEntry (t : Fin 722) : Prop :=
  icosahedralTranslation (icosahedralWitness t).1 (icosahedralWitness t).2=t ∧
  (icosahedralSecants t).card=icosahedralCard t ∧
  (if h : t.val+1<722 then lineCode (icosahedralSecants t)<
    lineCode (icosahedralSecants ⟨t.val+1,h⟩) else True)

instance (t : Fin 722) : Decidable (IcosahedralEntry t) := by
  unfold IcosahedralEntry
  infer_instance

