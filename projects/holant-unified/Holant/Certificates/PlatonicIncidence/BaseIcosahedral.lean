theorem icosahedral_anchors : ∀ b : Fin 31,
    baseAnchor .icosahedral b≠identityIndex .icosahedral ∧
    baseLineOf .icosahedral (baseAnchor .icosahedral b)=b ∧
    identityIndex .icosahedral∈baseLine .icosahedral b ∧
    baseAnchor .icosahedral b∈baseLine .icosahedral b := by
  change ∀ b : Fin 31, icosahedralAnchor b≠(0 : Fin 60) ∧
    icosahedralLineOf (icosahedralAnchor b)=b ∧
    (0 : Fin 60)∈icosahedralLines b ∧ icosahedralAnchor b∈icosahedralLines b
  decide +kernel

