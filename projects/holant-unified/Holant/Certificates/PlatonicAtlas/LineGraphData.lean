def richCount : PlatonicModel → ℕ
  | .tetrahedral => 16
  | .octahedral => 50
  | .icosahedral => 272

def richIndex : (g : PlatonicModel) → Fin (richCount g) → Fin (secantCount g)
  | .tetrahedral => tetrahedralRichIndex
  | .octahedral => octahedralRichIndex
  | .icosahedral => icosahedralRichIndex

def richSet : (g : PlatonicModel) → Fin (richCount g) → Finset (Fin (size g))
  | .tetrahedral => tetrahedralRichSet
  | .octahedral => octahedralRichSet
  | .icosahedral => icosahedralRichSet

def richNeighbors : (g : PlatonicModel) → Fin (richCount g) → Finset (Fin (richCount g))
  | .tetrahedral => tetrahedralRichNeighbors
  | .octahedral => octahedralRichNeighbors
  | .icosahedral => icosahedralRichNeighbors

def richParent : (g : PlatonicModel) → Fin (richCount g) → Fin (richCount g)
  | .tetrahedral => tetrahedralRichParent
  | .octahedral => octahedralRichParent
  | .icosahedral => icosahedralRichParent

def richDepth : (g : PlatonicModel) → Fin (richCount g) → ℕ
  | .tetrahedral => tetrahedralRichDepth
  | .octahedral => octahedralRichDepth
  | .icosahedral => icosahedralRichDepth

def richLookup : (g : PlatonicModel) → Fin (secantCount g) → Fin (richCount g)
  | .tetrahedral => tetrahedralRichLookup
  | .octahedral => octahedralRichLookup
  | .icosahedral => icosahedralRichLookup

def richDegree : (g : PlatonicModel) → Fin (richCount g) → ℕ
  | .tetrahedral => tetrahedralRichDegree
  | .octahedral => octahedralRichDegree
  | .icosahedral => icosahedralRichDegree

def richRoot (g : PlatonicModel) : Fin (richCount g) := ⟨0,by cases g <;> decide⟩

def RichEntry (g : PlatonicModel) (i : Fin (richCount g)) : Prop :=
  richSet g i=globalLine g (richIndex g i) ∧ 3≤(richSet g i).card ∧
  (∀j : Fin (richCount g),j∈richNeighbors g i ↔ i≠j ∧ (richSet g i∩richSet g j).Nonempty) ∧
  (richNeighbors g i).card=richDegree g i ∧
  (i=richRoot g ∨ richParent g i∈richNeighbors g i ∧ richDepth g (richParent g i)<richDepth g i)

instance (g : PlatonicModel) (i : Fin (richCount g)) : Decidable (RichEntry g i) := by
  unfold RichEntry
  infer_instance

def RichCoverage (g : PlatonicModel) (t : Fin (secantCount g)) : Prop :=
  3≤(globalLine g t).card → richIndex g (richLookup g t)=t

instance (g : PlatonicModel) (t : Fin (secantCount g)) : Decidable (RichCoverage g t) := by
  unfold RichCoverage
  infer_instance

end Holant.Certificates.PlatonicAtlas
