import Holant.Algebraic.FixedField
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.LinearAlgebra.Dimension.Free

/-!
# A common fixed coefficient field for a finite algebraic family

Algebraicity of the actual finite coefficient family proves the existence of a
finite rational basis and exact rational unit/multiplication tables. No such
presentation is assumed as an extra hypothesis. This is a fixed-family existence
construction, used before graph input is supplied; it makes no claim of a uniform
algorithm for finding bases from varying algebraic input encodings.
-/

namespace Holant.Algebraic

namespace FixedField

variable (K : Type*) [Field K] [Algebra ℚ K]

/-- Every finite-dimensional rational field has exact rational structure tables.
The chosen basis is fixed once, outside the instance input and its machine run. -/
noncomputable def ofFiniteDimensional [FiniteDimensional ℚ K] :
    FixedField K (Module.finrank ℚ K) where
  basis := Module.finBasis ℚ K
  unitCode := (Module.finBasis ℚ K).equivFun 1
  mulTable i j := (Module.finBasis ℚ K).equivFun
    ((Module.finBasis ℚ K) i * (Module.finBasis ℚ K) j)
  unit_spec := (Module.finBasis ℚ K).equivFun.symm_apply_apply 1
  mul_spec _ _ := (Module.finBasis ℚ K).equivFun.symm_apply_apply _

@[simp] theorem ofFiniteDimensional_decode_coordinates [FiniteDimensional ℚ K] (x : K) :
    (ofFiniteDimensional K).decode ((Module.finBasis ℚ K).equivFun x) = x :=
  (Module.finBasis ℚ K).equivFun.symm_apply_apply x

end FixedField

variable {A L : Type*} [Finite A] [Field L] [Algebra ℚ L]

/-- The actual subfield generated by all original coefficients, including any
recorded fixed scalar factors present in that family. -/
noncomputable def familyField (coeff : A → L) : IntermediateField ℚ L :=
  IntermediateField.adjoin ℚ (Set.range coeff)

omit [Finite A] in
/-- Every coefficient lies in the same field, rather than a per-instance field. -/
theorem coefficient_mem_familyField (coeff : A → L) (a : A) :
    coeff a ∈ familyField coeff :=
  IntermediateField.subset_adjoin ℚ (Set.range coeff) ⟨a, rfl⟩

/-- Finiteness and algebraicity give the required finite extension. -/
theorem familyField_finiteDimensional (coeff : A → L)
    (halg : ∀ a, IsAlgebraic ℚ (coeff a)) : FiniteDimensional ℚ (familyField coeff) := by
  letI : Fintype (Set.range coeff) := (Set.finite_range coeff).fintype
  apply IntermediateField.finiteDimensional_adjoin
  rintro x ⟨a, rfl⟩
  exact (halg a).isIntegral

/-- Exact fixed rational presentation derived from the finite algebraic family. -/
noncomputable def familyPresentation (coeff : A → L)
    (halg : ∀ a, IsAlgebraic ℚ (coeff a)) :
    FixedField (familyField coeff) (Module.finrank ℚ (familyField coeff)) := by
  letI := familyField_finiteDimensional coeff halg
  exact FixedField.ofFiniteDimensional (familyField coeff)

/-- The original coefficient, in the proved common field, with no rescaling. -/
noncomputable def fieldCoefficient (coeff : A → L) (a : A) : familyField coeff :=
  ⟨coeff a, coefficient_mem_familyField coeff a⟩

/-- A fixed rational vector for each literal original coefficient. -/
noncomputable def familyCoordinates (coeff : A → L) (halg : ∀ a, IsAlgebraic ℚ (coeff a))
    (a : A) : Fin (Module.finrank ℚ (familyField coeff)) → ℚ :=
  (familyPresentation coeff halg).basis.equivFun (fieldCoefficient coeff a)

/-- Exact coefficient identity in the ambient field, with the original scalar
retained. This supplies the fixed table used by coordinate-machine compilation. -/
theorem familyCoordinates_spec (coeff : A → L) (halg : ∀ a, IsAlgebraic ℚ (coeff a))
    (a : A) :
    ((familyPresentation coeff halg).decode (familyCoordinates coeff halg a) : L) = coeff a := by
  change (((familyPresentation coeff halg).basis.equivFun.symm
    ((familyPresentation coeff halg).basis.equivFun (fieldCoefficient coeff a))) : L) = coeff a
  rw [LinearEquiv.symm_apply_apply]
  rfl

/-- The presentation and the coefficient vectors are derived witnesses, not an
assumed machine-oracle, field-closure predicate or supplied coordinate certificate. -/
theorem exists_fixed_family_coordinates (coeff : A → L) (halg : ∀ a, IsAlgebraic ℚ (coeff a)) :
    ∃ (n : ℕ) (F : FixedField (familyField coeff) n) (coordinates : A → Fin n → ℚ),
      ∀ a, (F.decode (coordinates a) : L) = coeff a :=
  ⟨_, familyPresentation coeff halg, familyCoordinates coeff halg, familyCoordinates_spec coeff halg⟩

end Holant.Algebraic
