import Holant.Projective.FiniteSubgroupClassification.FixedPoints
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-! Actual conjugacy to the displayed cyclic models, including their exact
matrix carrier and order. This proves the cyclic branch of Proposition 2.1;
it does not assume or assert that arbitrary finite subgroups are cyclic. -/

namespace Holant.Projective.FiniteSubgroupClassification
open Holant.Projective.BoundedTorsion
open Holant.Projective.FiniteGroupFacts.ProjectiveCentralizers
noncomputable section

/-- Generator used in the source's displayed standard cyclic model. -/
def cyclicGenerator (ω : ℂˣ) : PGL2 ℂ := pglMk ℂ (diagonalGL 1 ω)

/-- The actual cyclic subgroup generated by the displayed diagonal class. -/
def cyclicModel (ω : ℂˣ) : Subgroup (PGL2 ℂ) := Subgroup.zpowers (cyclicGenerator ω)

theorem cyclicGenerator_eq_torus (ω : ℂˣ) : cyclicGenerator ω = torusHom ω⁻¹ := by
  simpa [cyclicGenerator] using diagonal_normalize 1 ω

theorem cyclicGenerator_order (ω : ℂˣ) : orderOf (cyclicGenerator ω) = orderOf ω := by
  rw [cyclicGenerator_eq_torus, orderOf_injective torusHom torusHom_injective, orderOf_inv]

theorem cyclicModel_card (ω : ℂˣ) : Nat.card (cyclicModel ω) = orderOf ω := by
  rw [cyclicModel, Nat.card_zpowers, cyclicGenerator_order]

/-- The power classes have exactly the displayed matrix representatives. -/
theorem cyclicGenerator_pow (ω : ℂˣ) (k : ℕ) :
    cyclicGenerator ω ^ k = pglMk ℂ (diagonalGL 1 (ω ^ k)) := by
  rw [cyclicGenerator_eq_torus, ← map_pow, inv_pow]
  exact (cyclicGenerator_eq_torus (ω ^ k)).symm

/-- The carrier of the cyclic model is exactly the source's finite list of
power classes, derived from its primitive-root order. -/
theorem mem_cyclicModel_iff {ω : ℂˣ} {m : ℕ} (hm : 0 < m)
    (hω : IsPrimitiveRoot ω m) (q : PGL2 ℂ) :
    q ∈ cyclicModel ω ↔ ∃ k < m, q = pglMk ℂ (diagonalGL 1 (ω ^ k)) := by
  classical
  have ho : orderOf (cyclicGenerator ω) = m := cyclicGenerator_order ω |>.trans hω.eq_orderOf.symm
  have hf : IsOfFinOrder (cyclicGenerator ω) := orderOf_pos_iff.mp (ho ▸ hm)
  rw [cyclicModel, hf.mem_zpowers_iff_mem_range_orderOf, ho]
  simp only [Finset.mem_image, Finset.mem_range, cyclicGenerator_pow]
  exact exists_congr fun k => and_congr_right fun _ => eq_comm

/-- Every finite cyclic projective subgroup is conjugate to a displayed
standard cyclic model of the same order, with an actual primitive root. -/
theorem finite_cyclic_subgroup_conjugacy (H : Subgroup (PGL2 ℂ)) [Finite H] [IsCyclic H] :
    ∃ g : PGL2 ℂ, ∃ ω : ℂˣ,
      IsPrimitiveRoot ω (Nat.card H) ∧
      H.map (MulAut.conj g).toMonoidHom = cyclicModel ω := by
  obtain ⟨q, hq⟩ := H.isCyclic_iff_exists_zpowers_eq_top.mp inferInstance
  have hqmem : q ∈ H := hq ▸ Subgroup.mem_zpowers q
  have hf : IsOfFinOrder q := (Subtype.val_injective.isOfFinOrder_iff (f := H.subtype)).mpr
    (isOfFinOrder_of_finite (⟨q, hqmem⟩ : H))
  have horder : orderOf q = Nat.card H := by rw [← hq, Nat.card_zpowers]
  by_cases hq1 : q = 1
  · refine ⟨1, 1, ?_, ?_⟩
    · have hc : Nat.card H = 1 := by simpa [hq1] using horder.symm
      rw [hc]
      exact IsPrimitiveRoot.one
    · rw [← hq, hq1]
      simp [cyclicModel, cyclicGenerator_eq_torus]
  · obtain ⟨g, a, _, ha⟩ := exists_conjugate_torus hf hq1
    refine ⟨g, a⁻¹, ?_, ?_⟩
    · apply IsPrimitiveRoot.iff_orderOf.mpr
      rw [orderOf_inv, ← orderOf_injective torusHom torusHom_injective, ← ha]
      exact (MulAut.conj g).orderOf_eq q |>.trans horder
    · rw [← hq, MonoidHom.map_zpowers]
      change Subgroup.zpowers (g * q * g⁻¹) = cyclicModel a⁻¹
      rw [ha, cyclicModel, cyclicGenerator_eq_torus, inv_inv]

end
end Holant.Projective.FiniteSubgroupClassification
