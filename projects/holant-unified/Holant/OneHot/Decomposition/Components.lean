import Holant.Holographic
import Holant.NetworkGluing.Finite
import Mathlib.Logic.Relation
import Mathlib.Data.Fintype.Quotient
import Mathlib.SetTheory.Cardinal.Finite

/-!
# Components of an arbitrary ordered-port multigraph

Connectivity is generated by the two vertices of each *individual* edge.
No passage to a simple graph is made: every restricted edge is a subtype of
an original edge, and both of its ordered endpoint occurrences survive.
The finite quotient below is a semantic construction, with no runtime claim.
-/

set_option backward.isDefEq.respectTransparency false

namespace Holant.NetworkShape

/-- The vertex incident to one specified occurrence of an internal edge. -/
def endpoint (s : NetworkShape 0) (e : Fin s.edges) (b : Bool) : Fin s.vertices :=
  (s.closedPorts.symm (e, b)).1

/-- A generating connection keeps the identity of the witnessing edge.
Symmetry and reflexive/transitive closure are supplied by `EqvGen`. -/
def EdgeLink (s : NetworkShape 0) (u v : Fin s.vertices) : Prop :=
  ∃ e : Fin s.edges, s.endpoint e false = u ∧ s.endpoint e true = v

/-- Actual graph reachability, including paths of length zero at isolated vertices. -/
abbrev Reachable (s : NetworkShape 0) : Fin s.vertices → Fin s.vertices → Prop :=
  Relation.EqvGen s.EdgeLink

/-- Every vertex belongs to exactly one connected component. -/
def Component (s : NetworkShape 0) := Quotient (Relation.EqvGen.setoid s.EdgeLink)

/-- The component of an original vertex. -/
def componentOf (s : NetworkShape 0) (v : Fin s.vertices) : s.Component :=
  Quotient.mk _ v

noncomputable instance componentFintype (s : NetworkShape 0) : Fintype s.Component :=
  Fintype.ofFinite (Quotient (Relation.EqvGen.setoid s.EdgeLink))

/-- The quotient identifies precisely vertices joined by actual original edges. -/
theorem componentOf_eq_iff (s : NetworkShape 0) (u v : Fin s.vertices) :
    s.componentOf u = s.componentOf v ↔ s.Reachable u v :=
  Quotient.eq

/-- No component is added without a vertex, even when the graph is empty. -/
theorem componentOf_surjective (s : NetworkShape 0) : Function.Surjective s.componentOf :=
  Quotient.mk_surjective

/-- Assign an edge to the component of its false endpoint. -/
def edgeComponent (s : NetworkShape 0) (e : Fin s.edges) : s.Component :=
  s.componentOf (s.endpoint e false)

/-- Both occurrences of every edge belong to the same component, also for a loop. -/
theorem componentOf_endpoint (s : NetworkShape 0) (e : Fin s.edges) (b : Bool) :
    s.componentOf (s.endpoint e b) = s.edgeComponent e := by
  cases b with
  | false => rfl
  | true =>
    symm
    apply Quotient.sound
    exact Relation.EqvGen.rel _ _ ⟨e, rfl, rfl⟩

/-- Port order is unchanged when an occurrence is assigned to its component. -/
theorem edgeComponent_closedPorts (s : NetworkShape 0)
    (p : Σ v : Fin s.vertices, Fin (s.arity v)) :
    s.edgeComponent (s.closedPorts p).1 = s.componentOf p.1 := by
  have h := s.componentOf_endpoint (s.closedPorts p).1 (s.closedPorts p).2
  simpa only [endpoint, Prod.eta, Equiv.symm_apply_apply] using h.symm

/-- The original vertices in one component, including isolated nullary vertices. -/
abbrev ComponentVertex (s : NetworkShape 0) (c : s.Component) :=
  {v : Fin s.vertices // s.componentOf v = c}

/-- The original edges in one component; no loops or parallel edges are merged. -/
abbrev ComponentEdge (s : NetworkShape 0) (c : s.Component) :=
  {e : Fin s.edges // s.edgeComponent e = c}

private theorem componentOccurrence_injective (s : NetworkShape 0) (c : s.Component) :
    Function.Injective (fun p : (Σ v : s.ComponentVertex c, Fin (s.arity v.1)) =>
      (⟨p.1.1, p.2⟩ : Σ v : Fin s.vertices, Fin (s.arity v))) := by
  rintro ⟨⟨u, hu⟩, i⟩ ⟨⟨v, hv⟩, j⟩ h
  cases h
  rfl

/-- The restricted incidence bijection preserves each original local port number. -/
def componentClosedPorts (s : NetworkShape 0) (c : s.Component) :
    (Σ v : s.ComponentVertex c, Fin (s.arity v.1)) ≃ (s.ComponentEdge c × Bool) where
  toFun p := (⟨(s.closedPorts ⟨p.1.1, p.2⟩).1,
    (s.edgeComponent_closedPorts ⟨p.1.1, p.2⟩).trans p.1.2⟩,
    (s.closedPorts ⟨p.1.1, p.2⟩).2)
  invFun q := ⟨⟨(s.closedPorts.symm (q.1.1, q.2)).1,
    (s.componentOf_endpoint q.1.1 q.2).trans q.1.2⟩,
    (s.closedPorts.symm (q.1.1, q.2)).2⟩
  left_inv p := by
    apply s.componentOccurrence_injective c
    exact s.closedPorts.symm_apply_apply ⟨p.1.1, p.2⟩
  right_inv q := by
    rcases q with ⟨⟨e, he⟩, b⟩
    simp only [Sigma.eta, Equiv.apply_symm_apply]

@[simp] theorem componentClosedPorts_val (s : NetworkShape 0) (c : s.Component)
    (v : s.ComponentVertex c) (i : Fin (s.arity v.1)) :
    ((s.componentClosedPorts c ⟨v, i⟩).1.1, (s.componentClosedPorts c ⟨v, i⟩).2) =
      s.closedPorts ⟨v.1, i⟩ := rfl

/-- This is an actual closed network port equivalence, without extra boundary stubs. -/
def componentPorts (s : NetworkShape 0) (c : s.Component) :
    (Σ v : s.ComponentVertex c, Fin (s.arity v.1)) ≃
      (Fin 0 ⊕ (s.ComponentEdge c × Bool)) :=
  (s.componentClosedPorts c).trans (Equiv.emptySum _ _).symm

/-- The vertex fibers partition all original vertices, not only nonisolated ones. -/
def componentVertexEquiv (s : NetworkShape 0) :
    (Σ c : s.Component, s.ComponentVertex c) ≃ Fin s.vertices :=
  Equiv.sigmaFiberEquiv s.componentOf

/-- The edge fibers partition all original edges with their multiplicities. -/
def componentEdgeEquiv (s : NetworkShape 0) :
    (Σ c : s.Component, s.ComponentEdge c) ≃ Fin s.edges :=
  Equiv.sigmaFiberEquiv s.edgeComponent

/-- Every component has at least one original vertex. -/
theorem componentVertex_nonempty (s : NetworkShape 0) (c : s.Component) :
    Nonempty (s.ComponentVertex c) := by
  obtain ⟨v, hv⟩ := s.componentOf_surjective c
  exact ⟨⟨v, hv⟩⟩

/-- All and only vertices in the same fiber are connected in the original multigraph. -/
theorem componentVertex_reachable (s : NetworkShape 0) (c : s.Component)
    (u v : s.ComponentVertex c) : s.Reachable u.1 v.1 :=
  (s.componentOf_eq_iff _ _).mp (u.2.trans v.2.symm)

open scoped Classical in
/-- The partition preserves the total number of vertices exactly. -/
theorem sum_componentVertex_card (s : NetworkShape 0) :
    (∑ c : s.Component, Fintype.card (s.ComponentVertex c)) = s.vertices := by
  rw [← Fintype.card_sigma]
  exact (Fintype.card_congr s.componentVertexEquiv).trans (Fintype.card_fin _)

open scoped Classical in
/-- The partition preserves every edge, including loops and repeated pairs. -/
theorem sum_componentEdge_card (s : NetworkShape 0) :
    (∑ c : s.Component, Fintype.card (s.ComponentEdge c)) = s.edges := by
  rw [← Fintype.card_sigma]
  exact (Fintype.card_congr s.componentEdgeEquiv).trans (Fintype.card_fin _)

end Holant.NetworkShape

namespace Holant.Network

variable {K : Type*}

/-- Restrict actual vertex and edge labels to a connected component.
The ordered local signature arguments and edge endpoint orientation are unchanged. -/
def componentFiniteNetwork (N : Network K 0) (c : N.shape.Component) :
    FiniteNetwork K (N.shape.ComponentVertex c) (N.shape.ComponentEdge c) 0 where
  arity := fun v => N.shape.arity v.1
  ports := N.shape.componentPorts c
  vertex := fun v => N.vertex v.1
  edge := fun e => N.edge e.1

/-- The actual `Fin`-indexed restricted network, with its own complete incidence bijection. -/
noncomputable def componentNetwork (N : Network K 0) (c : N.shape.Component) :
    Network K 0 := by
  classical
  exact (N.componentFiniteNetwork c).toNetwork

@[simp] theorem componentNetwork_vertices (N : Network K 0) (c : N.shape.Component) :
    (N.componentNetwork c).shape.vertices = Nat.card (N.shape.ComponentVertex c) := by
  classical
  simp only [componentNetwork, FiniteNetwork.toNetwork, Nat.card_eq_fintype_card]

@[simp] theorem componentNetwork_edges (N : Network K 0) (c : N.shape.Component) :
    (N.componentNetwork c).shape.edges = Nat.card (N.shape.ComponentEdge c) := by
  classical
  simp only [componentNetwork, FiniteNetwork.toNetwork, Nat.card_eq_fintype_card]

end Holant.Network
