theorem all_anchors_solved (a : Fin 2222) : Solved (stateEquiv (representativeCode (anchorRepresentative a))) := by
  let b : Fin 139 := ⟨a.val/16,by have := a.isLt; omega⟩
  let i : Fin 16 := ⟨a.val%16,Nat.mod_lt _ (by decide)⟩
  have he : Fin.ofNat 2222 (16*b.val+i.val) = a := by
    apply Fin.ext
    change (16*(a.val/16)+a.val%16)%2222 = a.val
    have hh : 16*(a.val/16)+a.val%16 = a.val := by omega
    rw [hh,Nat.mod_eq_of_lt a.isLt]
  simpa only [he] using all_anchor_batches b i

theorem all_representatives_solved_via_anchors (r : Fin 4045) :
    Solved (stateEquiv (representativeCode r)) :=
  original_representatives_of_anchors all_anchors_solved r

