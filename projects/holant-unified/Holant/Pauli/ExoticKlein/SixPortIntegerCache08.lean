theorem integerCache08_g0 : ∀ d : Fin 48, ∀ word : Fin 16,
    integerCache08.get (16*(48*0+d.val)+word.val) = actualIntegerColumn 8 0 d word := by
  intro d
  fin_cases d <;> decide +kernel

theorem integerCache08_g1 : ∀ d : Fin 48, ∀ word : Fin 16,
    integerCache08.get (16*(48*1+d.val)+word.val) = actualIntegerColumn 8 1 d word := by
  intro d
  fin_cases d <;> decide +kernel

theorem integerCache08_g2 : ∀ d : Fin 48, ∀ word : Fin 16,
    integerCache08.get (16*(48*2+d.val)+word.val) = actualIntegerColumn 8 2 d word := by
  intro d
  fin_cases d <;> decide +kernel

theorem integerCache08_g3 : ∀ d : Fin 48, ∀ word : Fin 16,
    integerCache08.get (16*(48*3+d.val)+word.val) = actualIntegerColumn 8 3 d word := by
  intro d
  fin_cases d <;> decide +kernel

theorem integerCache08_correct (g : Fin 4) (d : Fin 48) (word : Fin 16) :
    integerCache08.get (16*(48*g.val+d.val)+word.val) = actualIntegerColumn 8 g d word := by
  fin_cases g
  · exact integerCache08_g0 d word
  · exact integerCache08_g1 d word
  · exact integerCache08_g2 d word
  · exact integerCache08_g3 d word

end
