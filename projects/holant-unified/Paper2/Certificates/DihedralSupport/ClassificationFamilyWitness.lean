module
public import Paper2.Certificates.DihedralSupport.ClassificationChecked
public import Paper2.Certificates.DihedralSupport.SupportOrbit
public import Paper2.Certificates.DihedralSupport.EvenPartitionCosets

/-! Untrusted choices of genuine family witnesses. The single checked Boolean
predicate verifies each survivor's equality with its selected actual generated
coset or actual previously proved orbit member. -/
@[expose] public section
namespace Paper2.Certificates.DihedralSupport

def familyCodesPacked : Nat := 

def familyCode (i : Nat) : Nat := (familyCodesPacked >>> (12*i)) % 4096

def familyWitnessCheck (i : Nat) : Bool :=
  let c := familyCode i
  if c=0 then survivorAt i == 0
  else if c<2048 then
    let j := (c-1)/64
    if hj : j<evenPartitions.length then
      cosetMask (evenPartitions[j]) ((c-1)%64) == survivorAt i
    else false
  else decide (c-2048<480) && (SupportOrbit.maskAt (c-2048) == survivorAt i)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem family_witnesses_checked : checkRange familyWitnessCheck 0 873 = true := by
  decide +kernel

/-- The verified choices supply genuine membership witnesses, with no assumed
classification or equality of two stored accepted-mask lists. -/
theorem survivor_mem_generated (i : Fin 873) :
    survivorAt i.val ∈ insert 0 (affineMasks ∪ SupportOrbit.orbitMasks) := by
  have h := checkRange_sound _ _ _ family_witnesses_checked i.val (by omega) i.isLt
  by_cases h0 : familyCode i.val=0
  · have he : survivorAt i.val=0 := by simpa [familyWitnessCheck,h0] using h
    rw [he]
    exact Finset.mem_insert_self _ _
  · by_cases hc : familyCode i.val<2048
    · by_cases hj : (familyCode i.val-1)/64<evenPartitions.length
      · have he : cosetMask (evenPartitions[(familyCode i.val-1)/64])
            ((familyCode i.val-1)%64) = survivorAt i.val := by
          simpa [familyWitnessCheck,h0,hc,hj] using h
        apply Finset.mem_insert_of_mem
        apply Finset.mem_union_left
        apply (affineMasks_generated _).mpr
        refine ⟨evenPartitions[(familyCode i.val-1)/64],List.getElem_mem hj,
          (familyCode i.val-1)%64,Nat.mod_lt _ (by decide),he⟩
      · simp [familyWitnessCheck,h0,hc,hj] at h
    · have hh : familyCode i.val-2048<480 ∧
          SupportOrbit.maskAt (familyCode i.val-2048)=survivorAt i.val := by
        simpa [familyWitnessCheck,h0,hc] using h
      apply Finset.mem_insert_of_mem
      apply Finset.mem_union_right
      rw [←hh.2]
      exact SupportOrbit.data_mem ⟨familyCode i.val-2048,hh.1⟩

end Paper2.Certificates.DihedralSupport

