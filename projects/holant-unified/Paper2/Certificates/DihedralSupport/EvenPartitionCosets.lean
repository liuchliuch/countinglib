module
public import Paper2.Certificates.DihedralSupport.Core
public import Mathlib.Data.Finset.Card

/-! Literal affine cosets generated by the even partitions of six ports.
The lists below describe partitions by their block-indicator words, not by
accepted support masks. Every coset mask is computed from all Boolean sums
of these indicators and an actual six-bit translation. -/
@[expose] public section
namespace Paper2.Certificates.DihedralSupport

def pairBlocks : List Nat :=
  [3,5,6,9,10,12,17,18,20,24,33,34,36,40,48]

def fourTwoPartitions : List (List Nat) :=
  pairBlocks.map (fun b => [b,63 ^^^ b])

def matchingPartitions : List (List Nat) :=
  [[3,12,48],[3,20,40],[3,36,24],
   [5,10,48],[5,18,40],[5,34,24],
   [9,6,48],[9,18,36],[9,34,20],
   [17,6,40],[17,10,36],[17,34,12],
   [33,6,24],[33,10,20],[33,18,12]]

def evenPartitions : List (List Nat) :=
  [[63]] ++ fourTwoPartitions ++ matchingPartitions

def blockSpan : List Nat → List Nat
  | [] => [0]
  | b :: bs => blockSpan bs ++ (blockSpan bs).map (fun w => w ^^^ b)

def maskOfWords (words : List Nat) : Nat :=
  words.foldr (fun w mask => (2^w) ||| mask) 0

def cosetMask (blocks : List Nat) (translation : Nat) : Nat :=
  maskOfWords ((blockSpan blocks).map (fun w => translation ^^^ w))

def cosetsOf (partitions : List (List Nat)) : Finset Nat :=
  (partitions.flatMap (fun bs => (List.range 64).map (cosetMask bs))).toFinset

def sixBlockCosets : Finset Nat := cosetsOf [[63]]
def fourTwoCosets : Finset Nat := cosetsOf fourTwoPartitions
def matchingCosets : Finset Nat := cosetsOf matchingPartitions
def affineMasks : Finset Nat := cosetsOf evenPartitions

theorem affineMasks_generated (m : Nat) :
    m ∈ affineMasks ↔
      ∃ bs ∈ evenPartitions, ∃ a < 64, cosetMask bs a = m := by
  simp only [affineMasks,cosetsOf,List.mem_toFinset,List.mem_flatMap,
    List.mem_map,List.mem_range]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem sixBlockCosets_card : sixBlockCosets.card = 32 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem fourTwoCosets_card : fourTwoCosets.card = 240 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem matchingCosets_card : matchingCosets.card = 120 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem affineMasks_card : affineMasks.card = 392 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem coset_components_disjoint :
    Disjoint sixBlockCosets fourTwoCosets ∧
      Disjoint sixBlockCosets matchingCosets ∧ Disjoint fourTwoCosets matchingCosets := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem affineMasks_positive_bounded :
    ∀ m ∈ affineMasks, 0 < m ∧ m < 18446744073709551616 := by decide +kernel

def maskWordParity (w : Nat) : Bool :=
  (List.finRange 6).foldr (fun i p => w.testBit i.val ^^ p) false

def maskSingleParity (m : Nat) : Prop :=
  ∃ parity : Bool, ∀ w : Fin 64, m.testBit w.val = true →
    maskWordParity w.val = parity

instance (m : Nat) : Decidable (maskSingleParity m) := by
  unfold maskSingleParity
  infer_instance

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem affineMasks_singleParity : ∀ m ∈ affineMasks, maskSingleParity m := by
  decide +kernel

end Paper2.Certificates.DihedralSupport

