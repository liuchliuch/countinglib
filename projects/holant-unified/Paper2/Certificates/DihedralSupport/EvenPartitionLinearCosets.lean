module
public import Paper2.Certificates.DihedralSupport.EvenPartitionCosetSemantics
public import Paper2.Certificates.DihedralSupport.EvenPartitionLinearSpan

/-! Literal affine F₂ cosets and the finite Boolean representation have
exactly the same supports. The span is the actual submodule generated by
the original partition block indicators. -/
@[expose] public section
namespace Paper2.Certificates.DihedralSupport

theorem wordVector_mem_blockLinearSpan_iff
    (B : Finset (Finset (Fin 6))) (h : EvenPartition B) (x : Fin 6 → Bool) :
    wordVector x ∈ blockLinearSpan B ↔ x ∈ partitionSpanWords B := by
  rw [wordVector_mem_blockLinearSpan_exists B h,mem_partitionSpanWords]

theorem wordVector_wordXor (a b : Fin 6 → Bool) :
    wordVector (wordXor a b)=wordVector a+wordVector b := by
  funext k
  change (if a k ^^ b k then (1 : ZMod 2) else 0) =
    (if a k then 1 else 0)+(if b k then 1 else 0)
  cases a k <;> cases b k <;> decide +kernel

/-- The source's literal translate of the actual F₂ linear span. -/
def EvenPartitionLinearCoset (S : Support6) : Prop :=
  ∃ B : Finset (Finset (Fin 6)), EvenPartition B ∧
    ∃ a : Fin 6 → Bool, ∀ x : Fin 6 → Bool,
      S x=true ↔ ∃ v : Fin 6 → ZMod 2,
        v ∈ blockLinearSpan B ∧ wordVector x=wordVector a+v

theorem translatedSupport_linearSpan (B : Finset (Finset (Fin 6)))
    (h : EvenPartition B) (a x : Fin 6 → Bool) :
    translatedSupport a (partitionSpanWords B) x=true ↔
      ∃ v : Fin 6 → ZMod 2,
        v ∈ blockLinearSpan B ∧ wordVector x=wordVector a+v := by
  classical
  simp only [translatedSupport,decide_eq_true_eq,Finset.mem_image]
  constructor
  · rintro ⟨y,hy,rfl⟩
    exact ⟨wordVector y,(wordVector_mem_blockLinearSpan_iff B h y).mpr hy,
      wordVector_wordXor a y⟩
  · rintro ⟨v,hv,hx⟩
    obtain ⟨C,hCB,hC⟩ := (mem_blockLinearSpan_iff B h.2.2.1 v).mp hv
    let y : Fin 6 → Bool := fun k => decide (k ∈ C.biUnion id)
    have hy : y ∈ partitionSpanWords B := (mem_partitionSpanWords B y).mpr ⟨C,hCB,rfl⟩
    refine ⟨y,hy,wordVector_injective ?_⟩
    rw [wordVector_wordXor,wordVector_indicator,←hC]
    exact hx.symm

/-- Exact source affine-coset geometry, with neither span membership nor
the translation hidden behind an accepted-case certificate. -/
theorem evenPartitionLinearCoset_iff (S : Support6) :
    EvenPartitionLinearCoset S ↔ EvenPartitionCoset S := by
  classical
  constructor
  · rintro ⟨B,hB,a,hS⟩
    refine ⟨B,hB,a,?_⟩
    funext x
    apply Bool.eq_iff_iff.mpr
    exact (hS x).trans (translatedSupport_linearSpan B hB a x).symm
  · rintro ⟨B,hB,a,rfl⟩
    exact ⟨B,hB,a,translatedSupport_linearSpan B hB a⟩

theorem evenPartitionLinearCoset_iff_affineMasks (S : Support6) :
    EvenPartitionLinearCoset S ↔ encodeSupport S ∈ affineMasks := by
  rw [evenPartitionLinearCoset_iff,evenPartitionCoset_iff_affineMasks]

end Paper2.Certificates.DihedralSupport

