import Paper2.ExactInput.FixedRootCodec.VariableRootBisectionMath
import Paper2.ExactInput.FixedRootCodec.InputHeight
import Paper2.Complexity.BellMachines.ListCombinators

/-! Root refinement starts from a Cauchy bracket computed from the literal
coefficient words. Its exponential numerical radius has only linear binary
length. Requested precision and the extra shrinking rounds are physical unary
words, generated by an actual input scanner. A fixed-capacity list records
all rank slots together with their active flags. -/
namespace Paper2.ExactInput.FixedRootCodec.VariableRootBisection
open Computability Paper2.Algebraic Paper2.Complexity
open BinaryCompose FixedFieldMachines BellMachines GraphPreprocessing
open Holant.LocalDrafts.EffectiveAlgebraic
open scoped BigOperators
noncomputable section
set_option backward.isDefEq.respectTransparency false
variable {n : ℕ}

def naturalDouble (m : ℕ) : ℕ := 2*m

def naturalDoubleComputes : Computes encodingNatBool encodingNatBool naturalDouble :=
  (pairComputes (constantComputes encodingNatBool encodingNatBool 2)
    (identityComputes encodingNatBool)).andThen RationalArithmetic.naturalMultiplicationComputes

theorem naturalDouble_iterate (k m : ℕ) : (naturalDouble^[k]) m = 2^k*m := by
  induction k with
  | zero => simp
  | succ k ih => rw [Function.iterate_succ_apply',naturalDouble,ih,pow_succ]; ring

def naturalDoubleSpace : Polynomial ℕ := Polynomial.X+1

theorem naturalDouble_intermediate :
    BoundedIterate.IntermediateBound encodingNatBool naturalDouble naturalDoubleSpace := by
  intro k m r hr
  have hb := natSize_mul_le (2^r) m
  rw [Nat.size_pow] at hb
  simp only [naturalDouble_iterate,encodingNatBool,encodeNat_length]
  apply hb.trans
  simp only [naturalDoubleSpace,Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_one,
    BoundedIterate.inputEncoding,pairEncoding_length,UnaryBinary.unaryEncoding,
    List.length_replicate,encodingNatBool,encodeNat_length]
  omega

def twoPowerComputes : Computes UnaryBinary.unaryEncoding encodingNatBool (fun k : ℕ => 2^k) := by
  let initial := pairComputes (identityComputes UnaryBinary.unaryEncoding)
    (constantComputes UnaryBinary.unaryEncoding encodingNatBool 1)
  exact congrComputes (initial.andThen (BoundedIterate.computes encodingNatBool naturalDouble
    naturalDoubleComputes naturalDoubleSpace naturalDouble_intermediate))
    (fun k => by simp [naturalDouble_iterate])

def coefficientHeight (v : Fin n → ℚ) : ℕ := ((vectorEncoding n).encode v).length+1
def radiusExponent (v : Fin n → ℚ) : ℕ := 2*((vectorEncoding n).encode v).length+4
def radius (v : Fin n → ℚ) : ℕ := 2^(radiusExponent v)

theorem coefficient_height_bound (v : Fin n → ℚ) (j : ℕ) :
    rationalBitHeight ((VariablePolynomial.polynomial v).coeff j) ≤ coefficientHeight v := by
  rw [VariablePolynomial.coefficient_eq]
  split_ifs with h
  · exact coordinate_height_input v ⟨j,h⟩
  · simp [coefficientHeight,rationalBitHeight,rationalHeight]

def radiusComputes (n : ℕ) : Computes (vectorEncoding n) encodingNatBool (radius (n := n)) :=
  congrComputes ((precisionComputes (vectorEncoding n) 2 4).andThen twoPowerComputes)
    (fun _ => rfl)

def initialBracket (v : Fin n → ℚ) : BisectionState := (-(radius v : ℤ),radius v,1)
def initialState (v : Fin n → ℚ) : State n := (v,initialBracket v)

def initialStateComputes (n : ℕ) :
    Computes (vectorEncoding n) (stateEncoding n) (initialState (n := n)) := by
  let r := (radiusComputes n).andThen RationalArithmetic.natCastComputes
  let lower := (pairComputes (constantComputes (vectorEncoding n) IntegerArithmetic.encoding (-1)) r).andThen RationalArithmetic.integerMultiplicationComputes
  exact congrComputes (pairComputes (identityComputes (vectorEncoding n))
    (pairComputes lower (pairComputes r (constantComputes (vectorEncoding n) encodingNatBool 1))))
    (fun v => by simp [initialState,initialBracket,neg_mul])

abbrev requestEncoding (n : ℕ) := pairEncoding UnaryBinary.unaryEncoding (vectorEncoding n)

def rounds (t : ℕ) (v : Fin n → ℚ) : ℕ := 2*((requestEncoding n).encode (t,v)).length+8

def requestComputes (n : ℕ) :
    Computes (requestEncoding n) (BoundedIterate.inputEncoding (stateEncoding n))
      (fun p => (rounds p.1 p.2,initialState p.2)) :=
  pairComputes (precisionComputes (requestEncoding n) 2 8)
    ((Wiring.secondComputes UnaryBinary.unaryEncoding (vectorEncoding n)).andThen
      (initialStateComputes n))

def approximate (count : CountFunction n) (j t : ℕ) (v : Fin n → ℚ) : ℚ :=
  point count j (rounds t v) (initialState v)

def approximateComputes (count : CountFunction n) (j : ℕ)
    (w : Computes (VariablePolynomial.inputEncoding n) encodingNatBool
      (fun p => count p.1 p.2)) :
    Computes (requestEncoding n) rationalEncoding (fun p => approximate count j p.1 p.2) :=
  (requestComputes n).andThen (pointComputes count j w)

def active (count : CountFunction n) (j : ℕ) (v : Fin n → ℚ) : Bool :=
  !decide (count v (radius v : ℚ) ≤ j)

def booleanNotComputes : Computes encodingBoolBool encodingBoolBool Bool.not :=
  FiniteRecode.computes encodingBoolBool encodingBoolBool Bool.not 1 (fun b => by cases b <;> decide)

def activeComputes (count : CountFunction n) (j : ℕ)
    (w : Computes (VariablePolynomial.inputEncoding n) encodingNatBool
      (fun p => count p.1 p.2)) :
    Computes (vectorEncoding n) encodingBoolBool (active count j) :=
  congrComputes ((((pairComputes (identityComputes (vectorEncoding n))
    ((radiusComputes n).andThen roundNaturalCastComputes)).andThen w).andThen
      (countLeComputes j)).andThen booleanNotComputes) (fun _ => rfl)

abbrev slotEncoding := pairEncoding encodingBoolBool rationalEncoding

def slot (count : CountFunction n) (j : Fin n) (t : ℕ) (v : Fin n → ℚ) : Bool × ℚ :=
  (active count j.val v,approximate count j.val t v)

def slotComputes (count : CountFunction n) (j : Fin n)
    (w : Computes (VariablePolynomial.inputEncoding n) encodingNatBool
      (fun p => count p.1 p.2)) :
    Computes (requestEncoding n) slotEncoding (fun p => slot count j p.1 p.2) :=
  pairComputes ((Wiring.secondComputes UnaryBinary.unaryEncoding (vectorEncoding n)).andThen
    (activeComputes count j.val w)) (approximateComputes count j.val w)

def approximations (count : CountFunction n) (t : ℕ) (v : Fin n → ℚ) : List (Bool × ℚ) :=
  (List.finRange n).map (fun j => slot count j t v)

/-- Every fixed rank slot is computed by concrete programs and serialized with
its Boolean active flag. Unused slots are retained as literal data. -/
def approximationsComputes (count : CountFunction n)
    (w : Computes (VariablePolynomial.inputEncoding n) encodingNatBool
      (fun p => count p.1 p.2)) :
    Computes (requestEncoding n) (framedListEncoding slotEncoding)
      (fun p => approximations count p.1 p.2) :=
  FixedGadgetSubstitution.Compiler.fixedListComputes (requestEncoding n) slotEncoding
    (fun p j => slot count j p.1 p.2) (fun j => slotComputes count j w) (List.finRange n)

/-- The point array used by Cartesian products and embedding assignments has
the same concrete programs as the flagged list. -/
def approximationVectorComputes (count : CountFunction n)
    (w : Computes (VariablePolynomial.inputEncoding n) encodingNatBool
      (fun p => count p.1 p.2)) :
    Computes (requestEncoding n) (vectorEncoding n)
      (fun p j => approximate count j.val p.1 p.2) :=
  assembleComputes _ n _ (fun j => approximateComputes count j.val w)

end
end Paper2.ExactInput.FixedRootCodec.VariableRootBisection
