import Paper2.SourceFaithful.HeightOneNormalizedStage
import Paper2.SourceFaithful.HeightTwo

/-! Concrete strict iteration for source height-one classification. Every
successor is a real equivalent finite language. The actual group bound is
proved in the single field generated by the original input tables, and every
strict normalized update is inverse-normalized before continuing. -/
namespace Paper2.SourceFaithful.HeightOne
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Tractable ExactInput
open Paper2.HeightOne Paper2.HeightOne.PhaseCards Paper2.HeightOne.Cyclic
open Paper2.HeightOne.GroupSplit Paper2.HeightOne.GroupSplit.MatrixGroup

lemma mountain_table_binary (f : Signature AlgebraicComplex 2) (hf : IsMountain (d:=1) f) :
    (tableBinary f) false false ≠ 0 ∧ (tableBinary f) true true ≠ 0 := by
  have h0 : (![false,false] : Fin 2 → Bool) = (fun _ => false) := by funext i; fin_cases i <;> rfl
  have h1 : (![true,true] : Fin 2 → Bool) = (fun _ => true) := by funext i; fin_cases i <;> rfl
  simpa only [tableBinary, h0, h1] using And.intro hf.zero_ne_zero hf.one_ne_zero

lemma actual_weightedEquality_terminal
    (P : Paper1Accepted) (PG : Paper1DirectGadgetAccepted)
    (PR : Paper1RestrictionAccepted) (PN : Paper1NormalizationAccepted)
    (L : Language) (hpre : Preprocessed L.family)
    (f : Signature AlgebraicComplex 2) (hf : HeightTwo.WeightedEquality f)
    (hreal : NetworkRealizable L.family f) : Terminal L := by
  obtain ⟨A,hA,hAL,_⟩ := PG.adjoin_equivalence PR L f
    (NativeNetworkRealizesUpTo.of_realizable hreal)
  have hsub : L.family ⊆ A.family := by rw [hA]; exact Set.subset_insert _ _
  have hpreA : Preprocessed A.family := by
    rw [hA]
    rintro g (rfl | hg)
    · exact ⟨by change 0 < 2; decide, fun hz => hf.2.2.1 (congrFun hz _)⟩
    · exact hpre g hg
  have hmem : (⟨2,f⟩ : AnySignature AlgebraicComplex) ∈ A.family := by rw [hA]; simp
  rcases SourceFaithful.HeightTwo.weightedEquality_language_classification P PN A hpreA f hf hmem with ht | hh
  · exact Or.inl (ht.mono_family (familyAction_mono sourceKBasis hsub))
  · exact Or.inr (hh.transport hAL)

/-- The one-shot finite factor closure also proves original-field control for
all arbitrary chosen prime factors. No extra field presentation is assumed. -/
theorem initial_prime_stage
    (PG : Paper1DirectGadgetAccepted) (PR : Paper1RestrictionAccepted)
    (PF : Paper1FactorClosureAccepted) (PU : Paper1UnaryAccepted)
    (PI : Paper1BinaryInterpolationAccepted)
    (L : Language) (hpre : Preprocessed L.family)
    (f : Signature AlgebraicComplex 2) (hf : IsMountain (d:=1) f)
    (hmem : (⟨2,f⟩ : AnySignature AlgebraicComplex) ∈ L.family) :
    Terminal L ∨ Nonempty (PrimeStage L) := by
  classical
  have htwo : ¬ CommonOneSided L.family := Paper2.HeightTwo.two_endpoints_not_commonOneSided
    (by decide : 0 < 2) L.family f hmem hf.zero_ne_zero hf.one_ne_zero
  obtain ⟨D,A,hA,hAL,hLA⟩ := SourceFaithful.factorClosure_exists PF L hpre htwo
  have hsub : L.family ⊆ A.family := by rw [hA]; exact Set.subset_union_left
  have hpreA : Preprocessed A.family := by rw [hA]; exact D.retained_preprocessed hpre
  have htwoA : ¬ CommonOneSided A.family := Paper2.HeightTwo.two_endpoints_not_commonOneSided
    (by decide : 0 < 2) A.family f (hsub hmem) hf.zero_ne_zero hf.one_ne_zero
  have hret : SourceRetainedExtension L A := ⟨hsub,hpreA,htwoA,hAL,hLA⟩
  have hfac : FactorClosed A.family := by rw [hA]; exact factorClosed_retained D
  have hfield : ∀ g ∈ A.family, ProjectivelyOver (originalField L) g.2 := by
    rw [hA]
    rintro g (hg | ⟨⟨i,j⟩,rfl⟩)
    · exact original_family_over_field L g hg
    · have hv : ProjectivelyOver (originalField L) (D.decomposition i).value := by
        rw [D.exact_value i]
        exact original_family_over_field L _ ⟨i,rfl⟩
      exact Decomposition.factor_projectivelyOver (D.decomposition i) (originalField L) hv
        (by rw [D.exact_value i]; exact (hpre _ ⟨i,rfl⟩).2) j
  by_cases hs : AllBinariesSafe A.family
  · have hbinary : ∃ B : AMat, ActualNonsingular A.family B := by
      refine ⟨tableBinary f, actual_tableBinary hs f (networkRealizable_of_mem (hsub hmem)) ?_⟩
      intro hz
      exact hf.zero_ne_zero (congrFun hz _)
    by_cases hn : HasNonbinaryPrime A.family
    · obtain ⟨ν,hν⟩ := exists_leastPrimeArity hn
      exact Or.inr ⟨⟨⟨A,hret,hfac,hfield,hs,hbinary⟩,ν,hν⟩⟩
    · exact Or.inl (terminal_of_retained hret (Or.inl (tract_of_no_nonbinary A hfac hn)))
  · exact Or.inl (terminal_of_retained hret (unsafe_actual_binary_classification PG PR PF PU PI A
      hpreA (signs_of_not_commonOneSided htwoA) hs))

/-- A complete source step, including group splitting and its actual weighted
equality terminal. Stable stages retain precisely the representatives needed
by the independently proved cyclic and dihedral analytic branches. -/
theorem raw_stage_step
    (P : Paper1Accepted) (P1 : GroupSplit.Paper1Accepted)
    (PG : Paper1DirectGadgetAccepted) (PR : Paper1RestrictionAccepted)
    (PF : Paper1FactorClosureAccepted) (PU : Paper1UnaryAccepted)
    (PI : Paper1BinaryInterpolationAccepted) (PO : Paper1OddAccepted)
    (PN : Paper1NormalizationAccepted) {L : Language} (S : PrimeStage L)
    (f : Signature AlgebraicComplex 2) (hf : IsMountain (d:=1) f)
    (hmem : (⟨2,f⟩ : AnySignature AlgebraicComplex) ∈ L.family) :
    Terminal L ∨ (∃ T : PrimeStage L, T.measure < S.measure) ∨
      Nonempty (StableNormalizedStage L) := by
  have hmemS : (⟨2,binarySignature (tableBinary f)⟩ : AnySignature AlgebraicComplex) ∈ S.language.family := by
    rw [binarySignature_tableBinary]
    exact S.retained.subset hmem
  obtain ⟨h0,h1⟩ := mountain_table_binary f hf
  rcases finite_group_split P1 S.language.family S.language.family_finite
    (tableBinary f) hmemS h0 h1 S.safe with hEq | hOdd
  · left
    obtain ⟨g,hg,hEq⟩ := hEq
    exact S.terminal (actual_weightedEquality_terminal P PG PR PN S.language S.retained.preprocessed g hEq hg)
  · obtain ⟨N,q,D,hN,hodd,hq,hD,hconf,hsafe,hgroup,_⟩ := hOdd
    obtain ⟨M,hM,hML,hLM⟩ := PN.normalize S.language S.retained.preprocessed D hconf
    have hgroupM : actualClasses M.family = cyclicPhaseClasses N ∨
        actualClasses M.family = dihedralPhaseClasses N := by
      rw [hM]
      rw [xor_iff_or_and_not_and] at hgroup
      exact hgroup.1
    have hsafeM : AllBinariesSafe M.family := by rwa [hM]
    exact normalized_stage_step P1 PG PR PF PU PI PO PN S D q 1 hD hq one_ne_zero hconf
      M hM hML hLM N hN hodd hgroupM hsafeM

/-- Source Lemma 5.6 is used on the actual constructed stages: after finitely
many strict updates there is a canonical terminal or a stable normalized deck.
The strict successor construction is the proved raw_stage_step above. -/
theorem iteration_reaches_stable
    (P : Paper1Accepted) (P1 : GroupSplit.Paper1Accepted)
    (PG : Paper1DirectGadgetAccepted) (PR : Paper1RestrictionAccepted)
    (PF : Paper1FactorClosureAccepted) (PU : Paper1UnaryAccepted)
    (PI : Paper1BinaryInterpolationAccepted) (PO : Paper1OddAccepted)
    (PN : Paper1NormalizationAccepted) (L : Language) (hpre : Preprocessed L.family)
    (f : Signature AlgebraicComplex 2) (hf : IsMountain (d:=1) f)
    (hmem : (⟨2,f⟩ : AnySignature AlgebraicComplex) ∈ L.family) :
    Terminal L ∨ Nonempty (StableNormalizedStage L) := by
  have aux : ∀ k : ℕ, ∀ S : PrimeStage L, S.measure = k →
      Terminal L ∨ Nonempty (StableNormalizedStage L) := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro S hk
      rcases raw_stage_step P P1 PG PR PF PU PI PO PN S f hf hmem with ht | ⟨T,hT⟩ | hstable
      · exact Or.inl ht
      · exact ih T.measure (by omega) T rfl
      · exact Or.inr hstable
  cases initial_prime_stage PG PR PF PU PI L hpre f hf hmem with
  | inl ht => exact Or.inl ht
  | inr hS =>
    obtain ⟨S⟩ := hS
    exact aux S.measure S rfl

end
end Paper2.SourceFaithful.HeightOne

