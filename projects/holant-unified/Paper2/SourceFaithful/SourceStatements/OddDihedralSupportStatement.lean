import Paper2.Certificates.DihedralSupport.EvenPartitionCosetTypes

/-! Literal support classification in source Theorem A.1(iii).
The input is an arbitrary actual six-bit support. Its port/xor projection
condition is proved equivalent to the exhaustive certificate predicate.
The affine family below uses the actual F₂ submodule generated by an
arbitrary unordered even partition, with an arbitrary translation. The
exceptional family is the actual full signed-permutation orbit of Sstar.
Counts are cardinalities of actual Boolean support functions.+-/
namespace Paper2.SourceFaithful.SourceStatements.OddDihedralSupport
open Paper2.Certificates.DihedralSupport
noncomputable section

/-- The empty support, expressed pointwise on actual Boolean words. -/
def EmptySupport (S : Support6) : Prop := ∀ x,S x=false

/-- The actual source exceptional support orbit. -/
def StarOrbit (S : Support6) : Prop :=
  ∃ σ : Equiv.Perm (Fin 6),∃ b : SupportOrbit.Word,
    ∀ x,S x=SupportOrbit.sstar (SupportOrbit.wordAction σ b x)

/-- No preselected canonical partition or accepted survivor list occurs
in this classification of arbitrary actual supports. -/
theorem support_classification (S : Support6) :
    AdmissibleSupport S ↔
      EmptySupport S ∨ EvenPartitionLinearCoset S ∨ StarOrbit S := by
  rw [admissibleSupport_iff_mask,admissible_iff_classified]
  simp only [classifiedMasks,Finset.mem_insert,Finset.mem_union]
  rw [encodeSupport_zero_iff,←evenPartitionLinearCoset_iff_affineMasks,
    SupportOrbit.support_orbit_iff]
  rfl

theorem linear_coset_support_count :
    Nat.card {S : Support6 // EvenPartitionLinearCoset S}=392 := by
  let e := Equiv.subtypeEquivRight (fun S : Support6 =>
    evenPartitionLinearCoset_iff_affineMasks S)
  exact (Nat.card_congr e).trans affine_support_count

theorem exceptional_support_count :
    Nat.card {S : Support6 // StarOrbit S}=480 := orbit_support_count

/-- The three source families are disjoint as actual support functions. -/
theorem support_families_disjoint (S : Support6) :
    (EmptySupport S → ¬EvenPartitionLinearCoset S) ∧
    (EmptySupport S → ¬StarOrbit S) ∧
    (EvenPartitionLinearCoset S → ¬StarOrbit S) := by
  refine ⟨?_,?_,?_⟩
  · intro he ha
    have hz := (encodeSupport_zero_iff S).mpr he
    have hm := (evenPartitionLinearCoset_iff_affineMasks S).mp ha
    rw [hz] at hm
    exact zero_not_affine hm
  · intro he ho
    have hz := (encodeSupport_zero_iff S).mpr he
    have hm := (SupportOrbit.support_orbit_iff S).mpr ho
    rw [hz] at hm
    exact SupportOrbit.zero_not_mem hm
  · intro ha ho
    have hm := (evenPartitionLinearCoset_iff_affineMasks S).mp ha
    have hn := (SupportOrbit.support_orbit_iff S).mpr ho
    exact Finset.disjoint_left.mp SupportOrbit.orbit_affine_disjoint hn hm

/-- The complete source support classification: exactly 873 actual
supports, comprising the empty support, 392 actual F₂ even-partition
cosets, and the 480-member actual exceptional orbit. The displayed
32/240/120 counts classify arbitrary original partitions with respectively
one, two and three blocks, whose actual block-size multisets are proved
to be (6), (4+2) and (2+2+2). These count distinct Boolean support functions.
Every nonempty admissible support lies in one literal Boolean parity. -/
def SupportStatement (S : Support6) : Prop :=
    (AdmissibleSupport S ↔
      EmptySupport S ∨ EvenPartitionLinearCoset S ∨ StarOrbit S) ∧
    Nat.card {T : Support6 // AdmissibleSupport T}=873 ∧
    Nat.card {T : Support6 // EvenPartitionLinearCoset T}=392 ∧
    Nat.card {T : Support6 // EvenPartitionLinearCosetOfCard 1 T}=32 ∧
    Nat.card {T : Support6 // EvenPartitionLinearCosetOfCard 2 T}=240 ∧
    Nat.card {T : Support6 // EvenPartitionLinearCosetOfCard 3 T}=120 ∧
    Nat.card {T : Support6 // StarOrbit T}=480 ∧
    (∀ T : Support6,
      (EmptySupport T → ¬EvenPartitionLinearCoset T) ∧
      (EmptySupport T → ¬StarOrbit T) ∧
      (EvenPartitionLinearCoset T → ¬StarOrbit T)) ∧
    (∀ _h : AdmissibleSupport S,(∃ x,S x=true) →
      ∃ b : Bool,∀ x,S x=true → SupportOrbit.parity x=b)

/-- Literal Theorem A.1(iii), with all three source support families,
actual support counts, arbitrary even-partition types and one parity. -/
theorem source_A_1_iii (S : Support6) : SupportStatement S := by
  exact ⟨support_classification S,admissible_support_count,
    linear_coset_support_count,sixBlock_linearCoset_count,fourTwo_linearCoset_count,
    matching_linearCoset_count,exceptional_support_count,support_families_disjoint,
    fun h hn => admissible_nonempty_one_parity S h hn⟩

end
end Paper2.SourceFaithful.SourceStatements.OddDihedralSupport

