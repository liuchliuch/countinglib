import Counting.Algorithm.Interpolation.Algorithm
import Holant.Complexity.BinaryInterpolation.CommonDenominator
import Holant.Complexity.BinaryInterpolation.WeightFormulas

/-!
# The existing postprocessor's value and the public recovery algorithm

The machine below uses fixed arithmetic or geometric nodes and fixed powers of
`gamma`. Arbitrary distinct nodes remain the contract of `Interpolation` only.
Samples may be zero; only the node differences and scales are inverted.
-/
namespace Counting.Algorithm.InterpolationMachine

open scoped BigOperators
open Holant.Complexity.BinaryInterpolation
noncomputable section
variable {K : Type*} [Field K] {m : ℕ}

/-- The node schedule physically generated by the upstream weight compiler. -/
abbrev nodes := @WeightFormulas.nodes
/-- The fixed scaling schedule of that same compiler. -/
abbrev scales := @WeightFormulas.scales

/-- Remove the known scale on each supplied answer, retaining its position. -/
def normalized (gamma : K) (m : ℕ) (y : Fin (m+1) → K) : Fin (m+1) → K :=
  fun i => y i / (scales gamma m i)^m

/-- The exact numerator/denominator stack produced by the compiled program. -/
def resultPair (gamma rho : K) (geometric : Bool) (m : ℕ) (y : Fin (m+1) → K) : K × K :=
  let d := queryDenominator (nodes geometric rho m) (scales gamma m)
  (commonNumerator d y, commonDenominator d)

/-- The sole final division, performed by the actual field division machine. -/
def result (gamma rho : K) (geometric : Bool) (m : ℕ) (y : Fin (m+1) → K) : K :=
  (resultPair gamma rho geometric m y).1 / (resultPair gamma rho geometric m y).2

/-- I1's extracted formula and the unique H1 provider have identical bodies. -/
theorem recoverTop_eq_upstream (v y : Fin (m+1) → K) :
    Interpolation.recoverTop v y = Holant.Complexity.BinaryInterpolation.recoverTop v y := rfl

/-- Actual postprocessing computes the public evaluator on normalized samples. -/
theorem result_eq_evaluate (gamma rho : K) (geometric : Bool) (m : ℕ)
    (y : Fin (m+1) → K) (hn : Function.Injective (nodes geometric rho m))
    (hg : gamma ≠ 0) :
    result gamma rho geometric m y =
      Interpolation.evaluate (nodes geometric rho m) (normalized gamma m y) := by
  rw [Interpolation.evaluate_eq_recoverTop, recoverTop_eq_upstream]
  exact (recover_normalized_common _ _ y hn (fun i => pow_ne_zero _ hg)).symm

/-- The denominator never depends on answers, including zero answers. -/
theorem denominator_ne_zero (gamma rho : K) (geometric : Bool) (m : ℕ)
    (y : Fin (m+1) → K) (hn : Function.Injective (nodes geometric rho m))
    (hg : gamma ≠ 0) : (resultPair gamma rho geometric m y).2 ≠ 0 :=
  commonDenominator_ne_zero _ (queryDenominator_ne_zero _ _ hn (fun i => pow_ne_zero _ hg))

/-- The machine's normalized samples recover the degree-bound coefficient. -/
theorem result_eq_coefficient (gamma rho : K) (geometric : Bool) (m : ℕ)
    (P : Polynomial K) (hn : Function.Injective (nodes geometric rho m))
    (hg : gamma ≠ 0) (hP : P.natDegree ≤ m) :
    result gamma rho geometric m
      (fun i => (scales gamma m i)^m * P.eval (nodes geometric rho m i)) = P.coeff m := by
  rw [result_eq_evaluate gamma rho geometric m _ hn hg]
  have hs : normalized gamma m
      (fun i => (scales gamma m i)^m * P.eval (nodes geometric rho m i)) =
      (fun i => P.eval (nodes geometric rho m i)) := by
    funext i
    exact mul_div_cancel_left₀ _ (pow_ne_zero _ (pow_ne_zero _ hg))
  rw [hs]
  exact Interpolation.evaluate_eq_coefficient _ hn P hP

@[simp] theorem result_zero (gamma rho : K) (geometric : Bool) (m : ℕ) :
    result gamma rho geometric m (fun _ => 0) = 0 := by
  change (∑ i : Fin (m+1), (0:K) * ∏ j ∈ Finset.univ.erase i,
    queryDenominator (nodes geometric rho m) (scales gamma m) j) /
    (∏ i : Fin (m+1), queryDenominator (nodes geometric rho m) (scales gamma m) i) = 0
  simp

/-- At degree bound zero, all products are empty and the single answer returns. -/
@[simp] theorem result_zero_degree (gamma rho : K) (geometric : Bool) (y : Fin 1 → K) :
    result gamma rho geometric 0 y = y 0 := by
  change (∑ i : Fin 1, y i * ∏ j ∈ Finset.univ.erase i,
    queryDenominator (nodes geometric rho 0) (scales gamma 0) j) /
    (∏ i : Fin 1, queryDenominator (nodes geometric rho 0) (scales gamma 0) i) = y 0
  simp [queryDenominator, interpolationDenominator]

/-- Arithmetic nodes are separated in the characteristic-zero fixed fields. -/
theorem arithmetic_nodes_injective [CharZero K] (rho : K) (m : ℕ) :
    Function.Injective (nodes false rho m) := by
  intro i j h
  apply Fin.ext
  simp only [nodes, WeightFormulas.nodes, Bool.false_eq_true, if_false] at h
  have h' : i.val + 1 = j.val + 1 := by
    exact_mod_cast h
  omega

end
end Counting.Algorithm.InterpolationMachine
