import Counting.Algorithm.KarpLubyRequest.Preparation.Transfers
import Counting.Algorithm.KarpLubyRequest.Preparation.Cleanup
import Counting.Algorithm.KarpLubyRequest.BankProtocol

/-! Actual final payload serialization and complete cleanup. The incoming
physical random tail is moved first, then four existing words are framed by
the unique H1 emitter. No semantic encoding function is executed for free. -/
namespace Counting.Algorithm.KarpLubyRequest.Preparation
noncomputable section
open Turing Computability Holant.Complexity StackProtocol
open Counting.Algorithm.KarpLuby

set_option backward.isDefEq.respectTransparency false

theorem emitSource_zero : emitSource 0 = budgetOriginal 1 := rfl
theorem emitSource_one : emitSource 1 = budgetOriginal 0 := rfl
theorem emitSource_two : emitSource 2 = budgetOriginal 2 := rfl
theorem emitSource_three : emitSource 3 = formulaStacks 12 := rfl

theorem budgetOriginal_eq (k : Fin 4) : budgetOriginal k =
    Sum.inl (Sum.inr (Sum.inr (Sum.inr (Sum.inl (Sum.inl k))))) := rfl
theorem formulaStacks_eq (k : Fin 13) : formulaStacks k = Sum.inl (Sum.inr (Sum.inl k)) := rfl

def emitted (k : Fin 4) (bank : Stack → List Bool) : Stack → List Bool :=
  Function.update (Function.update bank (emitSource k) []) output
    (Encoding.frame (bank (emitSource k)) ++ bank output)

theorem emit_into (k : Fin 4) (memory : Memory) (bank : Stack → List Bool)
    (ht : bank scratch = []) :
    RunsExactly computer.step (cfg (.emitMove k) memory bank)
      (cfg (emitNext k) memory (emitted k bank))
      (2 * (bank (emitSource k)).length + 3) :=
  BankProtocol.prepend_into (emitSource k) output scratch
    (emit_distinct k).1 (emit_distinct k).2.1 (emit_distinct k).2.2 computer.step
    (.emitMove k) (.emitDelimiter k) (.emit k) (emitNext k)
    (by intro m t; rfl) (by intro m t; rfl) (by intro m t; rfl)
    memory bank ht

theorem emitted_output (k : Fin 4) (bank : Stack → List Bool) :
    emitted k bank output = Encoding.frame (bank (emitSource k)) ++ bank output :=
  Function.update_self _ _ _

theorem emitted_other (k : Fin 4) (bank : Stack → List Bool) (j : Stack)
    (hsrc : j ≠ emitSource k) (hout : j ≠ output) :
    emitted k bank j = bank j := by
  exact (Function.update_of_ne hout _ _).trans (Function.update_of_ne hsrc _ _)

theorem emitted_scratch (k : Fin 4) (bank : Stack → List Bool) :
    emitted k bank scratch = bank scratch :=
  emitted_other k bank scratch (Ne.symm (emit_distinct k).2.1)
    (Ne.symm (emit_distinct k).2.2)

def fourEmitted (bank : Stack → List Bool) : Stack → List Bool :=
  emitted 3 (emitted 2 (emitted 1 (emitted 0 bank)))

def headerSteps (bank : Stack → List Bool) : ℕ :=
  2 * ((bank (budgetOriginal 1)).length + (bank (budgetOriginal 0)).length +
    (bank (budgetOriginal 2)).length + (bank (formulaStacks 12)).length) + 12

/-- All four literal frames are generated by actual source loops, in the
reverse emission order required by a stack output. -/
theorem four_frames (memory : Memory) (bank : Stack → List Bool)
    (ht : bank scratch = []) :
    RunsExactly computer.step (cfg (.emitMove 0) memory bank)
      (cfg .positive memory (fourEmitted bank)) (headerSteps bank) := by
  have h0 := emit_into 0 memory bank ht
  have h1 := emit_into 1 memory (emitted 0 bank) (by rw [emitted_scratch]; exact ht)
  have h2 := emit_into 2 memory (emitted 1 (emitted 0 bank))
    (by rw [emitted_scratch, emitted_scratch]; exact ht)
  have h3 := emit_into 3 memory (emitted 2 (emitted 1 (emitted 0 bank)))
    (by rw [emitted_scratch, emitted_scratch, emitted_scratch]; exact ht)
  have h := ((h0.trans h1).trans h2).trans h3
  convert h using 1 <;> first | rfl | skip
  simp only [headerSteps, emitted, emitSource_zero, emitSource_one, emitSource_two,
    emitSource_three, budgetOriginal_eq, formulaStacks_eq, output, Function.update_apply]
  simp only [Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, Fin.reduceEq, ite_false]
  omega

theorem four_frames_output (bank : Stack → List Bool) :
    fourEmitted bank output =
      Encoding.frame (bank (formulaStacks 12)) ++
        (Encoding.frame (bank (budgetOriginal 2)) ++
          (Encoding.frame (bank (budgetOriginal 0)) ++
            (Encoding.frame (bank (budgetOriginal 1)) ++ bank output))) := by
  dsimp only [fourEmitted]
  rw [emitted_output, emitted_output, emitted_output, emitted_output]
  simp only [emitted, emitSource_zero, emitSource_one, emitSource_two, emitSource_three,
    budgetOriginal_eq, formulaStacks_eq, output, Function.update_apply,
    Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, Fin.reduceEq, ite_false]

/-- The zero tag is followed by the very same complete work-stack clearing
schedule, even when a rejected parser leaves nonempty fields or scratch. -/
theorem zero_finish (memory : Memory) (bank : Stack → List Bool)
    (ho : bank output = []) :
    RunsExactly computer.step (cfg .zero memory bank) (finalConfiguration [false])
      (prefixCost (Function.update bank output [false]) workCount + 2) := by
  have hs : computer.step (cfg .zero memory bank) =
      some (cfg clearFirst memory (Function.update bank output [false])) := by
    change some (cfg clearFirst memory (Function.update bank output (false :: bank output))) = _
    rw [ho]
  have hc := cleanup_run (Function.update bank output [false]) memory
  rw [Function.update_self] at hc
  simpa only [Nat.add_assoc] using (runsExactly_one hs).trans hc

/-- Positive tagging and cleanup return the exact literal payload and reset all
registers and all work stacks. The output is the only surviving word. -/
theorem positive_finish (memory : Memory) (bank : Stack → List Bool) :
    RunsExactly computer.step (cfg .positive memory bank)
      (finalConfiguration (true :: bank output))
      (prefixCost (Function.update bank output (true :: bank output)) workCount + 2) := by
  have hs : computer.step (cfg .positive memory bank) =
      some (cfg clearFirst memory (Function.update bank output (true :: bank output))) := rfl
  have hc := cleanup_run (Function.update bank output (true :: bank output)) memory
  rw [Function.update_self] at hc
  simpa only [Nat.add_assoc] using (runsExactly_one hs).trans hc

end
end Counting.Algorithm.KarpLubyRequest.Preparation
